<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustPlay.Tag.ViewModels"
        xmlns:uic="using:JustPlay.UI.Controls"
        xmlns:controls="using:JustPlay.Tag.Controls"
        xmlns:beh="using:JustPlay.UI.Behaviors"
        x:Class="JustPlay.Tag.Views.MainWindow"
        x:DataType="vm:TaggerViewModel"
        Title="JUST TAG"
        Width="1400" Height="820"
        MinWidth="1080" MinHeight="600"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        beh:KeyboardNav.SuppressTab="False"
        WindowDecorations="None">

    <!--
      JUST TAG - the suite's tagger, built from the PRE CUE FINDER's shell: frameless rounded card,
      layered themed background, chrome bar with the brand mark left and the caption buttons right,
      manual resize grips. The chrome is COPIED, not shared and made adaptive - that is the suite
      rule (memory just-ui-philosophy), so every JUST window looks identical without any of them
      having to know about the others.

      The body is mp3tag's shape: FOLDERS | FILES | EDITOR. The editor is the SHARED JustPlay.UI
      TagEditorPanel - the same control the floating window in JUST PLAY and the PRE CUE FINDER
      host. There is exactly one tag editor in this suite, and this is it.
    -->

    <Window.Resources>
        <!-- Bottom soft-fade for both lists - copied from the Finder, including the reason: the mask
             goes on the SCROLLED CONTENT, never on the ListBox (that composites the whole
             virtualising list to transparent) and never on a wrapper (that fades the scrollbar too). -->
        <LinearGradientBrush x:Key="ListBottomFade" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0.0"   Color="White"/>
            <GradientStop Offset="0.965" Color="White"/>
            <GradientStop Offset="1.0"   Color="Transparent"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <!-- (!) Row look COPIED VERBATIM from the PRE CUE FINDER (finder-list), not re-derived: the
             hover/selected accent-gradient swipe, the brighter cursor in the pane that has focus,
             the header wash, the bottom fade. Writing my own flat-grey version is exactly how two
             JUST windows start looking like two different products. -->
        <Style Selector="ListBox.tag-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.tag-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.tag-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <!-- Selected in the INACTIVE pane: a subtle wash. The dual-pane cue is that the hot pane's
             cursor is far brighter (below). -->
        <Style Selector="ListBox.tag-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="{DynamicResource AccentCRow}"/>
                    <GradientStop Offset="0.6" Color="{DynamicResource AccentBRow}"/>
                    <GradientStop Offset="1"   Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <!-- Selected in the ACTIVE pane: the cursor. Cyan->pink, both highlight colours. -->
        <Style Selector="ListBox.tag-list.pane-active ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"    Color="{DynamicResource AccentARowStrong}"/>
                    <GradientStop Offset="0.55" Color="{DynamicResource AccentBRowHover}"/>
                    <GradientStop Offset="1"    Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.tag-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="{DynamicResource AccentCRowHover}"/>
                    <GradientStop Offset="0.6" Color="{DynamicResource AccentBRowHover}"/>
                    <GradientStop Offset="1"   Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.tag-list.pane-active ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"    Color="{DynamicResource AccentARowStrong}"/>
                    <GradientStop Offset="0.55" Color="{DynamicResource AccentBRowHover}"/>
                    <GradientStop Offset="1"    Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBox.tag-list /template/ ScrollViewer /template/ ScrollContentPresenter">
            <Setter Property="OpacityMask" Value="{StaticResource ListBottomFade}"/>
        </Style>

        <!-- Pane header row - hairlines top and bottom, and the focused pane lights up. -->
        <Style Selector="Border.pane-head">
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.pane-head.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentABrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,2"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"    Color="{DynamicResource AccentARowStrong}"/>
                    <GradientStop Offset="0.55" Color="{DynamicResource AccentBRowHover}"/>
                    <GradientStop Offset="1"    Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <!-- Foreground via STYLE, never inline: an inline LocalValue would beat the .active setter. -->
        <Style Selector="TextBlock.panehead">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.pane-head.active TextBlock.panehead">
            <Setter Property="Foreground" Value="#F5FFFFFF"/>
        </Style>

        <!-- EDITOR | FILTER tab buttons - the Finder's tabhead, verbatim. Order matters: .active
             comes last so it wins against :pointerover on an already-active tab. -->
        <Style Selector="Button.tabhead">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tabhead /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tabhead TextBlock.panehead">
            <Setter Property="Foreground" Value="#5CFFFFFF"/>
        </Style>
        <Style Selector="Button.tabhead:pointerover TextBlock.panehead">
            <Setter Property="Foreground" Value="#C8FFFFFF"/>
        </Style>
        <Style Selector="Button.tabhead.active TextBlock.panehead">
            <Setter Property="Foreground" Value="#F5FFFFFF"/>
        </Style>
        <!--
          A tab whose pane has something GOING ON reads in the accent, whether or not you are standing
          on it. Two states were invisible until now: a
          search is filtering the list, and the editor holds unsaved edits - both easy to walk away
          from without noticing.

          (!) Order matters: this comes AFTER .active, so a tab that is BOTH shown and live reads as
          live. Avalonia has no specificity - among equal-priority styles the later one wins.
          Deliberately the accent COLOUR and not a dot: an unlabelled dot got thrown out once already
          for saying nothing anyone could decode.
        -->
        <Style Selector="Button.tabhead.live TextBlock.panehead">
            <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
        </Style>

        <!-- Breadcrumb, same recipe as the Finder's. -->
        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.crumb /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.crumb:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>
        <Style Selector="Button.crumb.current">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.crumbsep">
            <Setter Property="Foreground" Value="#59FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>

        <!-- Secondary button, the same shape the editor panel uses for its ghost buttons. -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Border Name="RootCard" ClipToBounds="False">
            <Panel>
                <Rectangle Fill="{DynamicResource BgLinear}"/>
                <Rectangle Fill="{DynamicResource BgGlowA}"  />
                <Rectangle Fill="{DynamicResource BgGlowB}"  />
                <Border Classes="cardedge" BorderBrush="#1FFFFFFF" BorderThickness="1"/>

                <DockPanel Margin="0">

                    <!-- == Chrome bar - the canonical recipe: brand mark (glyph + name, opens the
                         shared About) on the left with the path beside it, cap buttons and the
                         shared window controls on the right. -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto"
                          Height="36" Background="Transparent"
                          PointerPressed="OnChromePressed">

                        <!-- Right-click the path (or anywhere on the bar) to switch folders - the
                             chrome IS where the current folder is stated, so it is where changing
                             it belongs. -->
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Browse folder..." Click="OnPickFolder"/>
                            </ContextMenu>
                        </Grid.ContextMenu>


                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Stretch">
                            <!-- macOS: traffic lights on the far LEFT (suite chrome rule for mac). -->
                            <uic:WindowControls IsVisible="{x:Static uic:Platform.IsMac}" Margin="14,0,0,0"/>
                            <!-- (!) brandbtn, NOT "brand": that class lives in JustPlay.App's App.axaml
                                 only. Naming it here matched no style at all and FluentTheme drew a
                                 stock grey button around the mark - which is exactly why the header
                                 looked unlike its siblings (2026-08-05). -->
                            <Button Classes="brandbtn" Click="OnAboutClick" Margin="14,0,0,0"
                                    IsVisible="{x:Static uic:Platform.IsNotMac}"
                                    VerticalAlignment="Center" ToolTip.Tip="About JUST TAG">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" Background="Transparent">
                                        <!-- Lucide "tag" - JUST TAG's mark, the same one the app icon carries. -->
                                        <Path Stretch="Uniform" Width="16" Height="16"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              Data="M12.586 2.586 A2 2 0 0 0 11.172 2 H4 a2 2 0 0 0 -2 2 v7.172
                                                    a2 2 0 0 0 .586 1.414 l8.704 8.704 a2.426 2.426 0 0 0 3.42 0
                                                    l6.58 -6.58 a2.426 2.426 0 0 0 0 -3.42 Z
                                                    M6.3 7.5 A1.2 1.2 0 1 0 8.7 7.5 A1.2 1.2 0 1 0 6.3 7.5">
                                            <Path.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
                                            </Path.Effect>
                                        </Path>
                                    </Border>
                                    <TextBlock Text="JUST TAG" FontSize="11" FontWeight="SemiBold"
                                               LetterSpacing="2" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Clickable path - every segment jumps to that level, like the Finder's. -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Crumbs}"
                                      VerticalAlignment="Center" Margin="14,0,10,0" ClipToBounds="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:Crumb">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Classes="crumb" Classes.current="{Binding IsLast}"
                                                Tag="{Binding Path}" Click="OnCrumbClick">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="180"/>
                                        </Button>
                                        <TextBlock Classes="crumbsep" Text=">" IsVisible="{Binding !IsLast}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Classes="cap" Click="OnSettingsClick" ToolTip.Tip="Settings">
                                <!-- The suite's gear, identical path to the main window's. -->
                                <Path Stretch="Uniform" Width="17" Height="17"
                                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                                      StrokeJoin="Round" Fill="Transparent"
                                      Data="M 7,0 L 9,0 L 9.5,2 L 11.5,2.5 L 13,1.3 L 14.7,3 L 13.5,4.5 L 14,6.5 L 16,7 L 16,9 L 14,9.5 L 13.5,11.5 L 14.7,13 L 13,14.7 L 11.5,13.5 L 9.5,14 L 9,16 L 7,16 L 6.5,14 L 4.5,13.5 L 3,14.7 L 1.3,13 L 2.5,11.5 L 2,9.5 L 0,9 L 0,7 L 2,6.5 L 2.5,4.5 L 1.3,3 L 3,1.3 L 4.5,2.5 L 6.5,2 Z M 8,5.5 A 2.5,2.5 0 1 0 8,10.5 A 2.5,2.5 0 1 0 8,5.5 Z"/>
                            </Button>
                        </StackPanel>

                        <uic:WindowControls Grid.Column="3" IsVisible="{x:Static uic:Platform.IsNotMac}"/>
                    </Grid>

                    <!-- == Body: FOLDERS | FILES | EDITOR =========================================
                         The editor column is FIXED width: it is the working surface, and a sidebar
                         that stretched with the window would move the fields around under your
                         hands. The folder <-> files gap is a draggable splitter (transparent - the
                         resize cursor is the affordance), same as the Finder. -->
                    <Grid Margin="16,4,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" MinWidth="150"/> <!-- FOLDERS -->
                            <ColumnDefinition Width="16"/>                 <!-- splitter -->
                            <ColumnDefinition Width="*" MinWidth="240"/>   <!-- FILES -->
                            <ColumnDefinition Width="22"/>                 <!-- gap -->
                            <ColumnDefinition Width="524"/>                <!-- EDITOR -->
                        </Grid.ColumnDefinitions>

                        <!-- FOLDERS - flat, one level: ".." plus the sub-folders. -->
                        <DockPanel Grid.Column="0">
                            <Border DockPanel.Dock="Top" Classes="pane-head"
                                    Classes.active="{Binding FoldersActive}" Margin="0,0,0,3">
                                <TextBlock Text="FOLDER" Classes="panehead" Margin="8,0,0,0"/>
                            </Border>
                            <ListBox Name="FolderList" Classes="tag-list"
                                     beh:SmoothScroll.Enabled="True"
                                     Classes.pane-active="{Binding FoldersActive}"
                                     ItemsSource="{Binding Folders}"
                                     SelectionMode="Single"
                                     GotFocus="OnFoldersGotFocus"
                                     Tapped="OnFolderTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderRow">
                                        <!-- Grid, not StackPanel: the name needs a * column or a long
                                             folder hard-clips instead of ellipsising. -->
                                        <Grid ColumnDefinitions="Auto,*" Margin="8,0,10,0">
                                            <!-- (!) The PRE CUE FINDER's row icon, VERBATIM - same shared
                                                 control, same size, and deliberately NO Foreground so it
                                                 inherits the row's colour exactly like the Finder's does.
                                                 See PreCueFinderWindow.axaml, FolderList ItemTemplate. -->
                                            <uic:JustIcon Grid.Column="0" Kind="{Binding Icon}"
                                                          Width="13" Height="13"
                                                          Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" Background="Transparent"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- FILES -->
                        <DockPanel Grid.Column="2">
                            <Border DockPanel.Dock="Top" Classes="pane-head"
                                    Classes.active="{Binding FilesActive}" Margin="0,0,0,3">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                    <TextBlock Grid.Column="0" Text="FILES" Classes="panehead" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FileCount}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <!-- How many rows are HELD. It only appears above one, and it is what
                                         keeps the docked editor honest until multi-EDIT exists: the
                                         editor writes the cursor file, and this says out loud that more
                                         than one row is selected. -->
                                    <TextBlock Grid.Column="2" Text="{Binding SelectionText}" FontSize="11"
                                               IsVisible="{Binding HasMultiSelection}"
                                               Foreground="{DynamicResource AccentABrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <!-- While the folder is being read: how far it has got. It replaces
                                         the index note rather than sitting next to it, because during a
                                         load "reading tags... 412 of 1203" is the only fact that matters
                                         - there has to be a visible signal that the folder listing is
                                         still loading. Both vanish when there is nothing to say. -->
                                    <TextBlock Grid.Column="3" Text="{Binding LoadingText}" FontSize="11"
                                               IsVisible="{Binding !Ready}"
                                               Foreground="{DynamicResource CautionBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <!-- Where the rows came from. Only shown when the machine's library
                                         index actually covered this folder - outside an indexed root
                                         there is nothing to say, and silence is the honest answer. -->
                                    <TextBlock Grid.Column="3" Text="{Binding IndexNote}" FontSize="11"
                                               IsVisible="{Binding HasIndexNote}"
                                               Foreground="{DynamicResource MutedDimBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="10,0,8,0"/>
                                </Grid>
                            </Border>

                            <!-- The preview transport MOVED to the bottom of the right-hand column
                                 (see PLAYER below). Two transports for one playback is one too many,
                                 and the file list is the working surface - it keeps its full height. -->

                            <!-- == Column header ================================================
                                 The SHARED strip (JustPlay.UI TrackDataHeader) - the same widths,
                                 sort glyphs and click-cycle as the JUST PLAY queue and the Finder,
                                 with JUST TAG's columns switched on. Right-click picks the columns.
                                 Same Grid as the row below it (NAME is the * column with MinWidth
                                 150, the data strip is Auto and clips off the right), so header and
                                 rows stay aligned while they clip. -->
                            <Border DockPanel.Dock="Top" Height="26" IsVisible="{Binding HasFolder}"
                                    Background="Transparent">
                                <Border.ContextFlyout>
                                    <!-- What you can filter on, you must be able to see. The order
                                         matches the cells in the row. -->
                                    <MenuFlyout x:DataType="vm:TaggerViewModel">
                                        <MenuItem Header="Artist"       ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowArtist, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="artist"/>
                                        <MenuItem Header="Album"        ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowAlbum, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="album"/>
                                        <MenuItem Header="Album artist" ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowAlbumArtist, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="albumartist"/>
                                        <MenuItem Header="Genre"        ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowGenre, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="genre"/>
                                        <MenuItem Header="Year"         ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowYear, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="year"/>
                                        <MenuItem Header="Track #"      ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowTrackNo, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="trackno"/>
                                        <Separator/>
                                        <MenuItem Header="BPM"          ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowBpm, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="bpm"/>
                                        <MenuItem Header="Key"          ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowKey, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="key"/>
                                        <MenuItem Header="Energy (NRG)" ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowNrg, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="nrg"/>
                                        <MenuItem Header="Comment"      ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowComment, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="comment"/>
                                        <Separator/>
                                        <MenuItem Header="Analysis (AN)" ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowAnalysis, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="analysis"/>
                                        <MenuItem Header="Cover (COV)"  ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowCover, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="cover"/>
                                        <MenuItem Header="ID3 version"  ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowId3, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="id3"/>
                                        <MenuItem Header="File type"    ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowFileType, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="filetype"/>
                                        <MenuItem Header="Length"       ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowDuration, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="duration"/>
                                        <MenuItem Header="File name"    ToggleType="CheckBox"
                                                  IsChecked="{Binding Columns.ShowFileName, Mode=OneWay}"
                                                  Command="{Binding Columns.ToggleColumnCommand}" CommandParameter="filename"/>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <!-- 4, not 6, and it is the SAME 4 the row below carries: 4 + the shared
                                     TrackNameMargin's own 4 puts NAME at 8 px - the pane's alignment line,
                                     the one FOLDER, PLAYER, FILTER and the tabs above all stand on. At 6
                                     the whole table sat 2 px right of the FILES label over it. The inset
                                     the DATA columns need on the right is a different question and keeps
                                     its 16. -->
                                <Grid Margin="4,0,16,0" ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- TrackNameMargin, the SAME resource the row's name cell uses. Without
                                         it the header sat 4 px left of the titles under it
                                         - the outer Grid margins already matched, this inner
                                         one was the one that did not. The queue header does exactly this
                                         (MaxView), so all three tables line up from one definition. -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="{DynamicResource TrackNameMargin}"
                                                Background="Transparent" Tag="title" Tapped="OnHeaderTapped" Cursor="Hand">
                                        <TextBlock Classes="colhead" Text="NAME"/>
                                        <uic:JustIcon Classes="sortarrow" Kind="{Binding Columns.TitleSortGlyph}"/>
                                    </StackPanel>
                                    <Panel Grid.Column="1">
                                        <uic:TrackDataHeader Columns="{Binding Columns}"
                                                             CanSort="{Binding Ready}"
                                                             Opacity="{Binding LockedOpacity}"/>
                                        <!-- While the folder is still being read: one "locked" tooltip
                                             over every column, and no sort clicks get through. -->
                                        <Border Background="Transparent" IsVisible="{Binding !Ready}"
                                                ToolTip.Tip="{Binding LockedTip}"/>
                                    </Panel>
                                </Grid>
                            </Border>

                            <!-- Nothing picked yet, or an unreadable folder: both say so where the
                                 list would be, instead of leaving an empty pane to be interpreted. -->
                            <Panel>
                                <!-- Multiple, not Single: a tagger works on RUNS of files - shift for a
                                     block, ctrl to pick. It is also what makes dragging a selection out
                                     to another app mean the whole selection (RowDragBehavior reads
                                     SelectedItems).
                                     (!) "Multiple" IS the ctrl/shift behaviour here - Avalonia's
                                     SelectionMode has no Extended member (Single/Multiple/Toggle/
                                     AlwaysSelected); Toggle is the one that makes a plain click add.
                                     Same value the queue and the Finder's file pane already use. -->
                                <ListBox Name="FileList" Classes="tag-list"
                                         beh:SmoothScroll.Enabled="True"
                                         Classes.pane-active="{Binding FilesActive}"
                                         ItemsSource="{Binding Files}"
                                         SelectionMode="Multiple"
                                         GotFocus="OnFilesGotFocus"
                                         DoubleTapped="OnFileDoubleTapped"
                                         SelectionChanged="OnFileSelected"
                                         ContextRequested="OnFilesContextRequested"
                                         IsVisible="{Binding HasFolder}">
                                    <!--
                                      The row menu. Deliberately short, and every entry is something
                                      this window could NOT do until now - editing tags is the docked
                                      panel's job and would only be a second door to the same room,
                                      and analysing is not offered because JUST TAG does not carry the
                                      analyzer at all (it would mean shipping the whole DSP stack in
                                      the tagger, which is a decision and not a menu item).

                                      Right-clicking a row that is not part of the selection selects
                                      just it first - Explorer's rule, and the one the Finder's file
                                      pane already follows - so a bulk entry always acts on what you
                                      pointed at.
                                    -->
                                    <ListBox.ContextMenu>
                                        <ContextMenu x:DataType="vm:TaggerViewModel">
                                            <MenuItem Header="{Binding PreviewMenuHeader}"
                                                      Click="OnMenuPreview"
                                                      IsVisible="{Binding HasOneSelected}"/>
                                            <Separator IsVisible="{Binding HasOneSelected}"/>
                                            <!-- The bulk edit that CHANGES what is there rather than
                                                 setting it: fix the shouting, swap the underscores,
                                                 take a site name out of every comment. It sits at
                                                 the top because on a folder that just landed it is
                                                 the first thing you do to it. -->
                                            <MenuItem Header="{Binding TransformMenuHeader}"
                                                      Click="OnMenuTransform"
                                                      IsVisible="{Binding HasSelection}"/>
                                            <Separator IsVisible="{Binding HasSelection}"/>
                                            <!-- ORGANISE: tagging, renaming and previewing were
                                                 already here; putting a track somewhere else was
                                                 not, and that is half of what you do to a folder
                                                 that just landed.

                                                 All three open a preview first - none of them
                                                 touches a file on the click. The ellipsis says so.
                                                 Delete goes to the operating system's own bin, and
                                                 its window says the words. -->
                                            <MenuItem Header="Move to..." Click="OnMenuMove"
                                                      IsVisible="{Binding HasSelection}"/>
                                            <MenuItem Header="Copy to..." Click="OnMenuCopyTo"
                                                      IsVisible="{Binding HasSelection}"/>
                                            <MenuItem Header="Delete..." Click="OnMenuDelete"
                                                      IsVisible="{Binding HasSelection}"/>
                                            <Separator IsVisible="{Binding HasSelection}"/>
                                            <MenuItem Header="{Binding RevealMenuHeader}"
                                                      Click="OnMenuReveal"
                                                      IsVisible="{Binding HasOneSelected}"/>
                                            <MenuItem Header="{Binding CopyPathMenuHeader}"
                                                      Click="OnMenuCopyPath"
                                                      IsVisible="{Binding HasSelection}"/>
                                            <!-- RAW TAGS: every frame the file really carries, read
                                                 only. It is here rather than in the editor because
                                                 it is not editing - it is looking, and what it shows
                                                 is mostly frames that belong to OTHER tools. It is
                                                 the one screen that proves their data survived us. -->
                                            <MenuItem Header="Raw tags..." Click="OnMenuRawTags"
                                                      IsVisible="{Binding HasSelection}"/>
                                            <Separator IsVisible="{Binding HasSelection}"/>
                                            <MenuItem Header="Refresh" Click="OnMenuRefresh"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FileRow">
                                            <!-- The SHARED row (JustPlay.UI TrackRow) - the same cells,
                                                 widths, key pill and heart as the JUST PLAY queue and
                                                 the Finder. Artist under the title (the queue's shape),
                                                 because the pane is narrow and ARTIST is one right-click
                                                 away as its own sortable column. -->
                                            <uic:TrackRow DataContext="{Binding Track}"
                                                          Margin="4,0,16,0" MinHeight="30"
                                                          Columns="{Binding $parent[ListBox].((vm:TaggerViewModel)DataContext).Columns}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- ONE way in, and it is HERE - not a button parked in the pane
                                     header. Dropping a folder on the window and
                                     right-clicking the path in the chrome do the same thing. -->
                                <StackPanel IsVisible="{Binding !HasFolder}" Spacing="10"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center"
                                          Stroke="#59FFFFFF" StrokeThickness="1.6"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          Data="M12.586 2.586 A2 2 0 0 0 11.172 2 H4 a2 2 0 0 0 -2 2 v7.172
                                                a2 2 0 0 0 .586 1.414 l8.704 8.704 a2.426 2.426 0 0 0 3.42 0
                                                l6.58 -6.58 a2.426 2.426 0 0 0 0 -3.42 Z
                                                M6.3 7.5 A1.2 1.2 0 1 0 8.7 7.5 A1.2 1.2 0 1 0 6.3 7.5"/>
                                    <TextBlock Text="Drop a folder here" FontSize="13"
                                               Foreground="#A6FFFFFF" HorizontalAlignment="Center"/>
                                    <Button Classes="ghost" Content="Browse folder..." Click="OnPickFolder"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}"
                                           FontSize="12.5" TextWrapping="Wrap" MaxWidth="320"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Panel>
                        </DockPanel>

                        <!-- EDITOR - the shared panel, docked. Same control, same behaviour and same
                             copy as the floating window in JUST PLAY and the Finder. -->
                        <!-- GotFocus on the WHOLE column, not on each field: anything inside that takes
                             focus - a tag box, a combo, the FILTER checkbox - bubbles up here and lights
                             THIS header instead of leaving FILES lit while the keyboard is over here
                             - the panel needs the same highlight-when-focused treatment as the other
                             panes. -->
                        <DockPanel Grid.Column="4" GotFocus="OnPanelGotFocus">
                            <!-- EDITOR | ANALYSIS | FILTER - the Finder's INFO | FILTER pane, adapted.
                                 ANALYSIS sits HERE, on the one tab row, and not inside the shared
                                 panel: a panel that carries its own TAGS|ANALYSIS switch puts a second
                                 row of tabs directly under this one. All three use
                                 the Finder's tabhead recipe. -->
                            <Border DockPanel.Dock="Top" Classes="pane-head"
                                    Classes.active="{Binding PanelActive}" Margin="0,0,0,3">
                              <Grid ColumnDefinitions="Auto,*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" Margin="8,0,0,0">
                                    <!-- .live = the editor holds unsaved edits. Until now the only cue
                                         was Save/Revert going from grey to enabled, on a pane you may
                                         not even be looking at. -->
                                    <Button Classes="tabhead" Classes.active="{Binding ShowEditor}"
                                            Classes.live="{Binding Editor.IsDirty}"
                                            Click="OnShowEditor">
                                        <TextBlock Text="EDITOR" Classes="panehead"/>
                                    </Button>
                                    <!-- ANALYSIS is ONE file's measurements. Across a selection there
                                         is no such thing, so the tab goes away instead of standing
                                         there empty - and if you were on it, the pane falls back to
                                         EDITOR (SyncAnalysisTab). -->
                                    <Button Classes="tabhead" Classes.active="{Binding ShowAnalysis}"
                                            IsVisible="{Binding CanShowAnalysisTab}"
                                            Click="OnShowAnalysis">
                                        <TextBlock Text="ANALYSIS" Classes="panehead"/>
                                    </Button>
                                    <!-- Searching needs EVERY row, so the tab waits for the read and
                                         says why - instead of quietly answering from the half that
                                         happens to be loaded. Same rule as the sort lock on the
                                         column header. -->
                                    <!-- .live = a search is narrowing the list. The count in the FILES
                                         header ("12 of 1203") is the number; this is the STATE, and it
                                         is visible from the other two tabs. -->
                                    <Button Classes="tabhead" Classes.active="{Binding ShowFilter}"
                                            Classes.live="{Binding IsFiltering}"
                                            Click="OnShowFilter" IsEnabled="{Binding CanFilter}"
                                            ToolTip.Tip="{Binding LockedTip}">
                                        <TextBlock Text="FILTER" Classes="panehead"/>
                                    </Button>
                                </StackPanel>

                                <!-- The file FACTS (type / length / kbps) ride the header, not the
                                     body: they are what you are looking at, not something you edit,
                                     and here they land on the same line as the FILES header beside
                                     them instead of one row below it. Same idiom as the PLAYER
                                     header's track name and the FILES header's count. -->
                                <TextBlock Grid.Column="1" Text="{Binding Editor.FileInfo}"
                                           FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="12,0,8,0"
                                           ToolTip.Tip="{Binding Editor.FileInfo}"/>
                              </Grid>
                            </Border>

                            <!-- == PLAYER (light) ==================================================
                                 Docked at the BOTTOM of the right column, always present, fixed
                                 height. It used to sit under
                                 the file list, which cost the working surface height and only
                                 appeared once something was loaded.

                                 The TITLE line is not decoration: the preview follows the cursor, but
                                 the cursor can move away from what is playing, and over here - on the
                                 far side of the window from the list - there is no highlighted row to
                                 infer it from. It shows the FILE NAME rather than the title tag,
                                 because a tagger is usually looking at files whose tags are the
                                 problem. Everything dims when nothing is loaded instead of vanishing,
                                 so the strip does not make the layout jump. -->
                            <!-- (!) ORDER MATTERS: in a DockPanel the FIRST Bottom child takes the
                                 bottom edge and the next one stacks ABOVE it. The transport is
                                 therefore declared before its header, or the header would end up
                                 underneath the controls it labels. -->
                            <!-- The transport itself: the FINDER's player-bar idioms, not re-invented -
                                 Button.xport + Path.xicon for the round transport button (including its
                                 optical-centre nudge on the play triangle) and Slider.fader for both
                                 sliders, so the accent fill and the white thumb match every other
                                 themed slider in the suite. Dims when nothing is loaded rather than
                                 disappearing, so the layout never jumps. -->
                            <Grid DockPanel.Dock="Bottom" Height="36" Margin="8,4,8,6"
                                  ColumnDefinitions="Auto,Auto,*,Auto,Auto,68"
                                  Opacity="{Binding Preview.Dim}">
                                <!--
                                  (!) WHY THESE THREE RESOURCES ARE HERE - the sliders did not sit on the
                                  same optical line as the play button and the times - the misalignment
                                  was obvious at a glance, and no nudge could ever
                                  have fixed it, because it is geometry.

                                  FluentTheme's horizontal Slider is a three-row Grid -
                                  SliderPreContentMargin (15) / track / SliderPostContentMargin (15) -
                                  on a container with MinHeight = SliderHorizontalHeight (32). Verified
                                  against Avalonia.Themes.Fluent/Controls/Slider.xaml, release/12.0.3.
                                  In a 36 px strip the 30 fixed pixels win, the track gets the remainder
                                  and is pushed DOWN while the button and labels centre normally.

                                  All THREE have to go, not just the two margins: zeroing the margins
                                  alone leaves a 32 px floor holding 16 px of rows, and since none of
                                  the rows is a star row the slack collects at the BOTTOM - the track
                                  would then sit too HIGH. Off by the other sign is still off.

                                  What is given up: room for TICK BARS, which no JUST slider ever shows.
                                  Scoped to this Grid on purpose - the two margin keys also drive the
                                  VERTICAL template's columns, and JUST PLAY's EQ faders stand on that
                                  geometry. Nothing outside this strip changes.
                                -->
                                <Grid.Resources>
                                    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
                                    <GridLength x:Key="SliderPostContentMargin">0</GridLength>
                                    <x:Double x:Key="SliderHorizontalHeight">0</x:Double>
                                </Grid.Resources>

                                <Button Grid.Column="0" Classes="xport" Click="OnPreviewToggle"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding Preview.HasTrack}"
                                        ToolTip.Tip="Play / pause (Space or Enter)">
                                    <Panel>
                                        <!-- Optical-centre nudge: a right-pointing play triangle is
                                             left-heavy -> shift right. The pause bars are symmetric. -->
                                        <Path Classes="xicon" Data="M0,0 L0,10 L9,5 Z"
                                              IsVisible="{Binding !Preview.IsPlaying}"
                                              RenderTransform="translate(1.5px, 0)"/>
                                        <Path Classes="xicon" Data="M0,0 L2.5,0 L2.5,10 L0,10 Z M6.5,0 L9,0 L9,10 L6.5,10 Z"
                                              IsVisible="{Binding Preview.IsPlaying}"/>
                                    </Panel>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Preview.Elapsed}" FontSize="11"
                                           Foreground="#B3FFFFFF" VerticalAlignment="Center"
                                           Margin="6,0,8,0"/>
                                <!-- SeekMax, never Duration: Duration is 0 with nothing loaded, and a
                                     Slider whose Minimum equals its Maximum parks the thumb at the END. -->
                                <Slider Grid.Column="2" Classes="fader" Minimum="0"
                                        Maximum="{Binding Preview.SeekMax}"
                                        Value="{Binding Preview.Position}" VerticalAlignment="Center"
                                        IsEnabled="{Binding Preview.HasTrack}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Preview.Total}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="8,0,10,0"/>
                                <!-- Volume: an AUDITION level for this session, deliberately not
                                     persisted and never the app's playback volume. -->
                                <Path Grid.Column="4" Stretch="Uniform" Width="13" Height="13"
                                      VerticalAlignment="Center" Margin="0,0,7,0"
                                      Fill="{DynamicResource MutedBrush}"
                                      Data="M0,4 H3 L7,0.5 V13.5 L3,10 H0 Z"/>
                                <Slider Grid.Column="5" Classes="fader" Minimum="0" Maximum="1"
                                        Value="{Binding Preview.Volume}" VerticalAlignment="Center"
                                        beh:SliderReset.Default="1"
                                        ToolTip.Tip="Preview volume - wheel to nudge, double-click to reset"/>
                            </Grid>

                            <!-- It is a PANE, so it wears a pane head like FOLDER / FILES / EDITOR do -
                                 same hairlines above and below, same label. A strip without one read
                                 as a stray control. The playing file's name sits IN the
                                 header, next to the label, exactly like FILES puts its count there. -->
                            <Border DockPanel.Dock="Bottom" Classes="pane-head" Margin="0,10,0,3">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="PLAYER" Classes="panehead" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Preview.TrackName}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Preview.TrackName}"
                                               VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="nothing loaded" FontSize="11"
                                               Foreground="{DynamicResource MutedDimBrush}"
                                               IsVisible="{Binding !Preview.HasTrack}"
                                               VerticalAlignment="Center" Margin="10,0,8,0"/>
                                </Grid>
                            </Border>

                            <Panel>
                                <!-- No card, no frame: this is a PANE, like the Finder's INFO pane.
                                     The visibility sits on the WRAPPER - on the panel itself it
                                     would bind against the editor's own DataContext, which knows
                                     nothing about tabs. EDITOR and ANALYSIS are the two halves of the
                                     SAME control, so the panel stays up for both and only the header
                                     decides which half it shows. -->
                                <!-- 8, the pane's alignment line - the same one the EDITOR | ANALYSIS |
                                     FILTER tabs above stand on, so the first field starts under the E of
                                     EDITOR. Zero was as wrong as the 16 it replaced: the panel carries no
                                     inset of its own (it is shared, and the floating window needs a
                                     different one), so whatever the host asks for IS the alignment. -->
                                <Panel IsVisible="{Binding ShowPanel}" Margin="8,0">
                                    <uic:TagEditorPanel Name="Editor" DataContext="{Binding Editor}"
                                                        ShowAnalysis="{Binding $parent[Window].((vm:TaggerViewModel)DataContext).ShowAnalysis}"/>
                                </Panel>

                                <!-- FILTER - the Finder's field, verbatim: the x in the TextBox's own
                                     InnerRightContent slot, and "include subfolders" as a plain
                                     CHECKBOX UNDER the field ((!!) never a header toggle, never on the
                                     folder tree - both were rejected, 2026-07-31). What it searches
                                     is what a TAGGER looks for: name, title, artist, genre. -->
                                <ScrollViewer IsVisible="{Binding ShowFilter}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="14" Margin="8,6,8,6">

                                        <!-- WHERE first: what you are searching IN comes before
                                             what you are searching FOR. -->
                                        <CheckBox Content="Include subfolders" FontSize="12"
                                                  MinHeight="0"
                                                  Foreground="{DynamicResource MutedBrush}"
                                                  IsChecked="{Binding IncludeSubfolders}"
                                                  IsEnabled="{Binding CanIncludeSubfolders}"
                                                  ToolTip.Tip="Read the folders below this one as well"/>

                                        <!-- ONE search. The field starts at "All fields", so typing
                                             a word is the whole interaction; narrowing to a single
                                             field is a choice, not a second box - think simple and
                                             allow complex things. -->
                                        <!-- Reading order = SENTENCE order: WHAT you search in, HOW it
                                             compares, then the VALUE - "Genre - contains - hard techno".
                                             The simple case is untouched by it: both
                                             pickers already stand on "All fields" / "contains", so
                                             typing in the box below is still the whole interaction. -->
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="SEARCH" Classes="panehead"/>
                                            <Grid ColumnDefinitions="*,8,*">
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}"
                                                          SelectedItem="{Binding Field1}"
                                                          HorizontalAlignment="Stretch"
                                                          PlaceholderText="All fields">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FieldChoice">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Modes}"
                                                          SelectedItem="{Binding Mode1}"
                                                          HorizontalAlignment="Stretch"
                                                          PlaceholderText="contains">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ModeChoice">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <!-- The placeholder follows the chosen field (Hint1) - a concrete
                                                 EXAMPLE of the value, not a repeat of the label above it. -->
                                            <TextBox Text="{Binding Value1}"
                                                     IsVisible="{Binding NeedsValue1}"
                                                     Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                                                     BorderThickness="1" CornerRadius="6"
                                                     Foreground="#E6FFFFFF" FontSize="12" Padding="8,5"
                                                     PlaceholderText="{Binding Hint1}">
                                                <TextBox.InnerRightContent>
                                                    <Button Classes="ghost" FontSize="11"
                                                            Padding="7,0" MinWidth="0" MinHeight="0"
                                                            Margin="0,0,3,0" VerticalAlignment="Center"
                                                            IsVisible="{Binding HasValue1}"
                                                            Click="OnClearSearch"
                                                            ToolTip.Tip="Clear the search">
                                                        <uic:JustIcon Kind="Close" Width="10" Height="10"/>
                                                    </Button>
                                                </TextBox.InnerRightContent>
                                            </TextBox>
                                            <TextBlock Text="Reading tags..." FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       IsVisible="{Binding Searching}"/>
                                        </StackPanel>

                                        <!-- The complex thing, switched on only when it is wanted. -->
                                        <StackPanel Spacing="5" IsVisible="{Binding HasSecond}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <RadioButton GroupName="join" Content="and" FontSize="12"
                                                             MinHeight="0" Foreground="#D9FFFFFF"
                                                             IsChecked="{Binding JoinAnd}"/>
                                                <RadioButton GroupName="join" Content="or" FontSize="12"
                                                             MinHeight="0" Foreground="#D9FFFFFF"
                                                             IsChecked="{Binding !JoinAnd}"/>
                                            </StackPanel>
                                            <!-- Same sentence order as the first condition. -->
                                            <Grid ColumnDefinitions="*,8,*">
                                                <ComboBox Grid.Column="0" ItemsSource="{Binding Fields}"
                                                          SelectedItem="{Binding Field2}"
                                                          HorizontalAlignment="Stretch"
                                                          PlaceholderText="All fields">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FieldChoice">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Modes}"
                                                          SelectedItem="{Binding Mode2}"
                                                          HorizontalAlignment="Stretch"
                                                          PlaceholderText="contains">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ModeChoice">
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <TextBox Text="{Binding Value2}"
                                                     IsVisible="{Binding NeedsValue2}"
                                                     Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                                                     BorderThickness="1" CornerRadius="6"
                                                     Foreground="#E6FFFFFF" FontSize="12" Padding="8,5"
                                                     PlaceholderText="{Binding Hint2}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="ghost" Content="+ condition"
                                                    IsVisible="{Binding !HasSecond}"
                                                    Click="OnToggleSecond"/>
                                            <Button Classes="ghost" Content="- condition"
                                                    IsVisible="{Binding HasSecond}"
                                                    Click="OnToggleSecond"/>
                                            <Button Classes="ghost" Content="Clear" Click="OnClearSearch"/>
                                        </StackPanel>

                                        <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="The file name always matches. Every other field matches as soon as this folder's tags have been read - that happens once, on the first search."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </DockPanel>
                    </Grid>
                </DockPanel>

                <!-- SETTINGS - a slide-in PANEL on the right, not a separate window.
                     Placed AFTER the body so it overlays it, exactly like JUST PLAY's
                     tweaks sidebar. Its DataContext is the DI SettingsViewModel, assigned in
                     code-behind - the window's own DataContext is the tagger. -->
                <!-- (!) IsVisible goes through $parent[Window], NOT a plain {Binding IsSettingsOpen}.
                     The code-behind assigns THIS element's DataContext (the settings view model), so a
                     plain binding would look for IsSettingsOpen on the SettingsViewModel, not find it,
                     and leave IsVisible at its default - which is why the panel was simply always
                     there. $parent walks the tree and is independent of
                     DataContext; it is the pattern CLAUDE.md already records for reusable controls,
                     and the TagEditorPanel two panes down uses the identical form. -->
                <controls:SettingsPanel Name="Settings"
                                        IsVisible="{Binding $parent[Window].((vm:TaggerViewModel)DataContext).IsSettingsOpen}"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch"/>
            </Panel>
        </Border>

        <!-- Edge/corner resize grips in the transparent shadow ring (shared FramelessResizeBehavior). -->
        <Grid Name="ResizeGrips" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"/>
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast"/>
        </Grid>
    </Panel>
</Window>
