<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Ships as "JustTag.exe" — sibling product in the J.U.S.T. suite. RootNamespace stays
         JustPlay.Tag so x:Class / clr-namespace references resolve. -->
    <AssemblyName>JustTag</AssemblyName>
    <AssemblyTitle>JUST TAG</AssemblyTitle>
    <Product>JUST TAG</Product>
    <Company>Chloe Dream</Company>
    <!-- Static Win32 exe icon (Explorer / shortcuts) = the JUST TAG brand mark, Aurora theme +
         tag glyph. Generated from BrandGlyphs.Tag via build/make-tag-icon (SkiaSharp).
         The live taskbar/title-bar icon is still rendered per-theme by ThemedWindowIcon at runtime. -->
    <ApplicationIcon>Assets\justtag.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

  <!-- JUST TAG = a single-file tag editor. Platform-agnostic Core (models/abstractions) +
       JustPlay.Metadata (TagLib# read/write — all tag logic lives there, never in the app) +
       JustPlay.UI (shared suite chrome, caption buttons, themed icon, theme engine, About).
       NO Analysis reference: JUST TAG REPORTS what analysis a file already carries, it never runs
       a detector - that stays JUST PLAY's and the CLI's job. (Playback is a different story, see
       the BASS reference below - it used to be excluded here too.) -->
  <ItemGroup>
    <ProjectReference Include="..\JustPlay.Core\JustPlay.Core.csproj" />
    <ProjectReference Include="..\JustPlay.Metadata\JustPlay.Metadata.csproj" />
    <ProjectReference Include="..\JustPlay.UI\JustPlay.UI.csproj" />
    <!-- For AudioFiles ONLY — the suite's single definition of "what counts as a track". A private
         extension list here would let JUST TAG and the Finder disagree about the same folder. -->
    <ProjectReference Include="..\JustPlay.Library\JustPlay.Library.csproj" />
    <!-- (!) This REVERSES the project's original "deliberately no BASS" rule, on purpose and out
         loud. mp3tag has no playback at all - it hands the file to the OS player - so being able to
         hear the track inside the tagger is a straight win over it. It stays a PREVIEW: no queue,
         no crossfade, no DSP rack; the engine is used for Load/Play/Pause/Seek and nothing else.
         The native BASS libraries come along with this reference. -->
    <ProjectReference Include="..\JustPlay.Audio.Bass\JustPlay.Audio.Bass.csproj" />
  </ItemGroup>
</Project>
