<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.Tag.ViewModels"
             xmlns:uic="using:JustPlay.UI.Controls"
             xmlns:theming="using:JustPlay.UI.Theming"
             x:Class="JustPlay.Tag.Controls.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

    <!--
      JUST TAG's settings as a SLIDE-IN PANEL on the right, not a separate window (Chloe 2026-08-06:
      "in just tag haette ich die settings auch gerne als overlay panel rechts"). Same shape as JUST
      PLAY's tweaks sidebar - the suite's second window-less surface - so the two are siblings and not
      two ideas about what settings look like.

      The content is the old SettingsWindow's, moved verbatim: THEME and the MP3 write format with its
      caution card. Only the shell changed. The view model did not move at all - SettingsViewModel is
      still the DI singleton, so a theme switch still repaints the whole suite live.
    -->
    <UserControl.Styles>
        <!-- Selectable option row (write-format choices). Styled via the templated ContentPresenter so the
             FluentTheme hover/active background doesn't fight us (same trick as App.axaml's Button.ghost). -->
        <Style Selector="Button.opt">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.opt /template/ ContentPresenter">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="Button.opt:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.opt.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBBrush}"/>
        </Style>
        <!-- Radio dot: outline at rest, fills with the live accent when its row is active. -->
        <Style Selector="Button.opt.active Border.optdot">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentBBrush}"/>
        </Style>

        <!-- The suite's slim scrollbar - the tweaks sidebar's, so both panels scroll the same way. -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Margin" Value="0,2,1,2"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="#0AFFFFFF"/>
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="Width" Value="3"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#66FFFFFF"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
            <Setter Property="Background" Value="#80FFFFFF"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <!-- The SHARED surface, docked right - the identical object the tweaks sidebar and all nine
         dialogs use. Rounded on the free side, hairline on the edge it meets the app at. -->
    <uic:SurfaceCard Width="420"
                     CornerRadius="0,14,14,0"
                     BorderThickness="1,0,0,0">
        <ScrollViewer Padding="22,16,18,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">
            <!-- ClipToBounds=False so the theme swatch chips' glow is not cropped by the viewport -
                 the recurring clipping bug this codebase already documents. -->
            <StackPanel Spacing="20" ClipToBounds="False" Width="376">

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="SETTINGS" FontSize="12" FontWeight="Bold" LetterSpacing="3"
                               Foreground="White" VerticalAlignment="Center"/>
                    <!-- (!) panelclose, NOT ghost: `Button.ghost` is declared separately in each app's
                         App.axaml and the two are different buttons (JUST PLAY: bare icon; JUST TAG:
                         filled pill), which is exactly why this x did not match JUST PLAY's. -->
                    <Button Grid.Column="1" Classes="panelclose"
                            Click="OnClose" ToolTip.Tip="Close settings">
                        <uic:JustIcon Kind="Close" Width="13" Height="13"/>
                    </Button>
                </Grid>

                <!-- === THEME === -->
                <StackPanel Spacing="10" ClipToBounds="False">
                    <TextBlock Classes="label" Text="THEME"/>
                    <!-- Diagonal swatch chips (shared ThemeSwatchChip) - each previews its own theme;
                         the active one keeps its accent ring + glow. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0" ClipToBounds="False">
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Aurora">
                            <theming:ThemeSwatchChip ThemeName="Aurora"
                                    IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Aurora}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Sunset">
                            <theming:ThemeSwatchChip ThemeName="Sunset"
                                    IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Sunset}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Midnight">
                            <theming:ThemeSwatchChip ThemeName="Midnight"
                                    IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Midnight}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Onyx">
                            <theming:ThemeSwatchChip ThemeName="Onyx"
                                    IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Onyx}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Neon">
                            <theming:ThemeSwatchChip ThemeName="Neon"
                                    IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Neon}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Hardcore">
                            <theming:ThemeSwatchChip ThemeName="Hardcore"
                                    IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Hardcore}"/>
                        </Button>
                    </StackPanel>
                    <!-- Tracks HOVER preview (live resource), not just the committed theme. -->
                    <TextBlock Text="{DynamicResource DisplayThemeName}" FontSize="10"
                               Foreground="#73FFFFFF" LetterSpacing="2"/>
                </StackPanel>

                <Border Height="1" Background="{StaticResource HairlineBrush}"/>

                <!-- === WORKERS ===
                     JUST PLAY's "Analysis threads" control, PORTED - same range, same default, same
                     radio-button idiom, because a second dialect of one knob is how two JUST windows
                     start behaving differently (Chloe 2026-08-07: "wozu hat man zig prozessorkerne?!").
                     Reading a tag waits on the NETWORK, not on a core, so this is close to a linear
                     speed-up on a big folder - it is not a CPU setting despite looking like one. -->
                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="WORKERS"/>
                        <TextBlock Classes="value" FontSize="11" TextWrapping="Wrap"
                                   Text="How many files to read at once. Reading tags waits on the network, so more workers fill a big folder faster."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="seg" Content="1" Command="{Binding SetThreadsCommand}" CommandParameter="1"
                                Classes.active="{Binding ThreadsText, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=1}"/>
                        <Button Classes="seg" Content="2" Command="{Binding SetThreadsCommand}" CommandParameter="2"
                                Classes.active="{Binding ThreadsText, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=2}"/>
                        <Button Classes="seg" Content="4" Command="{Binding SetThreadsCommand}" CommandParameter="4"
                                Classes.active="{Binding ThreadsText, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=4}"/>
                        <Button Classes="seg" Content="8" Command="{Binding SetThreadsCommand}" CommandParameter="8"
                                Classes.active="{Binding ThreadsText, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=8}"/>
                        <Button Classes="seg" Content="16" Command="{Binding SetThreadsCommand}" CommandParameter="16"
                                Classes.active="{Binding ThreadsText, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=16}"/>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{StaticResource HairlineBrush}"/>

                <!-- === WRITE FORMAT (MP3) ===
                     This setting is the ONLY way into an ID3 version change in the whole suite:
                     the CLI and JUST PLAY never call ConfigureId3WriteFormat, so they run with
                     ForceDefaultVersion = false and preserve whatever version a file has. The
                     default option below does exactly the same; the three CONVERT options force
                     it, in BOTH directions - hence the caution card under them. -->
                <StackPanel Spacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="WRITE FORMAT  -  MP3 / ID3v2"/>
                        <TextBlock Classes="value" FontSize="11" TextWrapping="Wrap"
                                   Text="What saving does to an MP3's ID3 version. FLAC, MP4 and Ogg ignore this."/>
                    </StackPanel>

                    <Button Classes="opt" Command="{Binding SetWriteFormatCommand}" CommandParameter="KeepFileVersion"
                            Classes.active="{Binding WriteFormat, Converter={x:Static vm:EnumEqualsConverter.Instance}, ConverterParameter=KeepFileVersion}">
                        <Grid ColumnDefinitions="Auto,12,*">
                            <Border Classes="optdot" Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                    BorderThickness="2" BorderBrush="#59FFFFFF" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Spacing="1">
                                <!-- The non-converting option carries the DEFAULT badge so it reads as
                                     the default, not merely as the first row in a list. -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Keep each file's version" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#ECFFFFFF"
                                               VerticalAlignment="Center"/>
                                    <Border Classes="pill">
                                        <TextBlock Classes="pilltext" Text="DEFAULT"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="value" FontSize="11" TextWrapping="Wrap"
                                           Text="Nothing is converted. Only the fields you edited are written."/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Classes="opt" Command="{Binding SetWriteFormatCommand}" CommandParameter="Id3v23Utf16"
                            Classes.active="{Binding WriteFormat, Converter={x:Static vm:EnumEqualsConverter.Instance}, ConverterParameter=Id3v23Utf16}">
                        <Grid ColumnDefinitions="Auto,12,*">
                            <Border Classes="optdot" Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                    BorderThickness="2" BorderBrush="#59FFFFFF" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Spacing="1">
                                <TextBlock Text="Convert to ID3v2.3 - UTF-16" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#ECFFFFFF"/>
                                <TextBlock Classes="value" FontSize="11" TextWrapping="Wrap"
                                           Text="Reads everywhere - Windows, car &amp; DJ gear. mp3tag's default."/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Classes="opt" Command="{Binding SetWriteFormatCommand}" CommandParameter="Id3v23Latin1"
                            Classes.active="{Binding WriteFormat, Converter={x:Static vm:EnumEqualsConverter.Instance}, ConverterParameter=Id3v23Latin1}">
                        <Grid ColumnDefinitions="Auto,12,*">
                            <Border Classes="optdot" Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                    BorderThickness="2" BorderBrush="#59FFFFFF" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Spacing="1">
                                <TextBlock Text="Convert to ID3v2.3 - ISO-8859-1" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#ECFFFFFF"/>
                                <TextBlock Classes="value" FontSize="11" TextWrapping="Wrap"
                                           Text="Same version, plain text - for old gear that chokes on UTF-16."/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Classes="opt" Command="{Binding SetWriteFormatCommand}" CommandParameter="Id3v24Utf8"
                            Classes.active="{Binding WriteFormat, Converter={x:Static vm:EnumEqualsConverter.Instance}, ConverterParameter=Id3v24Utf8}">
                        <Grid ColumnDefinitions="Auto,12,*">
                            <Border Classes="optdot" Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                    BorderThickness="2" BorderBrush="#59FFFFFF" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Spacing="1">
                                <TextBlock Text="Convert to ID3v2.4 - UTF-8" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#ECFFFFFF"/>
                                <TextBlock Classes="value" FontSize="11" TextWrapping="Wrap"
                                           Text="Modern and compact. Only for software known to read v2.4."/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Measured 2026-07-31 (128 writes / 787 vendor frames): a version change
                         re-serialises the tag and re-encodes GEOB descriptors. Payloads survive
                         byte-for-byte; the LABEL Serato/MIK search by does not. Re-verified against
                         the shipped writer: F_mik_armstrong.mp3 (v2.4) saved in the DEFAULT mode
                         came back v2.3 with GEOB:CuePoints relabelled Latin-1 -> UTF-16+BOM. -->
                    <Border Classes="caution">
                        <Grid ColumnDefinitions="Auto,11,*">
                            <!-- Lucide "triangle-alert". -->
                            <Path Grid.Column="0" Stretch="Uniform" Width="15" Height="15"
                                  VerticalAlignment="Top" Margin="0,1,0,0"
                                  Stroke="{DynamicResource CautionBrush}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  Data="M10.29 3.86 L1.82 18 a2 2 0 0 0 1.71 3 h16.94 a2 2 0 0 0 1.71 -3
                                        L13.71 3.86 a2 2 0 0 0 -3.42 0 Z M12 9 v4 M12 17 h.01"/>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Classes="cautiontitle"
                                           Text="Converting rewrites Serato's frame labels"/>
                                <TextBlock Classes="cautionbody"
                                           Text="Serato and Mixed In Key find their cue points, key and energy by the frame label. Converting an MP3 to another ID3 version rewrites those labels, and they can stop finding the data."/>
                                <TextBlock Classes="cautionfix"
                                           Text="A convert option applies to every file you save, not only the ones that need it. JUST TAG warns you above Save when the open file would change."/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bottom breathing room, so the last control clears the panel edge. -->
                <Border Height="20" Background="Transparent"/>
            </StackPanel>
        </ScrollViewer>
    </uic:SurfaceCard>
</UserControl>
