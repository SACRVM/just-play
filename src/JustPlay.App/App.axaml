<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JustPlay.App.App"
             xmlns:conv="using:JustPlay.App.Converters"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!--
          THEME PALETTE — these nine Colors are the only ones the AvaloniaThemeService
          overwrites at runtime. The starting values are the Aurora theme; the service
          replaces them with Sunset/Midnight/Neon by writing to Application.Resources.

          IMPORTANT: every consumer below uses {DynamicResource …} on these Colors,
          NOT {StaticResource …}. StaticResource captures the value once at XAML-load
          and never updates — the classic "theme switch works on next app start but
          not live" bug. DynamicResource subscribes to key changes and re-renders.

          The Glow alpha (0x8C ≈ 0.55) was missing in the previous Aurora resource
          (#8C69FF rendered fully opaque). Restored from the design's
          rgba(140,105,255, 0.55).
        -->
        <Color x:Key="BgFrom">#3a1d6b</Color>
        <Color x:Key="BgVia">#251347</Color>
        <Color x:Key="BgTo">#120a26</Color>

        <Color x:Key="AccentA">#6ce0ff</Color>   <!-- cyan  -->
        <Color x:Key="AccentB">#ff5fae</Color>   <!-- pink  -->
        <Color x:Key="AccentC">#8a5fff</Color>   <!-- purple -->
        <Color x:Key="Glow">#8C8C69FF</Color>    <!-- rgba(140,105,255, 0.55) -->

        <!-- Bottom-bar gradient pair from the design's `bottomBarFrom/To` — declared
             so future UI consumers can DynamicResource them; nothing in the current
             tree paints with them yet. -->
        <Color x:Key="BottomBarFrom">#8a4fe0</Color>
        <Color x:Key="BottomBarTo">#5fa0ff</Color>

        <!-- Pre-alphaised variants of the accent Colors. CSS in the design specifies
             these per-theme as e.g. `${accentC}22` (= accentC at alpha 0x22 / 13.3%) —
             the same Color but with a different alpha byte. Avalonia's BoxShadow string
             grammar AND its LinearGradientBrush gradient stops want the alpha baked into
             the Color value, so we declare each alpha variant as its own key and let
             AvaloniaThemeService recompute them from each theme's AccentB / AccentC at
             apply-time. Defaults below are Aurora. -->

        <!-- AccentB (warm — pink in Aurora) -->
        <Color x:Key="AccentBGlow">#99ff5fae</Color>       <!-- α .60 — play halo idle -->
        <Color x:Key="AccentBGlowStrong">#CCff5fae</Color> <!-- α .80 — play halo hover -->
        <Color x:Key="AccentBSolid">#FFff5fae</Color>      <!-- α 1.0 — active-row edge halo -->
        <Color x:Key="AccentBRow">#10ff5fae</Color>        <!-- α .063 — selected row gradient stop (design) -->
        <Color x:Key="AccentBRowHover">#1Aff5fae</Color>   <!-- α .10  — selected+hover row gradient stop -->

        <!-- AccentC (tertiary — purple in Aurora) -->
        <Color x:Key="AccentCRow">#228a5fff</Color>        <!-- α .133 — selected row gradient stop (design) -->
        <Color x:Key="AccentCRowHover">#338a5fff</Color>   <!-- α .20  — selected+hover row gradient stop -->

        <!-- Extra glow alphas. SkeuSlider thumb glow tracks the design's
             progress-bar `0 0 10px ${theme.accentB}88` (~53%). Sleeve aura and
             window haze are our Aurora-style extensions, now theme-driven so
             Sunset/Midnight/Neon get matching room-light tints. -->
        <Color x:Key="AccentBHalfGlow">#80ff5fae</Color>   <!-- α .50  — slider thumb halo -->
        <Color x:Key="AccentCSoftAura">#408a5fff</Color>   <!-- α .25  — sleeve outer aura -->
        <Color x:Key="AccentCWindowGlow">#2A8a5fff</Color> <!-- α .16  — window outer haze -->

        <!-- DERIVED BRUSHES — composed from the Colors above via DynamicResource,
             so a single Color swap by AvaloniaThemeService propagates into every
             brush that references it without us having to rebuild brushes here. -->
        <SolidColorBrush x:Key="AccentABrush" Color="{DynamicResource AccentA}"/>
        <SolidColorBrush x:Key="AccentBBrush" Color="{DynamicResource AccentB}"/>
        <SolidColorBrush x:Key="AccentCBrush" Color="{DynamicResource AccentC}"/>

        <!-- Cyan → Pink gradient used on progress, primary button, gradient text -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="{DynamicResource AccentA}"/>
            <GradientStop Offset="1" Color="{DynamicResource AccentB}"/>
        </LinearGradientBrush>

        <!-- Cyan → White → Pink — for gradient track-title text -->
        <LinearGradientBrush x:Key="TitleGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="{DynamicResource AccentA}"/>
            <GradientStop Offset="0.5" Color="White"/>
            <GradientStop Offset="1" Color="{DynamicResource AccentB}"/>
        </LinearGradientBrush>

        <!-- Window background: linear base + two radial blooms layered on top -->
        <LinearGradientBrush x:Key="BgLinear" StartPoint="10%,0%" EndPoint="90%,100%">
            <GradientStop Offset="0" Color="{DynamicResource BgFrom}"/>
            <GradientStop Offset="0.5" Color="{DynamicResource BgVia}"/>
            <GradientStop Offset="1" Color="{DynamicResource BgTo}"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="BgGlowA" Center="70%,20%" GradientOrigin="70%,20%" RadiusX="55%" RadiusY="55%">
            <GradientStop Offset="0" Color="{DynamicResource Glow}"/>
            <GradientStop Offset="1" Color="#00000000"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BgGlowB" Center="10%,80%" GradientOrigin="10%,80%" RadiusX="55%" RadiusY="55%">
            <GradientStop Offset="0" Color="{DynamicResource AccentC}"/>
            <GradientStop Offset="1" Color="#00000000"/>
        </RadialGradientBrush>

        <!-- Text -->
        <SolidColorBrush x:Key="TextBrush" Color="White"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A6FFFFFF"/>        <!-- white .65 -->
        <SolidColorBrush x:Key="MutedDimBrush" Color="#73FFFFFF"/>     <!-- white .45 -->
        <SolidColorBrush x:Key="MutedFaintBrush" Color="#40FFFFFF"/>   <!-- white .25 -->
        <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF"/>     <!-- white .08 -->

        <conv:CamelotToBrushConverter x:Key="CamelotToBrush"/>
        <conv:CamelotBorderBrushConverter x:Key="CamelotBorder"/>
        <conv:PlayPausePathConverter x:Key="PlayPausePath"/>
        <conv:EnergyBarColorConverter x:Key="EnergyBarColor"/>
        <conv:StringEqualsConverter x:Key="StringEquals"/>
        <conv:ConflictWeightConverter x:Key="ConflictWeight"/>
        <conv:ConflictForegroundConverter x:Key="ConflictForeground"/>

        <!--
          ToggleSwitch overrides — FluentTheme's defaults bind ToggleSwitchFillOn et al.
          to SystemAccentColor, which on most Windows installs picks up whatever accent
          the user set in Settings (red on some configs — the bug Chloe spotted). Pin
          these to our theme palette: AccentB (warm) for the ON track, AccentC for the
          pressed variant. AvaloniaThemeService doesn't have to touch these — they go
          through {DynamicResource AccentB} live and follow the active theme as it switches.
        -->
        <!-- ON state — track background -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn"            Color="{DynamicResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"     Color="{DynamicResource AccentC}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled"    Color="#40FFFFFF"/>

        <!-- ON state — track stroke (border) -->
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn"            Color="{DynamicResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{DynamicResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"     Color="{DynamicResource AccentC}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled"    Color="#40FFFFFF"/>

        <!-- ON state — knob (the round handle). White reads cleanly on every theme's
             warm accent; dark Fluent default leaves it nearly invisible. -->
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"            Color="White"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="#F0FFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled"    Color="#80FFFFFF"/>

        <!--
          Per-theme palette previews used as the swatches in the tweaks panel's palette
          radio (no theme swap wired yet — values come straight from the design's THEMES).
        -->
        <LinearGradientBrush x:Key="SwatchAurora" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#6ce0ff"/>
            <GradientStop Offset="0.5" Color="#8a5fff"/>
            <GradientStop Offset="1" Color="#ff5fae"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SwatchSunset" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#ffd166"/>
            <GradientStop Offset="0.5" Color="#ff9966"/>
            <GradientStop Offset="1" Color="#ff6f91"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SwatchMidnight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#7ad7ff"/>
            <GradientStop Offset="0.5" Color="#2a7bff"/>
            <GradientStop Offset="1" Color="#7c5cff"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SwatchNeon" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5cffd4"/>
            <GradientStop Offset="0.5" Color="#5cd0ff"/>
            <GradientStop Offset="1" Color="#a8ff5c"/>
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!--
          Global text styling:
          • ClipToBounds=False: descenders (y, g, p, J, Y…) sometimes get cut by tight bounding
            boxes. Letting TextBlock render past its own bounds is the cheap fix.
          • DropShadowEffect: a soft 1-px black drop under every TextBlock. Keeps glyphs legible
            against the aurora background, gives the whole UI a "lifted" feel. Kept small
            (blur=2, opacity=0.4) to stay cheap to render even on dense lists.
        -->
        <Style Selector="TextBlock">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
            </Setter>
        </Style>

        <!--
          Caption buttons à la ../firepit-ai: square 36×36, transparent until hovered,
          dark grey on hover, Close goes red. Path icons inside Content scale via the
          button's Foreground so hover automatically brightens the glyph too.
        -->
        <Style Selector="Button.cap">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.cap:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
        <Style Selector="Button.cap:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cap:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <!--
          "Live" state for the streaming/broadcast cap button: when connected or
          connecting the radio-tower glyph lights up in the theme accent (its Stroke
          binds to the button Foreground), so a glance tells you the app is on air.
          Set via Classes.streaming="{Binding IsConnectedOrConnecting}" in MaxView.
          Accent cyan reads as "active/transmitting" and follows the active theme.
        -->
        <Style Selector="Button.cap.streaming">
            <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
        </Style>
        <!--
          Update badge: the Discord-style "download to a bar" glyph that appears (IsVisible bound to
          Update.IsAvailable) when a newer release lands. Green by design — universally reads as
          "ready / go", and it's the one cap button that wants to draw the eye. The glyph Stroke
          binds to the button Foreground, so the green here colours it; hover brightens to a lighter
          green. A soft green glow makes it pop against the dark chrome without shouting.
        -->
        <Style Selector="Button.cap.update">
            <Setter Property="Foreground" Value="#3BD671"/>
        </Style>
        <Style Selector="Button.cap.update:pointerover">
            <Setter Property="Foreground" Value="#5BE88A"/>
        </Style>
        <!--
          The close button sits in the TOP-RIGHT corner of the window. Without this corner
          radius its hover/pressed background paints a square red — which sticks out past
          the card's rounded top-right corner (CornerRadius=14 on the Card Border). Giving
          the button the same top-right radius keeps the hover red flush inside the rounded
          window edge instead of clipping into a notch.
        -->
        <Style Selector="Button.cap.close">
            <Setter Property="CornerRadius" Value="0,14,0,0"/>
        </Style>
        <Style Selector="Button.cap.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="CornerRadius" Value="0,14,0,0"/>
        </Style>
        <Style Selector="Button.cap.close:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.cap.close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#A21020"/>
            <Setter Property="CornerRadius" Value="0,14,0,0"/>
        </Style>

        <!--
          Shared dialog button — pill, dark translucent, hover lift. Used by the frameless dialog
          windows (About, Transfer, InputDialog). Overriding the pointerover/pressed ContentPresenter
          background keeps FluentTheme's accent from leaking through (the documented custom-button quirk).
        -->
        <Style Selector="Button.dialog-close">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="28,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.dialog-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2EFFFFFF"/>
        </Style>
        <Style Selector="Button.dialog-close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <!--
          "ghost" variant — a de-emphasised dialog action (e.g. "Ignore this version" sitting to the
          left of the primary). Transparent until hover, muted text, tighter padding so a long label
          doesn't crowd the primary actions. Pair with Classes="dialog-close ghost".
        -->
        <Style Selector="Button.dialog-close.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Padding" Value="6,9"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector="Button.dialog-close.ghost /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.dialog-close.ghost:pointerover">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
        </Style>
        <Style Selector="Button.dialog-close.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!--
          Primary play button: vertical cyan→pink gradient, layered inset bevel + outer rings
          + pink glow, hover scales up. Faithful port of CtrlButton(primary=true) in player.jsx.
        -->
        <Style Selector="Button.primary">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
            <Setter Property="CornerRadius" Value="35"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <!--
                      ClipToBounds=False so the Halo's BoxShadow can extend past the 70×70
                      button bounds. Parent chain (Button inline, transport Grid, Card) also
                      has ClipToBounds=False.
                    -->
                    <Grid ClipToBounds="False">
                        <!--
                          Halo = transparent rounded Border with a big-blur pink BoxShadow.
                          This is the faithful port of the mockup CSS `box-shadow: 0 0 30px
                          accentBxx` — BoxShadow inherits the Border's CornerRadius shape so
                          a circular border gives a circular glow, no rectangular clipping.

                          BoxShadow syntax: "Xoffset Yoffset Blur Spread Color".
                          Default (0,0,30,0,#99ff5fae) ≈ 60% alpha pink glow extending 30 px
                          out from the button edge. Hover bumps blur to 40 and alpha to 0xCC
                          (80%) so the glow visibly intensifies when the user is on the button.
                        -->
                        <Border Name="Halo"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="Transparent"
                                IsHitTestVisible="False"/>

                        <Border Name="MainBorder"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Background>
                                <!-- Cyan→pink gradient sourced from the live theme palette
                                     so Sunset/Midnight/Neon recolour the play button too,
                                     not just the surrounding chrome. -->
                                <LinearGradientBrush StartPoint="37%,0%" EndPoint="63%,100%">
                                    <GradientStop Offset="0" Color="{DynamicResource AccentA}"/>
                                    <GradientStop Offset="1" Color="{DynamicResource AccentB}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- Glossy top-left specular highlight -->
                        <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.3,0.25" GradientOrigin="0.3,0.25" RadiusX="0.45" RadiusY="0.45">
                                    <GradientStop Offset="0" Color="#80FFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Background="Transparent"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!--
          Halo BoxShadow lives OUTSIDE the Template so :pointerover wins (inside-template
          inline values have Local-precedence). Two states, BoxShadowsTransition gives a
          smooth fade between them.

          The BoxShadows objects PlayHaloIdle / PlayHaloHover are NOT declared here in XAML
          — they are emitted by AvaloniaThemeService at apply-time, because BoxShadow's
          Color property can't take a DynamicResource through the XAML compiler (Avalonia
          12's AVLN2000 trips on the object-form parse), and the string-form "0 0 30 0
          #99ff5fae" can't compose alpha onto a theme-driven AccentB. Rebuilding the whole
          BoxShadows object per theme is the path that survives both constraints.
        -->
        <Style Selector="Button.primary /template/ Border#Halo">
            <Setter Property="BoxShadow" Value="{DynamicResource PlayHaloIdle}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ Border#Halo">
            <Setter Property="BoxShadow" Value="{DynamicResource PlayHaloHover}"/>
        </Style>
        <!--
          BoxShadow base/hover/pressed live OUTSIDE the Template as Style Setters so :pointerover
          and :pressed actually win (inline values inside the Template have Local-precedence and
          would override any state Setter). Reduced blur compared to first attempt so the glow
          doesn't extend past the card's clip-bounds.
        -->
        <!--
          Halo is now drawn by a separate Ellipse BEHIND the button (in MaxView) — see there.
          The BoxShadow here only has the 6 short-range layers (bevel + drop shadow + rings).
          The 50-px pink ring layer was being clipped to a rectangle by Avalonia's parent-bounds
          render constraint when on a Button.
        -->
        <Style Selector="Button.primary /template/ Border#MainBorder">
            <Setter Property="BoxShadow"
                    Value="inset 0 1 1 0 #80FFFFFF, inset 0 -2 4 0 #59000000, 0 1 0 0 #26FFFFFF, 0 6 14 0 #73000000, 0 0 0 1 #4D000000, 0 0 0 3 #0FFFFFFF"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ Border#MainBorder">
            <Setter Property="BoxShadow"
                    Value="inset 0 1 1 0 #99FFFFFF, inset 0 -2 4 0 #59000000, 0 1 0 0 #26FFFFFF, 0 6 14 0 #73000000, 0 0 0 1 #4D000000, 0 0 0 3 #1FFFFFFF"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ Border#MainBorder">
            <Setter Property="BoxShadow"
                    Value="inset 0 3 6 0 #73000000, inset 0 -1 1 0 #33FFFFFF, 0 1 2 0 #66000000, 0 0 0 3 #0AFFFFFF"/>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.04)"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!--
          Belt-and-braces ContentPresenter overrides for ALL states. FluentTheme has
          rules for both Background and BorderBrush on the templated ContentPresenter
          (matched by type even without #PART_ContentPresenter name). Override here so
          nothing leaks through and creates the "box behind the icon" the user sees.
        -->
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ctrl /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.ctrl:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ctrl:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!--
          Secondary ctrl button (prev/next): subtle radial glass-button look, inset bevel,
          gentle outer ring. Hover scales up slightly. Port of CtrlButton(primary=false).
        -->
        <Style Selector="Button.ctrl">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="23"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="MainBorder"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Background>
                                <RadialGradientBrush Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0" Color="#33FFFFFF"/>
                                    <GradientStop Offset="0.6" Color="#08FFFFFF"/>
                                    <GradientStop Offset="1" Color="#33000000"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,50%">
                                    <GradientStop Offset="0" Color="#33FFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter Background="Transparent"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ctrl /template/ Border#MainBorder">
            <Setter Property="BoxShadow"
                    Value="inset 0 1 0 0 #80FFFFFF, inset 0 -1 2 0 #66000000, 0 2 4 0 #66000000, 0 0 0 1 #29FFFFFF"/>
        </Style>
        <Style Selector="Button.ctrl:pointerover /template/ Border#MainBorder">
            <Setter Property="BoxShadow"
                    Value="inset 0 1 0 0 #B3FFFFFF, inset 0 -1 2 0 #66000000, 0 2 4 0 #80000000, 0 0 0 1 #4DFFFFFF, 0 0 14 0 #40FFFFFF"/>
        </Style>
        <Style Selector="Button.ctrl:pressed /template/ Border#MainBorder">
            <Setter Property="BoxShadow"
                    Value="inset 0 2 5 0 #80000000, inset 0 -1 1 0 #14FFFFFF, 0 0 0 1 #66000000"/>
        </Style>
        <Style Selector="Button.ctrl:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)"/>
        </Style>
        <Style Selector="Button.ctrl:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>

        <!--
          White transport icons sit on bright/coloured buttons — especially the
          cyan→pink play button, where plain white washes out against the light cyan
          end. Give the icon Paths the same soft drop shadow the global TextBlock
          style uses (Black, blur 2, 0/1, .45) so they read with contrast and match
          the app's lifted feel. Scoped to Button.primary / Button.ctrl Paths only —
          NOT the transparent iconbtn secondaries (no white-on-colour issue there).
        -->
        <Style Selector="Button.primary Path">
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
            </Setter>
        </Style>
        <Style Selector="Button.ctrl Path">
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
            </Setter>
        </Style>

        <!--
          Square 32×32 icon button for transport secondaries (shuffle / repeat /
          like). Shared by MaxView and MiniView (was duplicated in both, at 32 vs
          30 px — unified here to 32). Consistent hit area; transparent until
          hovered. .active recolours the glyph to the live accent — the icon Paths
          bind their Stroke to the button Foreground, so this alone tints them.
        -->
        <Style Selector="Button.iconbtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Kill the default focus adorner (Avalonia draws a dashed rectangle on keyboard
                 focus; FluentTheme's Button template has no focus visual of its own — verified
                 against release/12.0.3 Button.xaml). Icon buttons don't need a focus ring, and
                 the heart was grabbing initial focus → a stray "highlighted" look at startup. -->
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.iconbtn:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.iconbtn.active">
            <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
        </Style>
        <Style Selector="Button.iconbtn.active:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
        </Style>

        <!-- Small ghost icon/text button (chrome + panel secondaries, e.g. the
             Tweaks-panel close ✕). Shared by both views. -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#A6FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Styles>
</Application>
