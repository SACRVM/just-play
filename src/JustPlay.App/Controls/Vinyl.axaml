<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:JustPlay.App.Controls"
             x:Class="JustPlay.App.Controls.Vinyl"
             x:DataType="controls:Vinyl"
             Width="468" Height="360"
             ClipToBounds="False">

    <!-- ClipToBounds=False so the new ground-shadow ellipse (Margin bottom=-14) and the
         vinyl drop-shadow (BoxShadow Y=18, blur=30) can render past the 360-px height
         without being clipped by the UserControl's own bounds. The host containers in
         MiniView (Viewbox) and MaxView (Panel) likewise don't clip — they rely on
         Avalonia's Panel default ClipToBounds=false. -->
    <Grid ClipToBounds="False">
        <!--
          GROUND SHADOW — soft elliptical pool under the whole sleeve+vinyl, port of the
          design's `radial-gradient(...,.55) ellipse` + blur(12). Lifts the disc off the
          aurora background. Sits at the very back of the Grid so it renders first.
          Margin pushes it 14 px below the 360-tall sleeve, matching the design's
          `bottom: -14`. Width 320 = sleeve (360) minus the design's left/right 20 px inset.
        -->
        <Ellipse Width="320" Height="26"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="20,0,0,-14"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#8C000000"/>
                    <GradientStop Offset="0.7" Color="#00000000"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!--
          VINYL DROP-SHADOW EMITTER — transparent circular Border whose BoxShadow renders
          the design's `drop-shadow(0 18px 30px rgba(0,0,0,.5))`. Kept on a SEPARATE,
          non-rotating element behind the spinning disc so the shadow doesn't sweep around
          with the rotation (a DropShadowEffect on VinylGroup itself would offset relative
          to the rotated frame — at 90° the "downward" shadow would point sideways).
          BoxShadow respects the Border's CornerRadius, so CornerRadius=180 on a 360×360
          Border gives a perfect circular shadow.
        -->
        <Border Width="360" Height="360" HorizontalAlignment="Right"
                CornerRadius="180" Background="Transparent"
                BoxShadow="0 18 30 0 #80000000"
                IsHitTestVisible="False"/>

        <!-- VINYL — sits BEHIND the sleeve, pushed right so ~30% pokes out. Spins.
             RenderTransformOrigin is left at Avalonia's default (RelativePoint.Center),
             which makes the bare RotateTransform attached in code-behind rotate around
             (180, 180) — the geometric centre of this 360×360 Grid — automatically. -->
        <Grid x:Name="VinylGroup" Width="360" Height="360" HorizontalAlignment="Right">

            <Ellipse Width="360" Height="360">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Offset="0" Color="#1a1216"/>
                        <GradientStop Offset="0.78" Color="#080406"/>
                        <GradientStop Offset="0.95" Color="#000000"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- A few groove suggestions -->
            <Ellipse Width="340" Height="340" Stroke="#14FFFFFF" StrokeThickness="0.7"/>
            <Ellipse Width="300" Height="300" Stroke="#0DFFFFFF" StrokeThickness="0.6"/>
            <Ellipse Width="260" Height="260" Stroke="#14FFFFFF" StrokeThickness="0.7"/>
            <Ellipse Width="220" Height="220" Stroke="#0DFFFFFF" StrokeThickness="0.6"/>
            <Ellipse Width="180" Height="180" Stroke="#14FFFFFF" StrokeThickness="0.7"/>

            <Ellipse Width="356" Height="356">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="20%,10%" EndPoint="80%,90%">
                        <GradientStop Offset="0" Color="#00FFFFFF"/>
                        <GradientStop Offset="0.5" Color="#26FFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="126" Height="126" Fill="#99000000"/>
            <Ellipse Width="120" Height="120">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
                        <GradientStop Offset="0" Color="{StaticResource AccentA}"/>
                        <GradientStop Offset="0.45" Color="{StaticResource AccentC}"/>
                        <GradientStop Offset="1" Color="{StaticResource AccentB}"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="120" Height="120">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.4,0.4" GradientOrigin="0.4,0.4" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Offset="0" Color="#59FFFFFF"/>
                        <GradientStop Offset="0.6" Color="#00FFFFFF"/>
                        <GradientStop Offset="1" Color="#59000000"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="JUST PLAY" FontWeight="Bold" FontSize="9" Foreground="#E6FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,28"/>
            <TextBlock Text="A · 33⅓" FontSize="7" Foreground="#73FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,28,0,0"/>

            <Ellipse Width="6" Height="6" Fill="Black"/>
        </Grid>

        <!--
          SLEEVE — square cardboard sleeve in FRONT of the vinyl.

          TWO-LAYER PATTERN — required because Avalonia clips a Border's OWN BoxShadow
          when that Border has ClipToBounds=True. The inner Border has to clip
          (otherwise the cover Image with Stretch=UniformToFill bleeds past the rounded
          corner), but a clipping Border drops its own outer drop-shadow on the floor.
          Same fix as Button.primary's Halo + MainBorder pair in App.axaml.

          OUTER Border — transparent, NOT clipped. Carries the outer BoxShadow stack:
            • Layer 1: deep slightly-offset black drop (the cardboard's gravity).
            • Layer 2: 1-px white outer ring (catches edge light).
            • Layer 3: soft purple aura — Aurora-theme extension, not in the design,
              picks up the BgGlow tint so the sleeve feels lit by the room.
        -->
        <Border Width="360" Height="360" HorizontalAlignment="Left"
                CornerRadius="6" Background="Transparent"
                BoxShadow="0 30 60 -8 #BF000000, 0 0 0 1 #1FFFFFFF, 0 0 50 -10 #408a5fff">
            <!--
              INNER Border — clips the cover image to the rounded corner, and carries
              ONLY the inset top-edge white highlight (port of the design's
              `inset 0 1px 0 rgba(255,255,255,.18)`). Inset shadows paint on the INSIDE
              of the rounded edge, so they belong with the clipped content, not with the
              outer drop-shadow.
            -->
            <Border x:Name="Sleeve" CornerRadius="6" ClipToBounds="True"
                    BoxShadow="inset 0 1 0 0 #2EFFFFFF">
            <Panel>
                <!--
                  Source bound EXPLICITLY to the Vinyl ancestor's Cover styled-property via
                  $parent. The earlier `DataContext = this`-in-ctor approach was a known
                  source of intermittent failures (compiled bindings can evaluate against
                  the inherited DataContext before our ctor's assignment takes effect, and
                  then never re-bind). $parent[controls:Vinyl] is element-relative and
                  doesn't depend on DataContext at all — it just walks up to find Vinyl.
                -->
                <Image Source="{Binding $parent[controls:Vinyl].Cover}" Stretch="UniformToFill"/>

                <!--
                  Themed placeholder mirroring the design's AlbumCover (LOUD / RIHANNA),
                  visible whenever no real cover bitmap is present. Same $parent binding.
                -->
                <Panel IsVisible="{Binding $parent[controls:Vinyl].Cover, Converter={x:Static ObjectConverters.IsNull}}"
                       ClipToBounds="True">

                    <!-- Pink → purple → cyan gradient base -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="10%,0%" EndPoint="90%,100%">
                                <GradientStop Offset="0" Color="{StaticResource AccentB}"/>
                                <GradientStop Offset="0.55" Color="{StaticResource AccentC}"/>
                                <GradientStop Offset="1" Color="{StaticResource AccentA}"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Top-right specular highlight -->
                    <Border>
                        <Border.Background>
                            <RadialGradientBrush Center="0.78,0.22" GradientOrigin="0.78,0.22" RadiusX="0.55" RadiusY="0.55">
                                <GradientStop Offset="0" Color="#2EFFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Centered subtle radial spot -->
                    <Border>
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Offset="0" Color="#0FFFFFFF"/>
                                <GradientStop Offset="0.8" Color="#00FFFFFF"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!--
                      Concentric "sound-wave" rings in the bottom-right area.
                      Centered at (78%, 78%) of the 360-px sleeve = (281, 281).
                      Radii from the design (38/28/20/14/9 in a 100-unit viewBox) scaled ×3.6.
                    -->
                    <Canvas Width="360" Height="360">
                        <Ellipse Width="274" Height="274" Canvas.Left="144" Canvas.Top="144"
                                 Stroke="#52FFFFFF" StrokeThickness="0.7"/>
                        <Ellipse Width="202" Height="202" Canvas.Left="180" Canvas.Top="180"
                                 Stroke="#52FFFFFF" StrokeThickness="0.6"/>
                        <Ellipse Width="144" Height="144" Canvas.Left="209" Canvas.Top="209"
                                 Stroke="#52FFFFFF" StrokeThickness="0.5"/>
                        <Ellipse Width="100" Height="100" Canvas.Left="231" Canvas.Top="231"
                                 Stroke="#52FFFFFF" StrokeThickness="0.45"/>
                        <Ellipse Width="64" Height="64" Canvas.Left="249" Canvas.Top="249"
                                 Stroke="#52FFFFFF" StrokeThickness="0.4"/>
                    </Canvas>

                    <!--
                      Generic empty-state copy — JustPlay is a stateless drop-and-play
                      player, so the placeholder mustn't masquerade as anyone's album.
                      Earlier version had "LOUD / RIHANNA / SIDE A / 2010" carried 1:1
                      from the design mockup (Claude's AlbumCover component in
                      .design/.../app.jsx); that was design fixture content that
                      should never have shipped as the runtime fallback.
                    -->
                    <TextBlock Text="JUST" FontSize="78" FontWeight="Black"
                               Foreground="#F7FFFFFF" LineHeight="74"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,82,0,0"/>
                    <TextBlock Text="PLAY" FontSize="78" FontWeight="Black"
                               Foreground="#F7FFFFFF" LineHeight="74"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,156,0,0"/>
                    <Border Width="72" Height="2" Background="#D9FFFFFF"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,238,0,0"/>
                    <TextBlock Text="DROP A TRACK" FontSize="11" FontWeight="SemiBold" LetterSpacing="4"
                               Foreground="#A6FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,250,0,0"/>
                </Panel>

                <!-- Soft right-edge shadow where the vinyl emerges -->
                <Border HorizontalAlignment="Right" Width="14" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,0%">
                            <GradientStop Offset="0" Color="#3D000000"/>
                            <GradientStop Offset="1" Color="#00000000"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Panel>
            </Border>
        </Border>
    </Grid>
</UserControl>
