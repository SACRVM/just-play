<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.App.ViewModels"
             xmlns:models="using:JustPlay.Core.Models"
             xmlns:behaviors="using:JustPlay.UI.Behaviors"
             xmlns:theming="using:JustPlay.UI.Theming"
             x:Class="JustPlay.App.Controls.TweaksPanel"
             x:DataType="vm:MainWindowViewModel">

    <!--
      Slide-in Tweaks panel — extracted from MaxView so it lives as one self-
      contained control (its styles travel with it). Inherits the view's
      MainWindowViewModel DataContext. Visibility / right-dock alignment are set
      by the consumer (see MaxView: IsVisible={Binding IsTweaksOpen}). Mirrors the
      design's tweaks-panel.jsx: Theme palette · Stage toggles · Right-panel default.
    -->
    <UserControl.Styles>
        <!--
          ComboBox for output-device selection — dark frosted look matching the panel.
          We override the key template parts so the default Fluent light popup doesn't bleed through.

          Strategy: style the outer ComboBox control + the popup's presenter and items so
          everything is dark. Belt-and-braces overrides keep Fluent from painting light boxes.
        -->
        <Style Selector="ComboBox.device-picker">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="PlaceholderForeground" Value="#73FFFFFF"/>
        </Style>
        <Style Selector="ComboBox.device-picker:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="ComboBox.device-picker:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        </Style>
        <!-- Popup background: dark frosted, matching the panel itself -->
        <Style Selector="ComboBox.device-picker /template/ Popup Border">
            <Setter Property="Background" Value="#F01a1828"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <!-- Each item in the dropdown -->
        <Style Selector="ComboBox.device-picker ComboBoxItem">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox.device-picker ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="ComboBox.device-picker ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style Selector="ComboBox.device-picker ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>

        <!-- Section heading + row label -->
        <Style Selector="TextBlock.tweak-section">
            <Setter Property="Foreground" Value="#73FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="3"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style Selector="TextBlock.tweak-label">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Border.swatch / Button.swatchbtn styles promoted to JustPlay.UI/Theming/JustStyles.axaml
             (shared) so JUST STREAM's SettingsWindow Look tab uses the identical chip. -->

        <Style Selector="Button.tweak-radio">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- Soft elevation drop shadow so the buttons (esp. the active gradient one)
                 lift off the panel like the rest of the app's controls. The faint inactive
                 fill casts almost nothing; the opaque active pill reads clearly. -->
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="3" OffsetX="0" OffsetY="1" Opacity="0.35"/>
            </Setter>
        </Style>
        <Style Selector="Button.tweak-radio.active">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!--
          Hover/pressed must not let FluentTheme's own ContentPresenter tint paint over our fills —
          tweak-radio had no :pointerover style, so Fluent's grey hover covered the active accent pill
          ("hover wins over active"). Set the CP background explicitly for every interactive state
          (belt-and-braces, see App.axaml). The .active variants come AFTER the plain ones so, when a
          button is BOTH active and hovered/pressed, the accent wins (equal-specificity → last match).
        -->
        <Style Selector="Button.tweak-radio:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.tweak-radio:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF"/>
        </Style>
        <Style Selector="Button.tweak-radio.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        </Style>
        <Style Selector="Button.tweak-radio.active:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        </Style>

        <!-- White toggle knob on the accent track needs a shadow to read against the
             colour (design knob: box-shadow 0 1px 2px rgba(0,0,0,.25), tweaks-panel.jsx:115).
             Applied to the moving knob group (PART_MovingKnobs, verified against Avalonia
             12.0.3 ToggleSwitch.xaml) so it travels with the thumb. -->
        <Style Selector="ToggleSwitch /template/ Grid#PART_MovingKnobs">
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="3" OffsetX="0" OffsetY="1" Opacity="0.4"/>
            </Setter>
        </Style>

        <!-- Slider.eq and Slider.fader styles promoted to JustPlay.UI/Theming/JustStyles.axaml
             (shared) so JUST STREAM's DSP sliders also get the themed look. -->

        <!-- Tabs reuse the SHARED underline-tab style (Button.tab / Border.tabline) now in App.axaml
             — same look as the UP NEXT strip, no reinvented styles here. -->

        <!-- Labeled-control group: label hugs ITS control (Spacing 4); the outer panel spacing
             separates groups → fixes "the heading hangs above its control, not below". -->
        <Style Selector="StackPanel.tweakgroup">
            <Setter Property="Spacing" Value="4"/>
        </Style>

        <!--
          Modern slim scrollbar for the panel's ScrollViewer. Fluent's default is a chunky
          expanded bar (with up/down arrow buttons) or an auto-hiding line; we want a thin,
          always-visible rounded thumb that matches the frosted panel. Template parts verified
          against Avalonia 12.0.3 Themes.Fluent/Controls/ScrollBar.xaml: Grid#Root, Rectangle#TrackRect,
          the Thumb, and PART_LineUp/DownButton. Selectors fail safe (no-op) if a part is absent.
        -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Margin" Value="0,2,1,2"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- The groove behind the thumb — keep it a barely-there hairline. -->
        <Style Selector="ScrollBar:vertical /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="#0AFFFFFF"/>
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="Width" Value="3"/>
        </Style>
        <!-- The thumb itself: slim rounded pill, brighter on hover/drag. -->
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#66FFFFFF"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
            <Setter Property="Background" Value="#80FFFFFF"/>
        </Style>
        <!-- Drop the up/down arrow buttons — modern slim bars don't show them. -->
        <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_LineUpButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ RepeatButton#PART_LineDownButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>

    <Border Width="370"
            Background="#F01a1828"
            CornerRadius="0,14,14,0"
            BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0">
        <ScrollViewer Padding="22,16,18,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      AllowAutoHide="False">
            <StackPanel Spacing="12" ClipToBounds="False" Width="326">

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="TWEAKS" FontSize="12" FontWeight="Bold" LetterSpacing="3"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="ghost" Content="✕" FontSize="13"
                            Command="{Binding ToggleTweaksCommand}"/>
                </Grid>

                <!-- Tab strip — reuses the SHARED underline tabs (App.axaml), same look as UP NEXT.
                     One group of controls per tab keeps the panel short and lets the Sound rack grow. -->
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="tab"
                                Classes.active="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Look}"
                                Command="{Binding SetTweaksTabCommand}" CommandParameter="Look">
                            <Panel>
                                <TextBlock Text="Look" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
                                <Border Classes="tabline"/>
                            </Panel>
                        </Button>
                        <Button Classes="tab"
                                Classes.active="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Sound}"
                                Command="{Binding SetTweaksTabCommand}" CommandParameter="Sound">
                            <Panel>
                                <TextBlock Text="Sound" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
                                <Border Classes="tabline"/>
                            </Panel>
                        </Button>
                        <Button Classes="tab"
                                Classes.active="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Library}"
                                Command="{Binding SetTweaksTabCommand}" CommandParameter="Library">
                            <Panel>
                                <TextBlock Text="Library" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
                                <Border Classes="tabline"/>
                            </Panel>
                        </Button>
                        <Button Classes="tab"
                                Classes.active="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Audio}"
                                Command="{Binding SetTweaksTabCommand}" CommandParameter="Audio">
                            <Panel>
                                <TextBlock Text="Audio" FontSize="12" FontWeight="Bold" VerticalAlignment="Top"/>
                                <Border Classes="tabline"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ════════════ LOOK ════════════ -->
                <StackPanel Spacing="10" ClipToBounds="False"
                            IsVisible="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Look}">
                    <TextBlock Classes="tweak-section" Text="THEME"/>
                    <!-- Margin + tighter spacing so the end chips' glow clears the tweaks ScrollViewer's
                         content clip (the panel viewport is only ~4px wider than the 6-chip row). -->
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="11,0,11,0" ClipToBounds="False">
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Aurora">
                            <theming:ThemeSwatchChip ThemeName="Aurora"
                                    IsActive="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Aurora}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Sunset">
                            <theming:ThemeSwatchChip ThemeName="Sunset"
                                    IsActive="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Sunset}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Midnight">
                            <theming:ThemeSwatchChip ThemeName="Midnight"
                                    IsActive="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Midnight}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Onyx">
                            <theming:ThemeSwatchChip ThemeName="Onyx"
                                    IsActive="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Onyx}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Neon">
                            <theming:ThemeSwatchChip ThemeName="Neon"
                                    IsActive="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Neon}"/>
                        </Button>
                        <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Hardcore">
                            <theming:ThemeSwatchChip ThemeName="Hardcore"
                                    IsActive="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Hardcore}"/>
                        </Button>
                    </StackPanel>
                    <!-- Tracks HOVER preview (live resource), not just the committed theme. -->
                    <TextBlock Text="{DynamicResource DisplayThemeName}" FontSize="10"
                               Foreground="#73FFFFFF" LetterSpacing="2"/>

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,4"/>

                    <TextBlock Classes="tweak-section" Text="STAGE"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tweak-label" Text="Vinyl spin" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding VinylSpinEnabled}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tweak-label" Text="Waveform" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformEnabled}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                </StackPanel>

                <!-- ════════════ SOUND ════════════ -->
                <StackPanel Spacing="14"
                            IsVisible="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Sound}">
                    <!-- One-click bus presets — set the whole Sound chain at once. "Hard" = the validated
                         correction for harsh hard techno / hardstyle (AutoTilt + high-shelf cut + soft
                         limiter, measured on Chloe's library). "Neutral" = all flat/off.
                         Below the built-ins: the user's own saved presets (additive) + a "Save current…"
                         affordance. Saved presets capture the six Sound fields and re-apply with one click. -->
                    <StackPanel Classes="tweakgroup">
                        <TextBlock Classes="tweak-label" Text="Preset" VerticalAlignment="Center"
                                   ToolTip.Tip="One-click bus setups. Hard = tame the harsh top of hardcore / hardstyle (AutoTilt + High −3 dB) AND push it LOUD (Limiter Loud) so it holds up in a club/stream. Neutral = everything flat/off. Right-click a saved preset to replace or delete it; + saves the current settings under a name."/>

                        <!-- One row that flows together: every preset (the seeded built-ins Hard/Neutral
                             AND the user's own — all ordinary, editable entries), then the "+" (save current
                             as a new named preset) directly after them. Single WrapPanel so "+" sits right
                             behind the last preset and wraps with them. -->
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <!-- All presets. Click a chip to apply; RIGHT-CLICK for Replace / Delete.
                                 The apply Button binds back to the VM via $parent[UserControl] (item DataContext
                                 is a DspPreset). The ContextMenu lives in a popup OUTSIDE the UserControl's tree,
                                 so its items reach the VM through PlacementTarget.Tag (= the VM, stashed on the
                                 chip Border) and the clicked preset through PlacementTarget.DataContext. -->
                            <ItemsControl ItemsSource="{Binding SoundPresets}" IsVisible="{Binding HasSoundPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <Border Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                CornerRadius="8" Margin="0,0,8,8">
                                            <Border.ContextMenu>
                                                <!-- Click handlers (code-behind), NOT Command bindings: a ContextMenu lives
                                                     in a popup OUTSIDE the control's tree, so RelativeSource/PlacementTarget
                                                     command bindings resolve null → the items render permanently DISABLED.
                                                     The handler reads the preset from the item DataContext and the VM from
                                                     the panel. Same proven pattern as MaxView's stream context menu. -->
                                                <ContextMenu>
                                                    <MenuItem Header="Replace with current" Click="OnPresetReplace"/>
                                                    <MenuItem Header="Rename…" Click="OnPresetRename"/>
                                                    <MenuItem Header="Delete" Click="OnPresetDelete"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Button Classes="ghost" Padding="12,5" FontSize="12" FontWeight="SemiBold"
                                                    Foreground="#E6FFFFFF"
                                                    Content="{Binding Name}"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Apply this preset · right-click to replace / delete"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Save the CURRENT Sound state as a NEW named preset (prompts for a name). -->
                            <Button Classes="tweak-radio" Content="+" Margin="0,0,8,8"
                                    Command="{Binding SavePresetCommand}"
                                    ToolTip.Tip="Save the current EQ + Revive + Limiter settings as a new named preset."/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Normalize -->
                    <StackPanel Classes="tweakgroup">
                        <Grid ColumnDefinitions="*,Auto"
                              ToolTip.Tip="Even out playback level (ReplayGain — non-destructive, clip-safe). On = added tracks are analyzed automatically.">
                            <TextBlock Grid.Column="0" Classes="tweak-label" Text="Normalize loudness" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                          IsChecked="{Binding PlaybackNormalization}"
                                          OnContent="" OffContent=""/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding PlaybackNormalization}">
                            <Button Classes="tweak-radio" Content="Quiet"
                                    Classes.active="{Binding NormalizationLevel, Converter={StaticResource StringEquals}, ConverterParameter=Quiet}"
                                    Command="{Binding SetNormalizationLevelCommand}" CommandParameter="Quiet"
                                    ToolTip.Tip="−19 LUFS — most headroom"/>
                            <Button Classes="tweak-radio" Content="Normal"
                                    Classes.active="{Binding NormalizationLevel, Converter={StaticResource StringEquals}, ConverterParameter=Normal}"
                                    Command="{Binding SetNormalizationLevelCommand}" CommandParameter="Normal"
                                    ToolTip.Tip="−14 LUFS — like Spotify/YouTube"/>
                            <Button Classes="tweak-radio" Content="Loud"
                                    Classes.active="{Binding NormalizationLevel, Converter={StaticResource StringEquals}, ConverterParameter=Loud}"
                                    Command="{Binding SetNormalizationLevelCommand}" CommandParameter="Loud"
                                    ToolTip.Tip="−11 LUFS — close to modern masters"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Crossfade -->
                    <StackPanel Classes="tweakgroup">
                        <TextBlock Classes="tweak-label" Text="Crossfade"
                                   ToolTip.Tip="Blend into the next track on auto-advance. Off = hard boundary."/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="tweak-radio" Content="Off"
                                    Classes.active="{Binding CrossfadeSecondsText, Converter={StaticResource StringEquals}, ConverterParameter=0}"
                                    Command="{Binding SetCrossfadeLengthCommand}" CommandParameter="0"
                                    ToolTip.Tip="Hard track boundaries — no blend"/>
                            <Button Classes="tweak-radio" Content="2s"
                                    Classes.active="{Binding CrossfadeSecondsText, Converter={StaticResource StringEquals}, ConverterParameter=2}"
                                    Command="{Binding SetCrossfadeLengthCommand}" CommandParameter="2"
                                    ToolTip.Tip="2-second blend"/>
                            <Button Classes="tweak-radio" Content="4s"
                                    Classes.active="{Binding CrossfadeSecondsText, Converter={StaticResource StringEquals}, ConverterParameter=4}"
                                    Command="{Binding SetCrossfadeLengthCommand}" CommandParameter="4"
                                    ToolTip.Tip="4-second blend"/>
                            <Button Classes="tweak-radio" Content="8s"
                                    Classes.active="{Binding CrossfadeSecondsText, Converter={StaticResource StringEquals}, ConverterParameter=8}"
                                    Command="{Binding SetCrossfadeLengthCommand}" CommandParameter="8"
                                    ToolTip.Tip="8-second blend"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- EQ — vertical faders (DJ-mixer look) -->
                    <StackPanel Classes="tweakgroup">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="tweak-label" Text="EQ" VerticalAlignment="Center"
                                       ToolTip.Tip="3-band DJ EQ / isolator. Fader centre = flat, down = cut→kill, up = +6 dB. Crossovers 200 Hz / 4 kHz. Shapes playback and the stream."/>
                            <Button Grid.Column="1" Classes="tweak-radio" Content="Flat"
                                    Command="{Binding ResetEqualizerCommand}"
                                    ToolTip.Tip="Reset all three bands to flat (bypass)"/>
                        </Grid>
                        <!-- Each fader column is a fixed width so the slider and its label share the
                             same centre. Mouse-wheel over a fader nudges it (behaviors:SliderWheel). -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30" Margin="0,4,0,0">
                            <StackPanel Width="42" Spacing="6">
                                <Slider Classes="eq fader" Orientation="Vertical" Height="104"
                                        HorizontalAlignment="Center" Value="{Binding EqHigh}"
                                        behaviors:SliderWheel.Enabled="True" behaviors:SliderReset.Default="1"/>
                                <TextBlock Classes="tweak-label" Text="HIGH" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Width="42" Spacing="6">
                                <Slider Classes="eq fader" Orientation="Vertical" Height="104"
                                        HorizontalAlignment="Center" Value="{Binding EqMid}"
                                        behaviors:SliderWheel.Enabled="True" behaviors:SliderReset.Default="1"/>
                                <TextBlock Classes="tweak-label" Text="MID" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Width="42" Spacing="6">
                                <Slider Classes="eq fader" Orientation="Vertical" Height="104"
                                        HorizontalAlignment="Center" Value="{Binding EqLow}"
                                        behaviors:SliderWheel.Enabled="True" behaviors:SliderReset.Default="1"/>
                                <TextBlock Classes="tweak-label" Text="LOW" HorizontalAlignment="Center" TextAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- "Revive" rack — anti-flat enhancement for dull/lifeless tracks. Runs after the
                         EQ. Every slider is neutral by default (true bypass): 0 = off.
                         Mouse-wheel nudges (SliderWheel). -->
                    <StackPanel Classes="tweakgroup">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="tweak-label" Text="Revive" VerticalAlignment="Center"
                                       ToolTip.Tip="Brings life back to flat / dull tracks: punch and an auto-balance tilt. All off by default. Shapes playback and the stream."/>
                            <Button Grid.Column="1" Classes="tweak-radio" Content="Off"
                                    Command="{Binding ResetReviveCommand}"
                                    ToolTip.Tip="Reset all revive blocks to neutral (bypass)"/>
                        </Grid>

                        <!-- Transient punch. 0 = off, 1 = max attack lift. -->
                        <Grid ColumnDefinitions="58,*" Margin="0,6,0,0">
                            <TextBlock Classes="tweak-label" Text="PUNCH" FontSize="11" VerticalAlignment="Center"
                                       ToolTip.Tip="Transient designer — boosts attacks (kick/snare snap) to bring punch back to brickwall masters, without making them louder."/>
                            <Slider Grid.Column="1" Classes="fader" Minimum="0" Maximum="1" Value="{Binding TransientPunch}"
                                    behaviors:SliderWheel.Enabled="True" behaviors:SliderReset.Default="0"/>
                        </Grid>

                        <!-- Adaptive spectral tilt (auto-master). 0 = off, 1 = full correction. -->
                        <Grid ColumnDefinitions="58,*">
                            <TextBlock Classes="tweak-label" Text="TILT" FontSize="11" VerticalAlignment="Center"
                                       ToolTip.Tip="Gentle auto-master — slowly nudges each track's bass/treble balance toward an even target so dull or thin tracks sit better. Very subtle (a few dB max)."/>
                            <Slider Grid.Column="1" Classes="fader" Minimum="0" Maximum="1" Value="{Binding AutoTiltStrength}"
                                    behaviors:SliderWheel.Enabled="True" behaviors:SliderReset.Default="0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Limiter / maximizer — LAST in the chain (final true-peak stage). -->
                    <StackPanel Classes="tweakgroup">
                        <TextBlock Classes="tweak-label" Text="Limiter / Maximizer"
                                   ToolTip.Tip="True-peak limiter on the output. Off = bypass. Soft = safety only (−1 dBTP). Club = +3 dB drive. Loud = +6 dB drive AND a hotter −0.1 dBTP ceiling. Applies to playback and the stream."/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="tweak-radio" Content="Off"
                                    Classes.active="{Binding LimiterMode, Converter={StaticResource StringEquals}, ConverterParameter=Off}"
                                    Command="{Binding SetLimiterModeCommand}" CommandParameter="Off"
                                    ToolTip.Tip="Bypassed — raw output, no limiting"/>
                            <Button Classes="tweak-radio" Content="Soft"
                                    Classes.active="{Binding LimiterMode, Converter={StaticResource StringEquals}, ConverterParameter=Soft}"
                                    Command="{Binding SetLimiterModeCommand}" CommandParameter="Soft"
                                    ToolTip.Tip="−1 dBTP safety limiter, no drive — fully transparent"/>
                            <Button Classes="tweak-radio" Content="Club"
                                    Classes.active="{Binding LimiterMode, Converter={StaticResource StringEquals}, ConverterParameter=Club}"
                                    Command="{Binding SetLimiterModeCommand}" CommandParameter="Club"
                                    ToolTip.Tip="−1 dBTP + 3 dB maximizer drive — louder, still clean"/>
                            <Button Classes="tweak-radio" Content="Loud"
                                    Classes.active="{Binding LimiterMode, Converter={StaticResource StringEquals}, ConverterParameter=Loud}"
                                    Command="{Binding SetLimiterModeCommand}" CommandParameter="Loud"
                                    ToolTip.Tip="−0.1 dBTP ceiling + 6 dB maximizer drive — max club loudness"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ════════════ LIBRARY ════════════ -->
                <StackPanel Spacing="10"
                            IsVisible="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Library}">
                    <TextBlock Classes="tweak-section" Text="ANALYSIS"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tweak-label" Text="Auto-analyze on add" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoAnalyze}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tweak-label" Text="Auto-write tags on analyze" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoWriteOnAnalyze}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          ToolTip.Tip="Writes Camelot + Energy into the comment tag (e.g. 8A - Energy 7). Existing text is kept.">
                        <TextBlock Grid.Column="0" Classes="tweak-label" Text="DJ comment tag" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                      IsChecked="{Binding WriteDjComment}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    <StackPanel Classes="tweakgroup" Margin="0,4,0,0">
                        <TextBlock Classes="tweak-label" Text="Analysis threads"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="tweak-radio" Content="1"
                                    Classes.active="{Binding AnalysisThreadsText, Converter={StaticResource StringEquals}, ConverterParameter=1}"
                                    Command="{Binding SetAnalysisThreadsCommand}" CommandParameter="1"/>
                            <Button Classes="tweak-radio" Content="2"
                                    Classes.active="{Binding AnalysisThreadsText, Converter={StaticResource StringEquals}, ConverterParameter=2}"
                                    Command="{Binding SetAnalysisThreadsCommand}" CommandParameter="2"/>
                            <Button Classes="tweak-radio" Content="4"
                                    Classes.active="{Binding AnalysisThreadsText, Converter={StaticResource StringEquals}, ConverterParameter=4}"
                                    Command="{Binding SetAnalysisThreadsCommand}" CommandParameter="4"/>
                            <Button Classes="tweak-radio" Content="8"
                                    Classes.active="{Binding AnalysisThreadsText, Converter={StaticResource StringEquals}, ConverterParameter=8}"
                                    Command="{Binding SetAnalysisThreadsCommand}" CommandParameter="8"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ════════════ AUDIO ════════════ -->
                <StackPanel Spacing="6"
                            IsVisible="{Binding TweaksTab, Converter={StaticResource StringEquals}, ConverterParameter=Audio}">
                    <TextBlock Classes="tweak-section" Text="OUTPUT DEVICE"/>
                    <ComboBox Classes="device-picker"
                              ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioOutputDevice">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#E6FFFFFF"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock FontSize="10" Foreground="#73FFFFFF"
                               Text="No output devices found."
                               IsVisible="{Binding HasNoOutputDevices}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bottom breathing room so the last control clears the transport bar the panel
                     overlays (and a ComboBox popup has room). A scroll-extent spacer inside the
                     StackPanel is always counted, unlike ScrollViewer padding. -->
                <Border Height="32" Background="Transparent"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
