<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.App.ViewModels"
             x:Class="JustPlay.App.Controls.ShuffleRepeatButtons"
             x:DataType="vm:MainWindowViewModel">

    <!--
      Shared shuffle + repeat cluster - used by BOTH MaxView and MiniView (was
      duplicated verbatim in both). Inherits the view's DataContext
      (MainWindowViewModel). Both buttons use the shared Button.iconbtn style
      (App.axaml); .active recolours the glyph to the live accent.

      Shuffle  -> ToggleShuffleCommand,  active when Shuffle is on.
      Repeat   -> CycleRepeatCommand (Off -> All -> One), active when RepeatActive.
                 The squared-up loop fits a centred "1" (Repeat-One) - see the
                 second Path, gated on RepeatOne. Geometry notes: top arrow points
                 right, bottom arrow points left; connectors only cover top-left /
                 bottom-right so the centre stays clear for the "1".
    -->
    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button Classes="iconbtn" ToolTip.Tip="Shuffle"
                Command="{Binding ToggleShuffleCommand}"
                Classes.active="{Binding Shuffle}">
            <Path Width="16" Height="14" Stretch="None" Fill="Transparent"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                  StrokeJoin="Round" StrokeLineCap="Round"
                  Data="M 11,2 L 14,2 L 14,5 M 14,2 L 9,7 M 1,2 L 4,2 L 9,7 L 14,12 M 14,12 L 11,12 M 14,12 L 14,9 M 1,12 L 4,12 L 6,10"/>
        </Button>
        <Button Classes="iconbtn" ToolTip.Tip="Repeat"
                Command="{Binding CycleRepeatCommand}"
                Classes.active="{Binding RepeatActive}">
            <Panel>
                <Path Width="16" Height="16" Stretch="None" Fill="Transparent"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                      StrokeJoin="Round" StrokeLineCap="Round"
                      Data="M 1,6 L 1,3.5 C 1,2.5 1.8,2 2.5,2 L 15,2 L 13,0 M 15,2 L 13,4 M 15,10 L 15,12.5 C 15,13.5 14.2,14 13.5,14 L 1,14 L 3,16 M 1,14 L 3,12"/>
                <Path Width="16" Height="16" Stretch="None" Fill="Transparent"
                      IsVisible="{Binding RepeatOne}"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                      StrokeJoin="Round" StrokeLineCap="Round"
                      Data="M 6.6,6.2 L 8,5 L 8,11 M 6.4,11 L 9.6,11"/>
            </Panel>
        </Button>
    </StackPanel>
</UserControl>
