<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:JustPlay.UI.Controls"
        x:Class="JustPlay.App.Views.InputDialog"
        Title="Name"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <Window.Styles>
        <!-- TextBox styling matching the app's other edit fields (cf. StreamingPanel.stream-field).
             Critically overrides SelectionBrush AND the focused PART_BorderElement: FluentTheme paints
             text selection + the focus border from the Windows SYSTEM accent colour (red on this
             machine), and an inline / plain :focus setter loses to the templated part - so without the
             /template/ override the border stays red. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="CornerRadius" Value="9"/>
            <!-- Optical centering: more top, less bottom (descender-poor text reads too high). -->
            <Setter Property="Padding" Value="10,9,10,6"/>
            <Setter Property="SelectionBrush" Value="#448a5fff"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        </Style>
    </Window.Styles>

    <!--
      Tiny themed text-input dialog (e.g. "name the set folder"). Frameless rounded card like the other
      dialogs; NOT card-draggable so the TextBox stays clickable/selectable. ShowDialog returns the
      entered string (trimmed) or null on Cancel/empty - see InputDialog.AskAsync.
    -->
    <Border Name="DialogCard" ClipToBounds="True"
            BoxShadow="0 18 54 0 #B3000000">
        <Panel>
            <!-- The SHARED surface (JustPlay.UI SurfaceCard) - the ONE thing that makes a dialog
                 read as its own object instead of a second main window (Chloe 2026-08-05/06). The
                 distinction is FLAT vs GRADIENT: windows carry the ramp plus two accent blooms, a
                 dialog carries a flat slab. Gradient and glass were both tried on this surface and
                 both failed for measured reasons - see JustPalette.axaml (banding) and
                 AboutWindow.axaml (window-level blur eats the shadow margin). -->
            <uic:SurfaceCard CornerRadius="14"/>

            <StackPanel Margin="28,26,28,22" Spacing="0">
                <TextBlock x:Name="PromptText" Text="Name" FontSize="14" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBox x:Name="Input" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Classes="dialog-close" Content="Cancel" Click="OnCancel"/>
                    <Button Classes="dialog-close" Content="OK" Click="OnOk"/>
                </StackPanel>
            </StackPanel>
        </Panel>
    </Border>
</Window>
