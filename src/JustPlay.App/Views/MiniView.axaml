<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.App.ViewModels"
             xmlns:controls="using:JustPlay.App.Controls"
             xmlns:ui="using:JustPlay.UI.Controls"
             x:Class="JustPlay.App.Views.MiniView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>

        <!--
          Button.ctrl / Button.primary sizes are NO LONGER overridden here - the shared
          TransportButtons control handles the compact (Mini-view) sizes via its Compact
          property. That avoids these styles bleeding into any future Button.ctrl/primary
          usage outside the transport cluster.
        -->

        <!-- Button.iconbtn / Button.ghost now live in App.axaml (shared by both views). -->
    </UserControl.Styles>

    <Panel Name="Root">
        <DockPanel>

            <!-- Chrome: brand left + square caption buttons right -->
            <Border DockPanel.Dock="Top" Name="ChromeBar" Height="36" Background="Transparent">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- macOS: traffic lights on the far LEFT (suite chrome rule for mac);
                             the brand moves to the CENTER (see end of this grid). -->
                        <ui:WindowControls IsVisible="{x:Static ui:Platform.IsMac}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{x:Static ui:Platform.IsNotMac}">
                            <!-- TRANSPARENT chip - just the enlarged white play glyph (Chloe 2026-06-30). -->
                            <Border Width="18" Height="18" Background="Transparent">
                                <Path Data="M 0,0 L 0,10 L 9,5 Z" Fill="White" Stretch="Uniform" Width="12.5" Height="12.5">
                                    <Path.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
                                    </Path.Effect>
                                </Path>
                            </Border>
                            <TextBlock Text="JUST PLAY" FontSize="10" FontWeight="SemiBold"
                                       LetterSpacing="2" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- macOS: brand CENTERED in the chrome bar (mac title-bar convention). -->
                    <StackPanel Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{x:Static ui:Platform.IsMac}">
                        <Border Width="18" Height="18" Background="Transparent">
                            <Path Data="M 0,0 L 0,10 L 9,5 Z" Fill="White" Stretch="Uniform" Width="12.5" Height="12.5">
                                <Path.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
                                </Path.Effect>
                            </Path>
                        </Border>
                        <TextBlock Text="JUST PLAY" FontSize="10" FontWeight="SemiBold"
                                   LetterSpacing="2" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
                        <!-- Update badge - hidden until a newer release lands (Update.IsAvailable). -->
                        <Button Classes="cap update" Click="OnUpdateBadge"
                                IsVisible="{Binding Update.IsAvailable}"
                                ToolTip.Tip="{Binding Update.Tooltip}">
                            <Path Stretch="Uniform" Width="15" Height="15"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                  Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5 M12 15V3"/>
                        </Button>
                        <!-- Expand back to Max - single big box, centered 14x14 -->
                        <Button Name="ExpandBtn" Classes="cap" Command="{Binding ToggleViewModeCommand}" ToolTip.Tip="Expand to full view">
                            <Path Stretch="None" Width="14" Height="14"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                                  StrokeJoin="Round" Fill="Transparent"
                                  Data="M 1,3 L 13,3 L 13,11 L 1,11 Z"/>
                        </Button>
                    </StackPanel>

                    <!-- Windows caption buttons (right) - on macOS the same control renders the
                         traffic lights on the LEFT instead (see the brand StackPanel above). -->
                    <ui:WindowControls Grid.Column="3" IsVisible="{x:Static ui:Platform.IsNotMac}"/>
                </Grid>
            </Border>

            <!-- Waveform header (compact height) - Playing drives the FFT-based scaleY,
                 BpmHint/EnergyHint drive the beat-pulse opacity layer on top. -->
            <controls:WaveformHeader DockPanel.Dock="Top" Height="60" Margin="0,-2,0,-6"
                                     Opacity="0.85"
                                     Playing="{Binding IsPlaying}"
                                     BpmHint="{Binding Current.Bpm}"
                                     EnergyHint="{Binding Current.Energy}"
                                     IsVisible="{Binding WaveformEnabled}"/>

            <!-- Transport bottom -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="24,4,24,16">
                <!-- Seek bar - shared control (Controls/TransportProgressBar), Compact sizing. -->
                <controls:TransportProgressBar Compact="True"/>
                <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center" Margin="0,4,0,0">
                    <!-- Left: shuffle + repeat - shared control (Controls/ShuffleRepeatButtons). -->
                    <controls:ShuffleRepeatButtons VerticalAlignment="Center"/>
                    <!-- Shared transport cluster, Compact=True for MiniView sizes (54-px play,
                         38-px ctrl). Identical skeu treatment as the MaxView buttons. -->
                    <controls:TransportButtons Grid.Column="1" Compact="True"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <controls:LikeButton/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Center: vinyl + title + meta -->
            <Grid RowDefinitions="*,Auto" Margin="0,4,0,4">
                <!--
                  ClipToBounds=False - Avalonia 12 overrides Viewbox's ClipToBounds default
                  to TRUE (verified in Avalonia.Controls/Viewbox.cs:
                  `ClipToBoundsProperty.OverrideDefaultValue<Viewbox>(true)`). Without this
                  override the Vinyl control's ground shadow, vinyl drop-shadow, and sleeve
                  drop-shadow - all of which extend past the 360-px control height - are
                  clipped flush to the visible disc and the lift-off effect disappears.
                  Unlike Grid/Panel/StackPanel which default to false, Viewbox really does
                  swallow outside-bounds rendering by default.
                -->
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         MaxHeight="300" Margin="20,0" ClipToBounds="False">
                    <controls:Vinyl Cover="{Binding Current.Cover}"
                                    Spinning="{Binding ShouldSpin}"/>
                </Viewbox>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4" Margin="32,8,32,2">
                    <TextBlock Text="{Binding Current.Title, FallbackValue='Drop a track'}"
                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TitleGradient}"
                               TextTrimming="CharacterEllipsis" MaxWidth="540"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding Current.Artist}" FontWeight="SemiBold"
                                   FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="-" Foreground="#66FFFFFF" VerticalAlignment="Center"
                                   IsVisible="{Binding Current.BpmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding Current.BpmText, StringFormat='{}{0} bpm'}"
                                   FontSize="11" Foreground="#A6FFFFFF" VerticalAlignment="Center"
                                   IsVisible="{Binding Current.BpmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="-" Foreground="#66FFFFFF" VerticalAlignment="Center"
                                   IsVisible="{Binding Current.KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <!-- Same key badge as the pre-cue finder / max view: shared wheel palette. -->
                        <Border CornerRadius="9" Padding="6,2" BorderThickness="1"
                                Background="{Binding Current.KeyText, Converter={StaticResource CamelotWheelBrush}, ConverterParameter=2E}"
                                BorderBrush="{Binding Current.KeyText, Converter={StaticResource CamelotWheelBrush}}"
                                IsVisible="{Binding Current.KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Current.KeyText}" FontSize="10" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

    </Panel>
</UserControl>
