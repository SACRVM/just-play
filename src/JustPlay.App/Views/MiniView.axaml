<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.App.ViewModels"
             xmlns:controls="using:JustPlay.App.Controls"
             x:Class="JustPlay.App.Views.MiniView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>

        <!--
          Button.ctrl / Button.primary sizes are NO LONGER overridden here — the shared
          TransportButtons control handles the compact (Mini-view) sizes via its Compact
          property. That avoids these styles bleeding into any future Button.ctrl/primary
          usage outside the transport cluster.
        -->

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Foreground" Value="#A6FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.iconbtn">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.iconbtn:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Panel Name="Root">
        <DockPanel>

            <!-- Chrome: brand left + square caption buttons right -->
            <Border DockPanel.Dock="Top" Name="ChromeBar" Height="36" Background="Transparent">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource AccentGradient}">
                            <Path Data="M 0,0 L 0,10 L 9,5 Z" Fill="White" Stretch="Uniform" Width="7" Height="7"/>
                        </Border>
                        <TextBlock Text="JUST PLAY" FontSize="10" FontWeight="SemiBold"
                                   LetterSpacing="2" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
                        <!-- Expand back to Max — single big box, centered 14×14 -->
                        <Button Classes="cap" Command="{Binding ToggleViewModeCommand}" ToolTip.Tip="Expand">
                            <Path Stretch="None" Width="14" Height="14"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                                  StrokeJoin="Round" Fill="Transparent"
                                  Data="M 1,3 L 13,3 L 13,11 L 1,11 Z"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
                        <Button Classes="cap" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                            <Path Stretch="None" Width="10" Height="1"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                                  Data="M 0,0 L 10,0"/>
                        </Button>
                        <Button Classes="cap" Click="OnMaximizeClick" ToolTip.Tip="Maximize">
                            <Path Stretch="None" Width="10" Height="10"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Fill="Transparent"
                                  Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
                        </Button>
                        <Button Classes="cap close" Click="OnCloseClick" ToolTip.Tip="Close">
                            <Path Stretch="None" Width="10" Height="10"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Waveform header (compact height) -->
            <controls:WaveformHeader DockPanel.Dock="Top" Height="60" Margin="0,-2,0,-6"
                                     Opacity="0.85"
                                     IsVisible="{Binding WaveformEnabled}"/>

            <!-- Transport bottom -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="22,4,22,16">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionText}" Foreground="#A6FFFFFF" FontSize="10"
                               MinWidth="32" TextAlignment="Right" VerticalAlignment="Center"/>
                    <controls:SkeuSlider Grid.Column="1" Margin="8,0" Minimum="0"
                                         Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"
                                         VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#A6FFFFFF"
                               FontSize="10" MinWidth="32" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="iconbtn" ToolTip.Tip="Shuffle">
                            <Path Width="16" Height="14" Stretch="None" Fill="Transparent"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeJoin="Round" StrokeLineCap="Round"
                                  Data="M 11,2 L 14,2 L 14,5 M 14,2 L 9,7 M 1,2 L 4,2 L 9,7 L 14,12 M 14,12 L 11,12 M 14,12 L 14,9 M 1,12 L 4,12 L 6,10"/>
                        </Button>
                        <Button Classes="iconbtn" ToolTip.Tip="Repeat">
                            <Path Width="16" Height="14" Stretch="None" Fill="Transparent"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeJoin="Round" StrokeLineCap="Round"
                                  Data="M 1,5 L 1,3.5 C 1,2.5 1.8,2 2.5,2 L 13,2 L 11,0 M 13,2 L 11,4 M 15,9 L 15,10.5 C 15,11.5 14.2,12 13.5,12 L 3,12 L 5,14 M 3,12 L 5,10"/>
                        </Button>
                    </StackPanel>
                    <!-- Shared transport cluster, Compact=True for MiniView sizes (54-px play,
                         38-px ctrl). Identical skeu treatment as the MaxView buttons. -->
                    <controls:TransportButtons Grid.Column="1" Compact="True"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Classes="iconbtn" ToolTip.Tip="Like">
                            <Path Width="16" Height="14" Stretch="None" Fill="Transparent"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeJoin="Round"
                                  Data="M 8,13 C 5,10 1,7 1,4 C 1,1 4,0 6,2 L 8,4 L 10,2 C 12,0 15,1 15,4 C 15,7 11,10 8,13 Z"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Center: vinyl + title + meta -->
            <Grid RowDefinitions="*,Auto" Margin="0,4,0,4">
                <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly"
                         MaxHeight="300" Margin="20,0">
                    <controls:Vinyl Cover="{Binding Current.Cover}"
                                    Spinning="{Binding ShouldSpin}"/>
                </Viewbox>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4" Margin="20,8,20,2">
                    <TextBlock Text="{Binding Current.Title, FallbackValue='Drop a track'}"
                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TitleGradient}"
                               TextTrimming="CharacterEllipsis" MaxWidth="540"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding Current.Artist}" FontWeight="SemiBold"
                                   FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="·" Foreground="#66FFFFFF" VerticalAlignment="Center"
                                   IsVisible="{Binding Current.BpmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding Current.BpmText, StringFormat='{}{0} bpm'}"
                                   FontSize="11" Foreground="#A6FFFFFF" VerticalAlignment="Center"
                                   IsVisible="{Binding Current.BpmText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="·" Foreground="#66FFFFFF" VerticalAlignment="Center"
                                   IsVisible="{Binding Current.KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <Border CornerRadius="9" Padding="6,2" BorderThickness="1"
                                Background="{Binding Current.KeyText, Converter={StaticResource CamelotToBrush}}"
                                BorderBrush="{Binding Current.KeyText, Converter={StaticResource CamelotBorder}}"
                                IsVisible="{Binding Current.KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Current.KeyText}" FontSize="10" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>

    </Panel>
</UserControl>
