<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JustPlay.App.Views.AboutWindow"
        Title="About JustPlay"
        Width="384" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      Themed "About" dialog. Renders in the active palette by consuming the same
      DynamicResource keys the main window uses (BgLinear/BgGlowA/BgGlowB for the
      Aurora-style background, AccentGradient/TitleGradient for the brand mark and
      name) — so it follows live theme switches with no extra wiring. Chrome is the
      app's frameless style (WindowDecorations=None + rounded card + shadow margin).
      Version text is filled from AppInfo in code-behind.
    -->
    <!-- Outer card: rounded + drop shadow blooming into the transparent margin.
         (The Button.dialog-close style now lives in App.axaml, shared with the other dialogs.) -->
    <Border CornerRadius="16" Margin="14" ClipToBounds="True"
            BoxShadow="0 18 54 0 #B3000000"
            PointerPressed="OnCardPressed">
        <Panel>
            <!-- Themed background layers (same recipe as MainWindow). -->
            <Rectangle Fill="{DynamicResource BgLinear}" RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowA}"   RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowB}"   RadiusX="16" RadiusY="16"/>
            <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16"/>

            <!-- Close (×) in the rounded top-right corner. -->
            <Button Classes="cap close" Click="OnCloseClick" ToolTip.Tip="Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- Foreground inherited from the cap button (white on hover) via TextElement. -->
                <TextBlock Text="✕" FontSize="13"/>
            </Button>

            <StackPanel Margin="30,34,30,28" Spacing="0" HorizontalAlignment="Center">
                <!-- Brand mark: cyan→pink chip + white play glyph + pink glow (mirrors
                     ThemedWindowIcon / the in-app brand chip). -->
                <Border Width="74" Height="74" CornerRadius="19"
                        Background="{DynamicResource AccentGradient}"
                        HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentB}" BlurRadius="26"
                                          OffsetX="0" OffsetY="6" Opacity="0.55"/>
                    </Border.Effect>
                    <!-- Brand glyph, with two deliberate tweaks over a naive centre:
                         • DropShadowEffect — the play triangle carries the same soft shadow as the
                           in-app icons (cf. ThemedWindowIcon); without it the glyph looked flat.
                         • RenderTransform nudge right — a play triangle is bounding-box centred but
                           its visual mass sits LEFT of centre, so on this big chip it read as shifted
                           left; a ~3px right translate optically centres it. (Pure translate, so the
                           RenderTransformOrigin=Center caveat in CLAUDE.md doesn't apply.) -->
                    <Path Data="M 0,0 L 0,10 L 9,5 Z" Fill="White" Stretch="Uniform"
                          Width="28" Height="28"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <TranslateTransform X="3"/>
                        </Path.RenderTransform>
                        <Path.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="3" OffsetX="0" OffsetY="1.5" Opacity="0.5"/>
                        </Path.Effect>
                    </Path>
                </Border>

                <!-- Name (gradient) + tagline. -->
                <TextBlock Text="JustPlay" FontSize="31" FontWeight="Bold"
                           Foreground="{DynamicResource TitleGradient}"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="Key-aware DJ music player" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>

                <!-- Version (set from AppInfo in code-behind). -->
                <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold"
                           LetterSpacing="0.5"
                           Foreground="{DynamicResource MutedDimBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>

                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,20"/>

                <!-- Suite brand: J.U.S.T. = "Just Useful Sound Tools" (see brand memory). -->
                <TextBlock Text="Part of J.U.S.T. — Just Useful Sound Tools" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="by Chloe Dream" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="© 2026 Chloe Dream" FontSize="11"
                           Foreground="{DynamicResource MutedDimBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>

                <Button Classes="dialog-close" Content="Close" Click="OnCloseClick"
                        Margin="0,24,0,0"/>
            </StackPanel>
        </Panel>
    </Border>
</Window>
