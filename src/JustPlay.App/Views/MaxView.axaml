<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.App.ViewModels"
             xmlns:controls="using:JustPlay.App.Controls"
             x:Class="JustPlay.App.Views.MaxView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- Queue rows -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!--
          Row hover / selected backgrounds — 1:1 port of the design's QueueRow brush
          (.design/just-play-music-player/project/app.jsx, function QueueRow line ~154):

              active : linear-gradient(90deg, accentC·0.133, accentB·0.063 @60%, transparent)
              hover  : rgba(255,255,255,.04)         // a FLAT colour, not a gradient
              base   : transparent

          Aurora theme: accentC = #8a5fff (purple), accentB = #ff5fae (pink). Alpha
          conversions for Avalonia's ARGB hex: 0.133 → 0x22, 0.063 → 0x10, 0.04 → 0x0A.

          IMPORTANT — % suffix on the points is mandatory: Avalonia 12 parses bare "1,0"
          as ABSOLUTE PIXELS (RelativeUnit.Absolute), which collapses the gradient to a
          1-pixel-wide strip at the left edge of the row. "100%,50%" forces Relative mode
          so the gradient actually spans the whole row width.
        -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <!-- Design hover: flat rgba(255,255,255,.04). NOT a gradient. -->
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="#228a5fff"/>  <!-- AccentC purple, α .133 -->
                    <GradientStop Offset="0.6" Color="#10ff5fae"/>  <!-- AccentB pink,   α .063 -->
                    <GradientStop Offset="1"   Color="#00000000"/>  <!-- transparent -->
                </LinearGradientBrush>
            </Setter>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <!--
          Hover OVER an already-selected row: keep the Aurora swipe but lift it slightly
          so the user gets feedback they're pointing at the current track. Composed by
          letting :selected win the brush (the gradient) and only tweaking opacity-ish
          weight via a brighter purple stop — still well below the row text.
        -->
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="#338a5fff"/>  <!-- purple α .20 -->
                    <GradientStop Offset="0.6" Color="#1Aff5fae"/>  <!-- pink   α .10 -->
                    <GradientStop Offset="1"   Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>


        <!-- Button.primary + Button.ctrl now live in App.axaml (full skeu ControlTemplates) -->


        <!-- Small ghost icon buttons (chrome + transport secondaries). -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#A6FFFFFF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Square 32x32 icon button for transport secondaries (shuffle/repeat/like/more). Consistent hit area. -->
        <Style Selector="Button.iconbtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.iconbtn:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="TextBlock.colhead">
            <Setter Property="Foreground" Value="#73FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="2"/>
        </Style>

        <!-- Tabs: NO frame, NO hover background, underline as a Border INSIDE the Content so it
             only spans the text width (not the full button width incl. padding). -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2,10,14,10"/>
            <Setter Property="Foreground" Value="#73FFFFFF"/>
        </Style>
        <Style Selector="Button.tab /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.tabline">
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.tab.active Border.tabline">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        </Style>

        <!--
          Queue scrollbar — FULL CUSTOM TEMPLATE (FluentTheme overrides via `/template/`
          selectors were not winning reliably; the dark track background, square thumb
          and template setters all slipped through). With our own ControlTemplate we
          own the entire visual tree end-to-end:

          • Root Grid: transparent — no painted background, no track strip.
          • Track: standard Avalonia primitive, scrollbar logic intact.
          • DecreaseButton / IncreaseButton (page-up/-down click area inside the track):
            full-opacity-0 RepeatButtons. Still clickable to page-scroll, just invisible.
          • Thumb: has its OWN inline ControlTemplate — a single Border with CornerRadius=3
            (= half-width on a 6-px bar = perfect pill, rounded top AND bottom).
          • NO line buttons (the top/bottom chevrons) at all — we just don't put them in
            the template, so they can't appear.
          • Bar floats at the right edge of the list area (NO horizontal Margin) — the
            visual gap between scrollbar and content comes from the row Grid's right
            margin (see the ListBox DataTemplate).
        -->
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <!-- Top+bottom inset only — keeps the pill caps from butting into the panel
                 edges. NO right inset: the bar lives flush at the right (which is what
                 you actually want — moving it inward shrinks the gap to content). -->
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent">
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               IsDirectionReversed="True"
                               Orientation="Vertical">
                            <Track.DecreaseButton>
                                <RepeatButton Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              Opacity="0"/>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              Opacity="0"/>
                            </Track.IncreaseButton>
                            <Track.Thumb>
                                <Thumb MinHeight="32" Background="#80FFFFFF">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Hover / press states act on the Thumb directly (inside the new template). -->
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#BFFFFFFF"/>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
            <Setter Property="Background" Value="#E6FFFFFF"/>
        </Style>

        <!-- Now-playing 3-bar indicator: each bar pulses independently. -->
        <Style Selector="Rectangle.pbar">
            <Setter Property="Width" Value="2.5"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Fill" Value="{StaticResource AccentABrush}"/>
        </Style>
        <Style Selector="Rectangle.pbar1">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="3"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="11"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.pbar2">
            <Style.Animations>
                <Animation Duration="0:0:0.5" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="9"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="4"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Rectangle.pbar3">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Height" Value="4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Height" Value="10"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Tweaks-panel section heading -->
        <Style Selector="TextBlock.tweak-section">
            <Setter Property="Foreground" Value="#73FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="3"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style Selector="TextBlock.tweak-label">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Palette swatch (chip) — gets a coloured ring + accent glow when active. -->
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.swatch.active">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="White" BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.6"/>
            </Setter>
        </Style>

        <Style Selector="Button.tweak-radio">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.tweak-radio.active">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <DockPanel>

            <!-- ─── CHROME / TITLE BAR (frameless; brand left, square caption buttons right) ── -->
            <Border DockPanel.Dock="Top" Height="36" Name="ChromeBar" Background="Transparent">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                    <!-- Brand -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="20" Height="20" CornerRadius="5"
                                Background="{StaticResource AccentGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#ff5fae" BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="0.45"/>
                            </Border.Effect>
                            <Path Data="M 0,0 L 0,10 L 9,5 Z" Fill="White" Stretch="Uniform" Width="8" Height="8"/>
                        </Border>
                        <TextBlock Text="JUST PLAY" FontSize="11" FontWeight="SemiBold"
                                   LetterSpacing="2" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center breadcrumb -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding Current.Model.Metadata.Album, FallbackValue=''}"
                                   FontSize="11" FontWeight="Bold" LetterSpacing="2"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="·" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Current.Artist}" FontSize="11"
                                   Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="·" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Current.Model.Metadata.Year, FallbackValue=''}"
                                   FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- App icon buttons (square, same style as window controls — keeps the chrome consistent) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
                        <!-- Search: magnifying glass, 14×14 hand-positioned for centering -->
                        <Button Classes="cap" ToolTip.Tip="Search">
                            <Path Stretch="None" Width="14" Height="14"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                                  StrokeLineCap="Round" Fill="Transparent"
                                  Data="M 5,5 m -4,0 a 4,4 0 1 0 8,0 a 4,4 0 1 0 -8,0 M 8,8 L 13,13"/>
                        </Button>
                        <!-- Mini player: small rect inside rect, perfectly centered in 14×14 -->
                        <Button Classes="cap" Command="{Binding ToggleViewModeCommand}" ToolTip.Tip="Mini player">
                            <Path Stretch="None" Width="14" Height="14"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                                  StrokeJoin="Round" Fill="Transparent"
                                  Data="M 1,4 L 13,4 L 13,10 L 1,10 Z M 5,6 L 9,6 L 9,8 L 5,8 Z"/>
                        </Button>
                        <!-- Settings: gear (same path firepit-ai uses) -->
                        <Button Classes="cap" Command="{Binding ToggleTweaksCommand}" ToolTip.Tip="Tweaks">
                            <Path Stretch="Uniform" Width="14" Height="14"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                                  StrokeJoin="Round" Fill="Transparent"
                                  Data="M 7,0 L 9,0 L 9.5,2 L 11.5,2.5 L 13,1.3 L 14.7,3 L 13.5,4.5 L 14,6.5 L 16,7 L 16,9 L 14,9.5 L 13.5,11.5 L 14.7,13 L 13,14.7 L 11.5,13.5 L 9.5,14 L 9,16 L 7,16 L 6.5,14 L 4.5,13.5 L 3,14.7 L 1.3,13 L 2.5,11.5 L 2,9.5 L 0,9 L 0,7 L 2,6.5 L 2.5,4.5 L 1.3,3 L 3,1.3 L 4.5,2.5 L 6.5,2 Z M 8,5.5 A 2.5,2.5 0 1 0 8,10.5 A 2.5,2.5 0 1 0 8,5.5 Z"/>
                        </Button>
                    </StackPanel>

                    <!-- Windows window controls (square, Path icons, Close goes red on hover) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="0" VerticalAlignment="Top">
                        <Button Classes="cap" Click="OnMinimizeClick" ToolTip.Tip="Minimize">
                            <Path Stretch="None" Width="10" Height="1"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                                  Data="M 0,0 L 10,0"/>
                        </Button>
                        <Button Classes="cap" Click="OnMaximizeClick" ToolTip.Tip="Maximize">
                            <Path Stretch="None" Width="10" Height="10"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" Fill="Transparent"
                                  Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
                        </Button>
                        <Button Classes="cap close" Click="OnCloseClick" ToolTip.Tip="Close">
                            <Path Stretch="None" Width="10" Height="10"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                                  Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── WAVEFORM HEADER ────────────────────────────────────────── -->
            <!-- Playing drives the FFT-based scaleY; BpmHint/EnergyHint drive the
                 beat-pulse opacity layer on top; IsVisible from the Tweaks toggle. -->
            <controls:WaveformHeader DockPanel.Dock="Top" Height="90" Margin="0,-4,0,-10"
                                     Opacity="0.9"
                                     Playing="{Binding IsPlaying}"
                                     BpmHint="{Binding Current.Bpm}"
                                     EnergyHint="{Binding Current.Energy}"
                                     IsVisible="{Binding WaveformEnabled}"/>

            <!-- ─── TRANSPORT (bottom) ─────────────────────────────────────── -->
            <Border DockPanel.Dock="Bottom" Padding="32,8,32,16">
                <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">

                    <!-- Left: shuffle + repeat — Path icons, 14×14, ghost-styled (consistent square hit area) -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="iconbtn" ToolTip.Tip="Shuffle">
                            <Path Width="16" Height="14" Stretch="None" Fill="Transparent"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeJoin="Round" StrokeLineCap="Round"
                                  Data="M 11,2 L 14,2 L 14,5 M 14,2 L 9,7 M 1,2 L 4,2 L 9,7 L 14,12 M 14,12 L 11,12 M 14,12 L 14,9 M 1,12 L 4,12 L 6,10"/>
                        </Button>
                        <Button Classes="iconbtn" ToolTip.Tip="Repeat">
                            <Path Width="16" Height="14" Stretch="None" Fill="Transparent"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeJoin="Round" StrokeLineCap="Round"
                                  Data="M 1,5 L 1,3.5 C 1,2.5 1.8,2 2.5,2 L 13,2 L 11,0 M 13,2 L 11,4 M 15,9 L 15,10.5 C 15,11.5 14.2,12 13.5,12 L 3,12 L 5,14 M 3,12 L 5,10"/>
                        </Button>
                    </StackPanel>

                    <!--
                      Play has a separate Ellipse BEHIND it as its halo (BoxShadow was rendering
                      as a rectangle because of how Avalonia clips it to layout bounds).
                      The Ellipse is 200×200 (much bigger than the 70-px button), centred over it,
                      IsHitTestVisible=False so clicks pass through to the button.
                      ClipToBounds=False all the way up so the halo actually shows.
                    -->
                    <!--
                      Two-layer Grid: halo Ellipse below (centred), buttons StackPanel above.
                      Both HorizontalAlignment=Center → the halo's centre automatically lines up
                      with the play button (the middle one in the StackPanel). The halo can be
                      ANY size — it sits in the same layout box as the buttons, ClipToBounds=False.
                    -->
                    <!-- Transport cluster is a SHARED control (Controls/TransportButtons.axaml)
                         used by both MaxView and MiniView. All the polish (skeu Template, halo
                         BoxShadow, hover glow, RenderTransformOrigin pivot, centred scale) lives
                         in App.axaml on Button.ctrl / Button.primary — both views inherit it. -->
                    <controls:TransportButtons Grid.Column="1"/>

                    <!-- Right: volume / heart / more — uniform Spacing so the divider is centred
                         between the slider and the heart (no per-element Margins to break symmetry). -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Width="14" Height="12" Stretch="None"
                              Fill="#A6FFFFFF" VerticalAlignment="Center"
                              Data="M 0,4 L 3,4 L 7,1 L 7,11 L 3,8 L 0,8 Z M 9,3 C 11,4 11,8 9,9 M 11,1 C 14,3 14,9 11,11"/>
                        <controls:SkeuSlider Width="100" Minimum="0" Maximum="1" Value="{Binding Volume}"
                                             IsChrome="True"
                                             VerticalAlignment="Center"/>
                        <Border Width="1" Height="18" Background="#1FFFFFFF"/>
                        <Button Classes="iconbtn" ToolTip.Tip="Like">
                            <Path Width="16" Height="14" Stretch="None" Fill="Transparent"
                                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeJoin="Round"
                                  Data="M 8,13 C 5,10 1,7 1,4 C 1,1 4,0 6,2 L 8,4 L 10,2 C 12,0 15,1 15,4 C 15,7 11,10 8,13 Z"/>
                        </Button>
                        <Button Classes="iconbtn" ToolTip.Tip="More">
                            <Path Width="14" Height="4" Stretch="None"
                                  Fill="{Binding $parent[Button].Foreground}"
                                  Data="M 1,2 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0 M 7,2 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0 M 13,2 m -1.5,0 a 1.5,1.5 0 1 0 3,0 a 1.5,1.5 0 1 0 -3,0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── PROGRESS BAR ───────────────────────────────────────────── -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="38,8,38,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding PositionText}" Foreground="#A6FFFFFF" FontSize="12"
                           VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"/>
                <controls:SkeuSlider Grid.Column="1" Margin="12,0" Minimum="0"
                                     Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"
                                     VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#A6FFFFFF" FontSize="12"
                           VerticalAlignment="Center" MinWidth="42" TextAlignment="Left" />
            </Grid>

            <!-- ─── MAIN CONTENT: 2-column ─────────────────────────────────── -->
            <Grid ColumnDefinitions="*,1.05*" Margin="44,8,44,12">

                <!-- LEFT: vinyl stage -->
                <Panel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:Vinyl Cover="{Binding Current.Cover}"
                                    Spinning="{Binding ShouldSpin}"/>
                </Panel>

                <!-- RIGHT: track meta + queue/lyrics -->
                <DockPanel Grid.Column="1" Margin="20,4,0,0">

                    <!-- Title + meta block. "NOW PLAYING · TRACK n" appears when a track is current. -->
                    <StackPanel DockPanel.Dock="Top" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="NOW PLAYING" Foreground="#80FFFFFF"
                                       FontSize="10" FontWeight="SemiBold" LetterSpacing="3"/>
                            <TextBlock Text="·" Foreground="#59FFFFFF" FontSize="10" VerticalAlignment="Center"
                                       IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <TextBlock Text="{Binding Current.Index, StringFormat='TRACK {0}'}"
                                       Foreground="#80FFFFFF" FontSize="10" FontWeight="SemiBold" LetterSpacing="3"
                                       IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Current.Title, FallbackValue='Drop a track to begin'}"
                                   FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource TitleGradient}"
                                   TextTrimming="CharacterEllipsis"/>
                        <!-- Just artist + album text under the title — no duplicate cover thumb;
                             the sleeve carries the real cover (or its themed fallback). -->
                        <StackPanel Spacing="2"
                                    IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Current.Artist}" FontWeight="SemiBold"
                                       FontSize="14" Foreground="White"/>
                            <TextBlock Text="{Binding Current.Model.Metadata.Album, FallbackValue=''}"
                                       FontSize="11" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tab strip: UP NEXT / LYRICS — underline lives inside the Content StackPanel
                         so its width = text width, not the whole button. -->
                    <Border DockPanel.Dock="Top" Margin="0,18,0,8"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Classes="tab active" Click="OnUpNextTabClick" Name="UpNextTab">
                                <StackPanel>
                                    <TextBlock Text="UP NEXT" FontSize="12" FontWeight="Bold" LetterSpacing="2"/>
                                    <Border Classes="tabline"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="tab" Click="OnLyricsTabClick" Name="LyricsTab">
                                <StackPanel>
                                    <TextBlock Text="LYRICS" FontSize="12" FontWeight="Bold" LetterSpacing="2"/>
                                    <Border Classes="tabline"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Queue header row + hairline divider. No bottom margin so the list sits
                         flush under the header (content scrolls right up to the hairline). -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                            Padding="0,0,0,6" Margin="0,2,0,0"
                            IsVisible="{Binding HasTracks}">
                        <!--
                          Columns mirror the row template exactly: 7 cols, Genre slot between
                          Title and BPM. Widths: # 28, Title *, GENRE 100, BPM 44, KEY 52,
                          NRG 44, Duration 52 (BPM and NRG both 44, per spec).

                          Right margin = 22 = 16 (content↔scrollbar gap, matches row Grid's 16)
                          + 6 (the scrollbar's own width) — so header column right-edges line up
                          with row column right-edges even though the bar only consumes width
                          inside the ListBox.

                          "#" centred (matches row index); "UP NEXT" gets 4-px left margin so it
                          sits flush above the Title text (row StackPanel also has Margin="4,0,…").
                        -->
                        <Grid ColumnDefinitions="28,*,100,44,52,44,52" Margin="6,0,16,0">
                            <TextBlock Classes="colhead" Text="#"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock Classes="colhead" Text="UP NEXT"/>
                                <TextBlock FontSize="10" Foreground="#40FFFFFF" Text="·" VerticalAlignment="Center"/>
                                <TextBlock FontSize="10" FontWeight="SemiBold" LetterSpacing="2"
                                           Foreground="#73FFFFFF" Text="{Binding TrackCountText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="colhead" Text="GENRE" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Classes="colhead" Text="BPM" TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Classes="colhead" Text="KEY" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Classes="colhead" Text="NRG" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Classes="colhead" Text="{Binding TotalDurationText}"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Queue / lyrics swap (lyrics is placeholder for now) -->
                    <Panel Name="RightPanelHost">
                        <Panel Name="QueuePanel">
                            <!--
                              NOTE: previously had a <ListBox.OpacityMask> here for the soft bottom
                              fade into the transport area. In Avalonia 12.0.3 that interacts badly
                              with the virtualising panel: items get added to ItemsSource but the mask
                              composites the whole list to transparent. The fade will be re-added later
                              as a separate Rectangle overlay below the list — for now: no mask, list
                              renders normally.
                            -->
                            <ListBox Name="TrackList" ItemsSource="{Binding Tracks}" SelectionMode="Single"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     DoubleTapped="OnTrackDoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrackViewModel">
                                        <!-- Row margin right = 16 → that's the visible gap between the
                                             last column (Duration) and the scrollbar at the right edge.
                                             Header has matching margin (+6 for scrollbar width) so column
                                             right-edges line up. -->
                                        <Grid ColumnDefinitions="28,*,100,44,52,44,52" Margin="6,0,16,0" MinHeight="44">

                                            <!--
                                              Cyan→pink accent edge on the left of the active row.

                                              Margin left = -8 → sits at ListBoxItem x=-2 (the row Grid has
                                              Margin=6 left so -8 = -6 + -2). That's the "kante sitzt außen" look.

                                              Spans the FULL row height (Margin top/bottom = 0). The design's
                                              4/4 inset was carried over from earlier iterations; it left the
                                              bar visibly shorter than the row and read as a stub. Going edge-
                                              to-edge gives the bar the proper "now-playing rail" presence.

                                              Gradient is VERTICAL (cyan TOP → pink BOTTOM) — direct port of
                                              the design's `linear-gradient(to bottom, accentA, accentB)`.
                                              The shared AccentGradient resource is diagonal (0%,0% → 100%,100%)
                                              which on a 3-px-wide rail just reads as muddy violet; the vertical
                                              gradient actually shows the cyan→pink range.

                                              Pink BoxShadow halo around the bar — port of the design's
                                              `boxShadow: 0 0 6px ${accentB}` so the active row pulses with
                                              accent light, not just colour.
                                            -->
                                            <Border Width="3" CornerRadius="1.5"
                                                    HorizontalAlignment="Left" Margin="-8,0,0,0"
                                                    Grid.ColumnSpan="7"
                                                    IsVisible="{Binding IsCurrent}"
                                                    BoxShadow="0 0 6 0 #FFff5fae">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                        <GradientStop Offset="0" Color="{StaticResource AccentA}"/>  <!-- cyan top -->
                                                        <GradientStop Offset="1" Color="{StaticResource AccentB}"/>  <!-- pink bottom -->
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- # / animated 3-bar indicator for the current track -->
                                            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#73FFFFFF"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsCurrent}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Bottom" Height="14"
                                                            IsVisible="{Binding IsCurrent}">
                                                    <Rectangle Classes="pbar pbar1"/>
                                                    <Rectangle Classes="pbar pbar2"/>
                                                    <Rectangle Classes="pbar pbar3"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Title + artist -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" FontSize="11"
                                                           Foreground="#73FFFFFF" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- GENRE (from MP3 tag, may be empty — column simply renders blank then) -->
                                            <TextBlock Grid.Column="2" Text="{Binding Model.Metadata.Genre, FallbackValue=''}"
                                                       FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                            <!-- BPM -->
                                            <TextBlock Grid.Column="3" Text="{Binding BpmText}"
                                                       FontSize="12" Foreground="#B3FFFFFF"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>

                                            <!-- KEY pill -->
                                            <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    CornerRadius="10" Padding="7,3" BorderThickness="1"
                                                    Background="{Binding KeyText, Converter={StaticResource CamelotToBrush}}"
                                                    BorderBrush="{Binding KeyText, Converter={StaticResource CamelotBorder}}"
                                                    IsVisible="{Binding KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding KeyText}" FontSize="10" FontWeight="Bold"
                                                           LetterSpacing="0.5" Foreground="White"/>
                                            </Border>

                                            <!-- ENERGY bars -->
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        IsVisible="{Binding Energy, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Rectangle Width="2.5" Height="4" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                                                           Fill="{Binding Energy, Converter={StaticResource EnergyBarColor}, ConverterParameter=0}"/>
                                                <Rectangle Width="2.5" Height="6" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                                                           Fill="{Binding Energy, Converter={StaticResource EnergyBarColor}, ConverterParameter=1}"/>
                                                <Rectangle Width="2.5" Height="8" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                                                           Fill="{Binding Energy, Converter={StaticResource EnergyBarColor}, ConverterParameter=2}"/>
                                                <Rectangle Width="2.5" Height="10" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                                                           Fill="{Binding Energy, Converter={StaticResource EnergyBarColor}, ConverterParameter=3}"/>
                                                <Rectangle Width="2.5" Height="12" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom"
                                                           Fill="{Binding Energy, Converter={StaticResource EnergyBarColor}, ConverterParameter=4}"/>
                                                <TextBlock Text="{Binding EnergyText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#A6FFFFFF" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- DURATION -->
                                            <TextBlock Grid.Column="6" Text="{Binding DurationText}"
                                                       FontSize="12" Foreground="#B3FFFFFF"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty drop hint -->
                            <StackPanel IsVisible="{Binding !HasTracks}" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="⤓" FontSize="56" HorizontalAlignment="Center" Foreground="#33FFFFFF"/>
                                <TextBlock Text="Drop tracks anywhere" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="#A6FFFFFF"/>
                                <TextBlock Text="no library · no memory · just play" FontSize="11"
                                           HorizontalAlignment="Center" Foreground="#59FFFFFF" LetterSpacing="1"/>
                            </StackPanel>
                        </Panel>

                        <!-- Lyrics placeholder (visible when LYRICS tab is selected) -->
                        <StackPanel Name="LyricsPanel" IsVisible="False" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="♪" FontSize="56" HorizontalAlignment="Center" Foreground="#33FFFFFF"/>
                            <TextBlock Text="Lyrics" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="#A6FFFFFF"/>
                            <TextBlock Text="Coming with synced-lyrics support" FontSize="11"
                                       HorizontalAlignment="Center" Foreground="#59FFFFFF" LetterSpacing="1"/>
                        </StackPanel>
                    </Panel>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!--
          TWEAKS PANEL — slides in from the right when ToggleTweaksCommand is invoked.
          Mirrors the design's tweaks-panel.jsx: Theme palette · Stage toggles · Right-panel default.
          Backed by IsTweaksOpen / CurrentTheme / VinylSpinEnabled / WaveformEnabled / DefaultTab in the VM.
        -->
        <Border IsVisible="{Binding IsTweaksOpen}"
                Width="300" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Background="#F01a1828"
                CornerRadius="14,0,0,14"
                BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0">
            <ScrollViewer Padding="22,18,22,18">
                <StackPanel Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="TWEAKS" FontSize="12" FontWeight="Bold" LetterSpacing="3"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="ghost" Content="✕" FontSize="13"
                                Command="{Binding ToggleTweaksCommand}"/>
                    </Grid>

                    <TextBlock Classes="tweak-section" Text="THEME"/>
                    <TextBlock Classes="tweak-label" Text="Palette"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Command="{Binding SetThemeCommand}" CommandParameter="Aurora">
                            <Border Classes="swatch" Background="{StaticResource SwatchAurora}"
                                    Classes.active="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Aurora}"/>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Command="{Binding SetThemeCommand}" CommandParameter="Sunset">
                            <Border Classes="swatch" Background="{StaticResource SwatchSunset}"
                                    Classes.active="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Sunset}"/>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Command="{Binding SetThemeCommand}" CommandParameter="Midnight">
                            <Border Classes="swatch" Background="{StaticResource SwatchMidnight}"
                                    Classes.active="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Midnight}"/>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Command="{Binding SetThemeCommand}" CommandParameter="Neon">
                            <Border Classes="swatch" Background="{StaticResource SwatchNeon}"
                                    Classes.active="{Binding CurrentTheme, Converter={StaticResource StringEquals}, ConverterParameter=Neon}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentTheme}" FontSize="10"
                               Foreground="#73FFFFFF" LetterSpacing="2"/>

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,6"/>

                    <TextBlock Classes="tweak-section" Text="STAGE"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tweak-label" Text="Vinyl spin" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding VinylSpinEnabled}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tweak-label" Text="Waveform" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding WaveformEnabled}"
                                      OnContent="" OffContent=""/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="tweak-label" Text="Compact layout" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsMini}"
                                      OnContent="" OffContent=""/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,6"/>

                    <TextBlock Classes="tweak-section" Text="RIGHT PANEL"/>
                    <TextBlock Classes="tweak-label" Text="Default tab"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="tweak-radio" Content="Up Next"
                                Classes.active="{Binding DefaultTab, Converter={StaticResource StringEquals}, ConverterParameter='Up Next'}"
                                Command="{Binding SetDefaultTabCommand}" CommandParameter="Up Next"/>
                        <Button Classes="tweak-radio" Content="Lyrics"
                                Classes.active="{Binding DefaultTab, Converter={StaticResource StringEquals}, ConverterParameter=Lyrics}"
                                Command="{Binding SetDefaultTabCommand}" CommandParameter="Lyrics"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Panel>
</UserControl>
