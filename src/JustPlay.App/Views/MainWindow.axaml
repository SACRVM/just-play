<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustPlay.App.ViewModels"
        xmlns:views="using:JustPlay.App.Views"
        x:Class="JustPlay.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Just Play"
        Width="1320" Height="864"
        MinWidth="680" MinHeight="644"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <!-- When maximized / fullscreen the card must fill the screen perfectly: no transparent
             shadow margin, no rounded corners, no drop shadow. Driven by the "maximized" class set
             on RootCard from code-behind (WindowState watcher). The inner background rectangles
             carry their own 14-px radius, so they must square off too (descendant selector). -->
        <Style Selector="Border#RootCard.maximized">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
        </Style>
        <Style Selector="Border#RootCard.maximized &gt; Panel &gt; Rectangle">
            <Setter Property="RadiusX" Value="0"/>
            <Setter Property="RadiusY" Value="0"/>
        </Style>
    </Window.Styles>

    <Panel>
        <!--
          Outer card: rounded corners + soft drop shadow + the layered Aurora background.
          The window is slightly larger than the visible card (Margin=20/22) so the shadow has
          room to bloom OUTSIDE the rounded card into the transparent surround. That surround also
          hosts the resize grips below. ClipToBounds=False so the play-button halo can extend past
          the card edge; the Aurora rectangles carry their own RadiusX/Y=14 so the corners stay
          rounded without squaring off when ClipToBounds is False.
        -->
        <Border Name="RootCard"
                CornerRadius="14" ClipToBounds="False"
                Margin="20,20,20,22"
                Background="#40FF3366"
                DragDrop.AllowDrop="True"
                BoxShadow="{DynamicResource WindowOuter}">
            <Panel DragDrop.AllowDrop="True">
                <Rectangle Fill="{DynamicResource BgLinear}" RadiusX="14" RadiusY="14"/>
                <Rectangle Fill="{DynamicResource BgGlowA}"   RadiusX="14" RadiusY="14"/>
                <Rectangle Fill="{DynamicResource BgGlowB}"   RadiusX="14" RadiusY="14"/>

                <!-- View switch: Max vs Mini, same shared DataContext (the shell VM) -->
                <Panel>
                    <views:MaxView IsVisible="{Binding !IsMini}"/>
                    <views:MiniView IsVisible="{Binding IsMini}"/>
                </Panel>
            </Panel>
        </Border>

        <!--
          Edge + corner resize grips. They live in the thin transparent ring at the window edge
          (outside the visible card), so they never steal pointer input from the UI. Each calls
          BeginResizeDrag with the matching WindowEdge (its Tag). The centre cell has no element, so
          the card receives all normal input. Hidden in mini / maximized (code-behind).
        -->
        <Grid Name="ResizeGrips" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"     PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"      PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"      PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"     PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
        </Grid>
    </Panel>
</Window>
