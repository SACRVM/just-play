<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustPlay.App.ViewModels"
        xmlns:views="using:JustPlay.App.Views"
        x:Class="JustPlay.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Just Play"
        Width="1320" Height="864"
        MinWidth="680" MinHeight="644"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <!-- When maximized / fullscreen the card must fill the screen perfectly: no transparent
             shadow margin, no rounded corners, no drop shadow. Driven by the "maximized" class set
             on RootCard from code-behind (WindowState watcher). The inner background rectangles
             carry their own 14-px radius, so they must square off too (descendant selector). -->
</Window.Styles>

    <Panel>
        <!--
          Outer card: rounded corners + soft drop shadow + the layered Aurora background.
          The window is slightly larger than the visible card (Margin=20/22) so the shadow has
          room to bloom OUTSIDE the rounded card into the transparent surround. That surround also
          hosts the resize grips below. ClipToBounds=False so the play-button halo can extend past
          the card edge; the Aurora rectangles carry their own RadiusX/Y=14 so the corners stay
          rounded without squaring off when ClipToBounds is False.
        -->
        <Border Name="RootCard" ClipToBounds="False"
                Background="#40FF3366"
                DragDrop.AllowDrop="True">
            <Panel DragDrop.AllowDrop="True">
                <Rectangle Fill="{DynamicResource BgLinear}"/>
                <Rectangle Fill="{DynamicResource BgGlowA}"  />
                <Rectangle Fill="{DynamicResource BgGlowB}"  />

                <!-- View switch: Max vs Mini, same shared DataContext (the shell VM) -->
                <Panel>
                    <views:MaxView IsVisible="{Binding !IsMini}"/>
                    <views:MiniView IsVisible="{Binding IsMini}"/>
                </Panel>
            </Panel>
        </Border>

        <!--
          Edge + corner resize grips, wired by the SHARED FramelessResizeBehavior (code-behind) -
          the same one every other JUST window uses. Each carries a compass Tag; the centre cell has
          no element, so the card receives all normal input.

          The 20 below is a placeholder: the behaviour overwrites the outer bands with RootCard's own
          margin, so the grip starts exactly where the card ends. Typed constants here and a margin in
          the theme sheet is how the two drifted apart in the first place.
        -->
        <Grid Name="ResizeGrips" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"    />
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"     />
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"     />
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"    />
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast"/>
        </Grid>
    </Panel>
</Window>
