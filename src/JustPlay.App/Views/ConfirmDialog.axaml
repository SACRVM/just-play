<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JustPlay.App.Views.ConfirmDialog"
        Title="Confirm"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      Tiny themed yes/no confirmation dialog (e.g. "open playlist replaces the queue — sure?"). Same
      frameless rounded themed card as InputDialog. ShowDialog returns bool — see ConfirmDialog.AskAsync.
    -->
    <Border CornerRadius="16" Margin="14" ClipToBounds="True"
            BoxShadow="0 18 54 0 #B3000000">
        <Panel>
            <Rectangle Fill="{DynamicResource BgLinear}" RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowA}"   RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowB}"   RadiusX="16" RadiusY="16"/>
            <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16"/>

            <StackPanel Margin="28,26,28,22" Spacing="0">
                <TextBlock x:Name="TitleText" Text="Confirm" FontSize="14" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="12.5"
                           Foreground="#C8FFFFFF" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton"  Classes="dialog-close" Content="Cancel" Click="OnCancel"/>
                    <Button x:Name="ConfirmButton" Classes="dialog-close" Content="OK"     Click="OnConfirm"/>
                </StackPanel>
            </StackPanel>
        </Panel>
    </Border>
</Window>
