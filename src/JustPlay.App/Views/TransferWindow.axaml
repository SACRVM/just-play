<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustPlay.App.ViewModels"
        x:Class="JustPlay.App.Views.TransferWindow"
        x:DataType="vm:TransferViewModel"
        Title="Transfer"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      Transfer progress dialog (ZIP / folder export). Themed like the About dialog: frameless rounded
      card on the active palette (BgLinear/BgGlow + AccentABrush for the bar). Bound to TransferViewModel.
      Dismiss closes the window but the export Task keeps running (detached); Cancel trips the token so
      the Core writer aborts and removes its partial output. Both buttons + the card-drag are in code-behind.
    -->
    <Border CornerRadius="16" Margin="14" ClipToBounds="True"
            BoxShadow="0 18 54 0 #B3000000"
            PointerPressed="OnCardPressed">
        <Panel>
            <Rectangle Fill="{DynamicResource BgLinear}" RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowA}"   RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowB}"   RadiusX="16" RadiusY="16"/>
            <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16"/>

            <StackPanel Margin="28,26,28,22" Spacing="0">
                <TextBlock Text="Transferring set…" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding Target}" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>

                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}"
                             Height="6" CornerRadius="3" Margin="0,18,0,0"
                             Foreground="{DynamicResource AccentABrush}"/>
                <TextBlock Text="{Binding CountText}" FontSize="11" Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedDimBrush}"/>

                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <!-- Dismiss: close the window, export keeps running in the background. -->
                    <Button Classes="dialog-close" Content="Dismiss" Click="OnDismiss"/>
                    <!-- Cancel: abort the export (Core deletes the partial output), close. -->
                    <Button Classes="dialog-close" Content="Cancel" Click="OnCancel"/>
                </StackPanel>
            </StackPanel>
        </Panel>
    </Border>
</Window>
