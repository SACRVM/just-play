<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JustPlay.Stream.App"
             xmlns:theming="using:JustPlay.UI.Theming"
             Name="Just Stream"
             RequestedThemeVariant="Dark">

    <!-- macOS app menu - the bold "Just Stream" menu in the mac menu bar (title from Name=
         above). About opens the same shared About dialog as the Funkturm brand mark;
         Avalonia appends Hide/Quit itself. Inert on Windows/Linux. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Just Stream" Click="OnAboutMenu"/>
        </NativeMenu>
    </NativeMenu.Menu>

    <!--
      JUST STREAM design system - now built on the SHARED J.U.S.T. palette + styles from
      JustPlay.UI (merged below), so the two products are one family and switch themes LIVE
      together (AvaloniaThemeService, registered in Program.cs). The theme brushes mutate in
      place, so existing StaticResource brush references still follow the active theme; only
      raw-Color references need {DynamicResource} (see the Funkturm glow in MainWindow).
      The broadcast SIGNATURE is the ON-AIR band (Border.onair / .live) - a tally light that
      genuinely glows green on air. Everything else stays quiet and disciplined around it.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Shared J.U.S.T. theme palette (JustPlay.UI) - same colours, brushes, text ramp,
                 ToggleSwitch overrides and swatches as JUST PLAY, so the two products are one
                 family AND switch themes live. Broadcast-specific resources (ON-AIR green, card,
                 meters) stay inline below. -->
            <ResourceDictionary.MergedDictionaries>
                <theming:JustPalette/>
            </ResourceDictionary.MergedDictionaries>

        <Color x:Key="OnAir">#36e07a</Color>     <!-- broadcast green -->
        <SolidColorBrush x:Key="OnAirBrush" Color="{StaticResource OnAir}"/>
        <SolidColorBrush x:Key="OfflineBrush" Color="#6a5f8c"/>

        <!-- Frosted card surface: faint vertical glass gradient (not a flat translucent box) -->
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#16FFFFFF"/>
            <GradientStop Offset="1" Color="#08FFFFFF"/>
        </LinearGradientBrush>

        <!-- Audio level meter: green -> amber -> red (reads instantly as "level/peak") -->
        <LinearGradientBrush x:Key="MeterGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#34d17a"/>
            <GradientStop Offset="0.7" Color="#34d17a"/>
            <GradientStop Offset="0.86" Color="#ffd166"/>
            <GradientStop Offset="1" Color="#ff5f6d"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MeterTrackBrush" Color="#33000000"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
        <!-- Shared J.U.S.T. chrome/tab/cursor/text styles (JustPlay.UI). Broadcast-specific
             styles below layer after this include. -->
        <theming:JustStyles/>


        <!-- Type roles -->
        <Style Selector="TextBlock.brand">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TitleGradient}"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedDimBrush}"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        </Style>

        <!-- Frosted card -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BoxShadow" Value="0 8 24 -8 #66000000"/>
        </Style>

        <!-- === SIGNATURE: ON-AIR band ===
             Offline = quiet dark glass. Live (Classes.live bound to OnAir) = green wash + green
             glow halo so a glance across the room tells you you're transmitting. -->
        <Style Selector="Border.onair">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.onair.live">
            <!-- Live: themed ACCENT frame (was a hard green that clashed with the theme at the big size).
                 The tally LAMP stays green (Border.tally.live) - only the box frame/wash/glow follow the
                 active theme accent now, and the glow (OnAirHalo) is softer than the old green bloom. -->
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="{DynamicResource OnAirWashTop}"/>
                    <GradientStop Offset="1" Color="{DynamicResource OnAirWashBottom}"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource OnAirHalo}"/>
        </Style>

        <!-- Tally dot inside the band -->
        <Style Selector="Border.tally">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="{StaticResource OfflineBrush}"/>
        </Style>
        <Style Selector="Border.tally.live">
            <Setter Property="Background" Value="{StaticResource OnAirBrush}"/>
            <Setter Property="BoxShadow" Value="0 0 12 1 #CC36e07a"/>
        </Style>

        <!-- Primary CTA: wide pill, cyan->pink gradient, pink glow, hover lift (port of JustPlay's
             primary treatment, pill form for CONNECT). BoxShadow lives on the template Border
             (#root) - Button itself has no BoxShadow property. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <!-- MUST be "50%,50%" with the % - bare "0.5,0.5" parses as ABSOLUTE pixels (~ top-left
                 corner), so the hover scale pivots at the corner and the button zooms down-right
                 instead of from its centre. (Verified: Avalonia RelativePoint.Parse, release/12.0.3.) -->
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BoxShadow="0 6 18 -4 #99ff5fae">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <!-- === CONNECT / DISCONNECT - ONE quiet-glass CTA, two colours (Chloe, 2026-06-29) ===
             Both states share the EXACT same shape + a FIXED width, so nothing jumps when the label
             changes (CONNECT <-> CONNECTING... <-> DISCONNECT). Only the COLOUR + glyph differ:
               offline = theme accent + > play mark   -   live = red + stop stop mark   (glyphs in ConnectLabel).
             A small, deliberate break from the gradient-CTA convention (SEND keeps the gradient pill) - the
             glowing ON-AIR band stays the only signature; the transport CTA is calm dark glass. The old hard
             red/green-style fills clashed with cool themes; a thin coloured border + text is a small SIGNAL
             (like the green tally lamp), not a clashing slab. No glow, no hover-zoom - disciplined. -->
        <Style Selector="Button.cta">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="14,11"/>
            <!-- Fixed width = both states identical, no rumspringen. Sized to clear the longest label
                 ("RECONNECTING..."); padding trimmed with it. 184->164: Chloe 2026-07-05 - REC + CONNECT
                 ate ~50% of the mini bar. -->
            <Setter Property="Width" Value="164"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Keep FluentTheme's hover/pressed grey off our translucent glass (the documented custom-template
             ContentPresenter leak); hover/press just shift the glass tint via Border#root Background. -->
        <Style Selector="Button.cta /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.cta:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.cta:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.cta:pointerover">
            <Setter Property="Background" Value="#59000000"/>
        </Style>
        <Style Selector="Button.cta:pressed">
            <Setter Property="Background" Value="#6B000000"/>
        </Style>
        <!-- LIVE = red "stop": same pill, only the colour changes. -->
        <Style Selector="Button.cta.live">
            <Setter Property="BorderBrush" Value="#FF6B6B"/>
            <Setter Property="Foreground" Value="#FF8088"/>
        </Style>

        <!-- Ghost icon button (gear, small actions) -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Button.seg moved to the SHARED JustStyles (JustPlay.UI) so JUST PLAY + STREAM use the
             identical segmented / compact button (incl. the device-rescan refresh). -->


        <!-- Level meter: gradient indicator on a dark track, rounded -->
        <Style Selector="ProgressBar.meter">
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="{StaticResource MeterTrackBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MeterGradient}"/>
            <!-- Sub-pixel indicator glide: WITHOUT this the indicator width is rounded to whole device
                 pixels, so on the narrower MINI bar the small per-frame value steps fall under 1px and
                 the meter visibly stutters (smooth on the wider MAX bar). Off -> smooth at any width. -->
            <Setter Property="UseLayoutRounding" Value="False"/>
        </Style>

        <!-- Inputs: themed dark glass to replace raw Fluent chrome -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>
        <!-- Open flyout + items - themed exactly like JUST PLAY's device-picker dropdown so the
             Fluent SYSTEM-ACCENT (red on this machine) never shows on hover/selected. Generic =
             applies to EVERY ComboBox in JUST STREAM. -->
        <Style Selector="ComboBox /template/ Popup Border">
            <Setter Property="Background" Value="#F01a1828"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style Selector="ComboBox ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="MinHeight" Value="34"/>
            <!-- Themed text-selection + caret so the OS accent (RED) can't show on highlight. -->
            <Setter Property="SelectionBrush" Value="#448a5fff"/>
            <Setter Property="CaretBrush" Value="#D9FFFFFF"/>
        </Style>
        <!-- Kill the Fluent SYSTEM-ACCENT (red on this machine) on the focus/hover BORDER. Fluent paints
             the TextBox border on PART_BorderElement and swaps it to the accent on :focus - so it MUST be
             overridden there (the control-level BorderBrush above is ignored once focused). Generic =
             every TextBox in JUST STREAM (NOW PLAYING + the server-info fields). -->
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        </Style>

        <!-- Slider: accent-tinted active track + hand cursor -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Tabs (settings) - quiet header, white when selected, accent underline pipe -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedDimBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>

        <!-- Hairline vertical divider for the DSP fader bank -->
        <Style Selector="Border.vdiv">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>

        <!-- Hairline divider between de-boxed sections (no card frames - JUST PLAY pattern,
             see CLAUDE.md JUST suite UI philosophy: thin separators, not nested containers). -->
        <Style Selector="Border.sep">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>


        <!-- Brand/About mark button in the chrome bar (top-left) - IDENTICAL behaviour to JUST PLAY's
             Button.brand (App.axaml): the brand mark is clickable but NEVER renders button chrome on
             hover/press (no background appears). A Button only so the frameless drag handler treats it
             as interactive. -->
        <Style Selector="Button.brandbtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.brandbtn /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.brandbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.brandbtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>


        <!-- Hi-fi broadcast meter: a TALL variant of ProgressBar.meter for the prominent OUTPUT LEVEL
             display (the small 9px default still serves any inline use). -->
        <Style Selector="ProgressBar.meter.tall">
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <!-- dB scale ruler under the meters: 1px ticks + tiny mono numbers. Fill is dB-LINEAR over
             [-48,0] (LinearToDbFillConverter), so ticks at -48/-36/-24/-12/0 fall on even quarters. -->
        <Style Selector="Border.mtick">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{StaticResource MutedFaintBrush}"/>
        </Style>
        <Style Selector="TextBlock.mscale">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedFaintBrush}"/>
        </Style>
    </Application.Styles>
</Application>
