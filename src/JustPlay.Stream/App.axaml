<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JustPlay.Stream.App"
             RequestedThemeVariant="Dark">

    <!--
      JUST STREAM design system — the Aurora language ported from JustPlay.App/App.axaml
      (verbatim token values, cited) so the two products are unmistakably one family.
      v1 is a single fixed Aurora theme (no live theme-switch), so these are StaticResource.
      The broadcast SIGNATURE is the ON-AIR band (Border.onair / .live) — a tally light that
      genuinely glows green on air. Everything else stays quiet and disciplined around it.
    -->
    <Application.Resources>
        <!-- Palette (JustPlay App.axaml lines 22-29) -->
        <Color x:Key="BgFrom">#3a1d6b</Color>
        <Color x:Key="BgVia">#251347</Color>
        <Color x:Key="BgTo">#120a26</Color>
        <Color x:Key="AccentA">#6ce0ff</Color>   <!-- cyan  -->
        <Color x:Key="AccentB">#ff5fae</Color>   <!-- pink  -->
        <Color x:Key="AccentC">#8a5fff</Color>   <!-- purple -->
        <Color x:Key="Glow">#8C8C69FF</Color>    <!-- rgba(140,105,255,.55) -->
        <Color x:Key="OnAir">#36e07a</Color>     <!-- broadcast green -->

        <!-- Derived accent brushes -->
        <SolidColorBrush x:Key="AccentABrush" Color="{StaticResource AccentA}"/>
        <SolidColorBrush x:Key="AccentBBrush" Color="{StaticResource AccentB}"/>
        <SolidColorBrush x:Key="AccentCBrush" Color="{StaticResource AccentC}"/>
        <SolidColorBrush x:Key="OnAirBrush" Color="{StaticResource OnAir}"/>
        <SolidColorBrush x:Key="OfflineBrush" Color="#6a5f8c"/>

        <!-- Text ramp (JustPlay lines 100-104) -->
        <SolidColorBrush x:Key="TextBrush" Color="White"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A6FFFFFF"/>
        <SolidColorBrush x:Key="MutedDimBrush" Color="#73FFFFFF"/>
        <SolidColorBrush x:Key="MutedFaintBrush" Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#16FFFFFF"/>

        <!-- Cyan→pink accent gradient (progress, CTA, title underline) -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="{StaticResource AccentA}"/>
            <GradientStop Offset="1" Color="{StaticResource AccentB}"/>
        </LinearGradientBrush>
        <!-- Cyan→white→pink for the gradient wordmark -->
        <LinearGradientBrush x:Key="TitleGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="{StaticResource AccentA}"/>
            <GradientStop Offset="0.5" Color="White"/>
            <GradientStop Offset="1" Color="{StaticResource AccentB}"/>
        </LinearGradientBrush>

        <!-- Layered window background: linear base + two radial blooms (JustPlay lines 85-97) -->
        <LinearGradientBrush x:Key="BgLinear" StartPoint="10%,0%" EndPoint="90%,100%">
            <GradientStop Offset="0" Color="{StaticResource BgFrom}"/>
            <GradientStop Offset="0.5" Color="{StaticResource BgVia}"/>
            <GradientStop Offset="1" Color="{StaticResource BgTo}"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="BgGlowA" Center="72%,18%" GradientOrigin="72%,18%" RadiusX="60%" RadiusY="60%">
            <GradientStop Offset="0" Color="{StaticResource Glow}"/>
            <GradientStop Offset="1" Color="#00000000"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BgGlowB" Center="8%,88%" GradientOrigin="8%,88%" RadiusX="55%" RadiusY="55%">
            <GradientStop Offset="0" Color="{StaticResource AccentC}"/>
            <GradientStop Offset="1" Color="#00000000"/>
        </RadialGradientBrush>

        <!-- Frosted card surface: faint vertical glass gradient (not a flat translucent box) -->
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#16FFFFFF"/>
            <GradientStop Offset="1" Color="#08FFFFFF"/>
        </LinearGradientBrush>

        <!-- Audio level meter: green → amber → red (reads instantly as "level/peak") -->
        <LinearGradientBrush x:Key="MeterGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#34d17a"/>
            <GradientStop Offset="0.7" Color="#34d17a"/>
            <GradientStop Offset="0.86" Color="#ffd166"/>
            <GradientStop Offset="1" Color="#ff5f6d"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MeterTrackBrush" Color="#33000000"/>

        <!-- ToggleSwitch theming (JustPlay lines 122-139) — pin to accent, not SystemAccentColor -->
        <SolidColorBrush x:Key="ToggleSwitchFillOn"            Color="{StaticResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"     Color="{StaticResource AccentC}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn"            Color="{StaticResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentB}"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"     Color="{StaticResource AccentC}"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"            Color="White"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"     Color="#F0FFFFFF"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- Soft drop shadow under all text — legibility on the aurora bg + "lifted" feel (JustPlay) -->
        <Style Selector="TextBlock">
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
            </Setter>
        </Style>

        <!-- Type roles -->
        <Style Selector="TextBlock.brand">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TitleGradient}"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedDimBrush}"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
        </Style>

        <!-- Frosted card -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BoxShadow" Value="0 8 24 -8 #66000000"/>
        </Style>

        <!-- ═══ SIGNATURE: ON-AIR band ═══
             Offline = quiet dark glass. Live (Classes.live bound to OnAir) = green wash + green
             glow halo so a glance across the room tells you you're transmitting. -->
        <Style Selector="Border.onair">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.onair.live">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#3336e07a"/>
                    <GradientStop Offset="1" Color="#1436e07a"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="BorderBrush" Value="#8036e07a"/>
            <Setter Property="BoxShadow" Value="0 0 28 -2 #6636e07a, inset 0 0 18 -6 #4036e07a"/>
        </Style>

        <!-- Tally dot inside the band -->
        <Style Selector="Border.tally">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="{StaticResource OfflineBrush}"/>
        </Style>
        <Style Selector="Border.tally.live">
            <Setter Property="Background" Value="{StaticResource OnAirBrush}"/>
            <Setter Property="BoxShadow" Value="0 0 12 1 #CC36e07a"/>
        </Style>

        <!-- Primary CTA: wide pill, cyan→pink gradient, pink glow, hover lift (port of JustPlay's
             primary treatment, pill form for CONNECT). BoxShadow lives on the template Border
             (#root) — Button itself has no BoxShadow property. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BoxShadow="0 6 18 -4 #99ff5fae">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <!-- Live variant: when connected, the CTA goes red "stop" with a red glow -->
        <Style Selector="Button.primary.live">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#ff6f6f"/>
                    <GradientStop Offset="1" Color="#ff3d6e"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.primary.live /template/ Border#root">
            <Setter Property="BoxShadow" Value="0 6 18 -4 #99ff3d6e"/>
        </Style>

        <!-- Ghost icon button (gear, small actions) -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Segmented control (limiter drive Off|Soft|Club|Loud, log show/clear) — port of lens-seg -->
        <Style Selector="Button.seg">
            <Setter Property="MinWidth" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.seg /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.seg.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.seg.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentCBrush}"/>
        </Style>

        <!-- Level meter: gradient indicator on a dark track, rounded -->
        <Style Selector="ProgressBar.meter">
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="{StaticResource MeterTrackBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MeterGradient}"/>
        </Style>

        <!-- Inputs: themed dark glass to replace raw Fluent chrome -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <!-- Slider: accent-tinted active track + hand cursor -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Tabs (settings) — quiet header, white when selected, accent underline pipe -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedDimBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>

        <!-- Hairline vertical divider for the DSP fader bank -->
        <Style Selector="Border.vdiv">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>

        <!-- ═══ SHARED underline tabs — ported VERBATIM from JustPlay.App/App.axaml (Button.tab /
             Border.tabline, lines 703-740). Settings reuses these instead of a raw TabControl so the
             two products look like one family. Each tab = a Button.tab wrapping a Panel of a label
             (top) + <Border Classes="tabline"/> (bottom): no frame, just an accent-gradient underline
             that glows when active. (StaticResource here — JUST STREAM is a single fixed theme.) -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2,8,14,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#73FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tab /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.tab.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Border.tabline">
            <Setter Property="Height" Value="2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,-1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tab.active Border.tabline">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="{StaticResource AccentB}" BlurRadius="11" OffsetX="0" OffsetY="0" Opacity="1"/>
            </Setter>
        </Style>

        <!-- Hi-fi broadcast meter: a TALL variant of ProgressBar.meter for the prominent OUTPUT LEVEL
             display (the small 9px default still serves any inline use). -->
        <Style Selector="ProgressBar.meter.tall">
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <!-- dB scale ruler under the meters: 1px ticks + tiny mono numbers. Fill is dB-LINEAR over
             [-48,0] (LinearToDbFillConverter), so ticks at -48/-36/-24/-12/0 fall on even quarters. -->
        <Style Selector="Border.mtick">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{StaticResource MutedFaintBrush}"/>
        </Style>
        <Style Selector="TextBlock.mscale">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedFaintBrush}"/>
        </Style>
    </Application.Styles>
</Application>
