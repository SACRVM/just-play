<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustPlay.Stream.ViewModels"
        xmlns:models="using:JustPlay.Core.Models"
        xmlns:ui="using:JustPlay.UI.Controls"
        xmlns:beh="using:JustPlay.UI.Behaviors"
        x:Class="JustPlay.Stream.Views.MainWindow"
        x:DataType="vm:StreamViewModel"
        Title="JUST STREAM"
        Width="980"
        SizeToContent="Height"
        CanResize="False"
        MinWidth="920" MinHeight="420"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen">

    <!-- Frameless rounded floating card - SAME shell as JUST PLAY (MainWindow.axaml): no classic
         OS title bar, rounded card + drop shadow blooming into a transparent margin, custom caption
         buttons, drag from the chrome bar. Shadow = the shared theme-driven WindowOuter: the old
         "0 18 50 -12" literal (from the single-theme era) was LARGER than the transparent margin
         and clipped hard at the window edge (Chloe 2026-07-05); WindowOuter is sized for exactly
         these 20/22 margins - proven in JUST PLAY. -->
    <Window.Styles>
        <!-- Maximized: square off card (margin/corners/shadow) + the inner aurora rectangles. -->
<!-- Limiter 2x2 mode buttons (LED left of the name). Active = green lit lamp + brighter text. -->
        <Style Selector="Button.limbtn">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.limbtn /template/ ContentPresenter">
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.limbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="Button.limbtn.active">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.limbtn.active /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#5546E07B"/>
        </Style>

        <!-- Status LED: dim when off, green + glow when its mode is active. -->
        <Style Selector="Ellipse.lamp">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Ellipse.lamp.on">
            <Setter Property="Fill" Value="#46E07B"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="#46E07B" BlurRadius="9" OffsetX="0" OffsetY="0" Opacity="0.95"/>
            </Setter>
        </Style>

        <!-- OFF is the "bypassed" state -> its lamp + active border are RED, not green
             (defined AFTER the green rules so they override for the .off button). -->
        <Style Selector="Ellipse.lamp.off.on">
            <Setter Property="Fill" Value="#FF5C57"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="#FF5C57" BlurRadius="9" OffsetX="0" OffsetY="0" Opacity="0.95"/>
            </Setter>
        </Style>

        <!-- OUTPUT-LEVEL gain-reduction lamp (right of each L/R meter): dim idle -> AMBER (occasional,
             shallow catch = healthy) -> RED (deep <=-4 dB or sustained >=50% = crushing). Per-channel lit,
             bus-wide colour. -->
        <Style Selector="Ellipse.grlamp">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="#26FFFFFF"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.10"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.grlamp.lit">
            <Setter Property="Fill" Value="#FFB020"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="#FFB020" BlurRadius="9" OffsetX="0" OffsetY="0" Opacity="0.9"/>
            </Setter>
        </Style>
        <Style Selector="Ellipse.grlamp.lit.hard">
            <Setter Property="Fill" Value="#FF5C57"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="#FF5C57" BlurRadius="11" OffsetX="0" OffsetY="0" Opacity="0.95"/>
            </Setter>
        </Style>
        <Style Selector="Button.limbtn.off.active /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#66FF5C57"/>
        </Style>

        <!-- REC - the compact sibling of the CONNECT cta: same quiet glass, narrower, MUTED when
             idle (CONNECT stays the primary action), red while recording. The red dot is the
             universal record mark; it gets a glow when live. Defined here (window styles come
             after App.axaml) so .live re-states the cta red - same literals as Button.cta.live. -->
        <Style Selector="Button.cta.recbtn">
            <!-- 96 = just clears the widest label ("12:34:56" + dot) at the trimmed padding -
                 Chloe 2026-07-05: REC + CONNECT ate ~50% of the mini bar, both narrowed. -->
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="6,11"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style Selector="Button.cta.recbtn.live">
            <Setter Property="BorderBrush" Value="#FF6B6B"/>
            <Setter Property="Foreground" Value="#FF8088"/>
        </Style>
        <Style Selector="Button.cta.recbtn Ellipse">
            <Setter Property="Fill" Value="#B3E0524F"/>
        </Style>
        <Style Selector="Button.cta.recbtn.live Ellipse">
            <Setter Property="Fill" Value="#FF5C57"/>
            <Setter Property="Effect">
                <DropShadowEffect Color="#FF5C57" BlurRadius="9" OffsetX="0" OffsetY="0" Opacity="0.95"/>
            </Setter>
        </Style>
    </Window.Styles>

    <Panel>
        <Border Name="RootCard" ClipToBounds="False"
                Background="#40000000">
            <Panel>
                <Rectangle Fill="{StaticResource BgLinear}"/>
                <Rectangle Fill="{StaticResource BgGlowA}"  />
                <Rectangle Fill="{StaticResource BgGlowB}"  />

                <DockPanel LastChildFill="True">

                    <!-- === CHROME / TITLE BAR (frameless; brand left, gear + caption buttons right) == -->
                    <Border DockPanel.Dock="Top" Height="36" Name="ChromeBar"
                            Background="Transparent" PointerPressed="OnChromePressed">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                            <!-- Brand mark (top-left) - the FUNKTURM (radio-tower) glyph on the theme
                                 gradient chip, per the JUST suite UI philosophy (CLAUDE.md). -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        Margin="6,0,0,0" VerticalAlignment="Center">
                                <!-- macOS: traffic lights on the far LEFT (suite chrome rule for mac). -->
                                <ui:WindowControls ShowMaximize="False" Margin="8,0,0,0"
                                                   IsVisible="{x:Static ui:Platform.IsMac}"/>
                                <!-- Brand mark IS the About button (top-left), per the JUST suite UI
                                     philosophy - opens the SHARED About dialog (JustPlay.UI).
                                     On macOS the brand sits CENTERED instead (end of this grid). -->
                                <Button Classes="brandbtn" Click="OnAbout" ToolTip.Tip="About JUST STREAM"
                                        IsVisible="{x:Static ui:Platform.IsNotMac}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <!-- TRANSPARENT chip - just the enlarged white Funkturm glyph filling
                                             the area where the gradient chip was (Chloe 2026-06-30). -->
                                        <Border Width="20" Height="20" Background="Transparent">
                                            <!-- Lucide "radio-tower" (ISC) - the Funkturm mark. -->
                                            <Path Stretch="Uniform" Width="16" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="White" StrokeThickness="2"
                                                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                                  Data="M4.9 16.1 C1 12.2 1 5.8 4.9 1.9
                                                        M7.8 4.7 a6.14 6.14 0 0 0 -.8 7.5
                                                        M10 9 A2 2 0 1 0 14 9 A2 2 0 1 0 10 9
                                                        M16.2 4.8 c2 2 2.26 5.11 .8 7.47
                                                        M19.1 1.9 a9.96 9.96 0 0 1 0 14.1
                                                        M9.5 18 h5
                                                        M8 22 l4 -11 l4 11">
                                                <Path.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
                                                </Path.Effect>
                                            </Path>
                                        </Border>
                                        <TextBlock Text="JUST STREAM" FontSize="11" FontWeight="SemiBold"
                                                   LetterSpacing="2" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Hairline separates brand and label - pointless on macOS, where the
                                     label sits directly next to the traffic lights. -->
                                <Panel IsVisible="{x:Static ui:Platform.IsNotMac}">
                                    <Border Background="{StaticResource HairlineBrush}" Width="1" Height="16" Margin="4,0"
                                            IsVisible="{Binding !IsMini}"/>
                                </Panel>
                                <TextBlock Classes="label" Text="BROADCAST CONSOLE" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsMini}"/>
                            </StackPanel>

                            <!-- Log + Settings (cap buttons, match the caption buttons) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <!-- View toggle - swaps glyph AND tooltip by mode, like JUST PLAY (MaxView shows
                                     "Mini player"/picture-in-picture, MiniView shows "Expand"/box). STREAM is one
                                     resizing window, so the single slot flips on IsMini. -->
                                <!-- FULL -> go mini: Lucide picture-in-picture-2 -->
                                <!-- Suite terminology (Chloe 2026-07-05): "Compact view" / "Expand to
                                     full view" everywhere - "player" was wrong for STREAM (it broadcasts),
                                     so both apps share the neutral pair now. -->
                                <Button Classes="cap" Command="{Binding ToggleViewModeCommand}" ToolTip.Tip="Compact view"
                                        IsVisible="{Binding !IsMini}">
                                    <Path Stretch="Uniform" Width="17" Height="17"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          Data="M21 9 V6 a2 2 0 0 0 -2 -2 H4 a2 2 0 0 0 -2 2 v10 c0 1.1 .9 2 2 2 h4
                                                M14 13 h6 a2 2 0 0 1 2 2 v3 a2 2 0 0 1 -2 2 h-6 a2 2 0 0 1 -2 -2 v-3 a2 2 0 0 1 2 -2 Z"/>
                                </Button>
                                <!-- MINI -> expand back: same box glyph + "Expand" tooltip as JUST PLAY's MiniView -->
                                <Button Classes="cap" Command="{Binding ToggleViewModeCommand}" ToolTip.Tip="Expand to full view"
                                        IsVisible="{Binding IsMini}">
                                    <Path Stretch="None" Width="14" Height="14"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4"
                                          StrokeJoin="Round" Fill="Transparent"
                                          Data="M 1,3 L 13,3 L 13,11 L 1,11 Z"/>
                                </Button>
                                <!-- Spectrum analyzer - opens the SHARED live spectrum window (JustPlay.UI)
                                     over the broadcast bus (DRY vs WET + limiter GR). OUT L/R column hidden:
                                     STREAM already shows its own output meter. Glyph pulses while a signal
                                     is arriving (input present), NOT only on air (Chloe 2026-07-02).
                                     Stays visible in mini (separate window). -->
                                <Button Classes="cap" Click="OnSpectrum" ToolTip.Tip="Spectrum analyzer">
                                    <ui:SpectrumGlyph Width="18" Height="14" Active="{Binding HasInputSignal}"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      VerticalAlignment="Center"/>
                                </Button>
                                <!-- Event-log button - opens the LogWindow; the dot marks unread entries.
                                     Stays visible in mini: it opens a SEPARATE window, so mini doesn't block it. -->
                                <Panel>
                                    <Button Classes="cap" Click="OnOpenLog" ToolTip.Tip="Event log">
                                        <!-- 3-bar "log" glyph as stacked rectangles - VerticalAlignment=Center
                                             guarantees vertical centring (Path+Uniform kept drifting). -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3.5">
                                            <Rectangle Width="15" Height="1.7" RadiusX="1" RadiusY="1" Fill="{Binding $parent[Button].Foreground}"/>
                                            <Rectangle Width="15" Height="1.7" RadiusX="1" RadiusY="1" Fill="{Binding $parent[Button].Foreground}"/>
                                            <Rectangle Width="15" Height="1.7" RadiusX="1" RadiusY="1" Fill="{Binding $parent[Button].Foreground}"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Width="9" Height="9" CornerRadius="5"
                                            Background="#F2FFFFFF"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                            IsHitTestVisible="False" IsVisible="{Binding EventLog.HasUnread}"/>
                                </Panel>
                                <!-- Settings gear - also stays in mini (separate window, can open). -->
                                <Button Name="SettingsBtn" Classes="cap" Click="OpenSettings" ToolTip.Tip="Settings">
                                    <Path Stretch="Uniform" Width="16" Height="16"
                                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2"
                                          StrokeJoin="Round" Fill="Transparent"
                                          Data="M 7,0 L 9,0 L 9.5,2 L 11.5,2.5 L 13,1.3 L 14.7,3 L 13.5,4.5 L 14,6.5 L 16,7 L 16,9 L 14,9.5 L 13.5,11.5 L 14.7,13 L 13,14.7 L 11.5,13.5 L 9.5,14 L 9,16 L 7,16 L 6.5,14 L 4.5,13.5 L 3,14.7 L 1.3,13 L 2.5,11.5 L 2,9.5 L 0,9 L 0,7 L 2,6.5 L 2.5,4.5 L 1.3,3 L 3,1.3 L 4.5,2.5 L 6.5,2 Z M 8,5.5 A 2.5,2.5 0 1 0 8,10.5 A 2.5,2.5 0 1 0 8,5.5 Z"/>
                                </Button>
                            </StackPanel>

                            <!-- Caption buttons - shared suite control (JustPlay.UI/Controls/WindowControls).
                                 No maximize: JUST STREAM is a fixed-size window (its layout isn't dynamic).
                                 Windows-only here; on macOS the traffic lights sit LEFT (brand panel above). -->
                            <ui:WindowControls Grid.Column="3" ShowMaximize="False"
                                               IsVisible="{x:Static ui:Platform.IsNotMac}"/>

                            <!-- macOS: brand mark CENTERED in the chrome bar (mac title-bar convention) -
                                 still the About button, mirrors JUST PLAY's MaxView. -->
                            <Button Grid.ColumnSpan="4" Classes="brandbtn" Click="OnAbout"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsVisible="{x:Static ui:Platform.IsMac}" ToolTip.Tip="About JUST STREAM">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="20" Height="20" Background="Transparent">
                                        <!-- Lucide "radio-tower" (ISC) - the Funkturm mark. -->
                                        <Path Stretch="Uniform" Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                              Data="M4.9 16.1 C1 12.2 1 5.8 4.9 1.9
                                                    M7.8 4.7 a6.14 6.14 0 0 0 -.8 7.5
                                                    M10 9 A2 2 0 1 0 14 9 A2 2 0 1 0 10 9
                                                    M16.2 4.8 c2 2 2.26 5.11 .8 7.47
                                                    M19.1 1.9 a9.96 9.96 0 0 1 0 14.1
                                                    M9.5 18 h5
                                                    M8 22 l4 -11 l4 11">
                                            <Path.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
                                            </Path.Effect>
                                        </Path>
                                    </Border>
                                    <TextBlock Text="JUST STREAM" FontSize="11" FontWeight="SemiBold"
                                               LetterSpacing="2" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Keyboard-hint bar - the SHARED KeyLegend, the same control the PRE CUE FINDER uses
                         (Chloe 2026-07-06: "ein Guss"). Docks to the BOTTOM so the body Grid stays the fill
                         child; hidden via Settings -> Look for pros (ShowKeyHints). -->
                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowKeyHints}" Padding="18,4,18,10">
                        <ui:KeyLegend Hints="{Binding KeyHints}" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- === BODY - de-boxed: sections sit directly on the aurora bg, divided by thin
                         hairlines (Border.sep), NOT nested card containers. The ON-AIR band is the one
                         framed element by design (the broadcast SIGNATURE). == -->
                    <Grid Margin="18,4,18,24"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Server profile selector -->
                        <ComboBox Grid.Row="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                  IsEnabled="{Binding !IsConnected}"
                                  PlaceholderText="Select server profile...">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:StreamServerProfile">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- === SIGNATURE: ON-AIR band + CONNECT (kept framed - glows green on air) === -->
                        <Border Grid.Row="1" Classes="onair" Classes.live="{Binding OnAir}" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Border Grid.Column="0" Classes="tally" Classes.live="{Binding OnAir}"
                                        VerticalAlignment="Center" Margin="2,0,14,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="24" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <!-- Dynamic detail (replaces the old static "STREAM STATUS" caption):
                                         armed target offline - host while connecting - confirmed format on air. -->
                                    <TextBlock Text="{Binding StatusDetail}" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding StreamTimeText}" Classes="mono" FontSize="22" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Classes="label" Text="ON-AIR TIME" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <!-- REC - record the master bus to a local file (independent of the stream:
                                     works off-air, survives reconnects; format/folder in Settings). Idle =
                                     muted "o REC"; recording = red + elapsed time; click = stop (finalizes
                                     the file). Stays visible in mini - recording is a while-mixing action. -->
                                <Button Grid.Column="3" Classes="cta recbtn" Classes.live="{Binding IsRecording}"
                                        Command="{Binding ToggleRecordCommand}"
                                        ToolTip.Tip="{Binding RecordTooltip}"
                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                    <!-- Right-click -> jump to the recordings on disk. Click handler, not a
                                         Command: a ContextMenu popup is outside the visual tree, so command
                                         bindings resolve null (same pattern as the preset chips). -->
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open recordings folder" Click="OnOpenRecordingsFolder"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RecordLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- CONNECT/DISCONNECT share ONE quiet-glass style (Button.cta), fixed width,
                                     differ only by colour + glyph (> accent / stop red) - see App.axaml. -->
                                <Button Grid.Column="4" Classes="cta" Classes.live="{Binding IsConnected}"
                                        Command="{Binding ToggleConnectCommand}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:JustIcon Kind="{Binding ConnectIcon}" Width="10" Height="10"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding ConnectIcon, Converter={x:Static ui:IconConverters.IsSet}}"/>
                                        <TextBlock Text="{Binding ConnectLabel}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- === OUTPUT LEVEL - hi-fi broadcast meter (de-boxed) === -->
                        <StackPanel Grid.Row="2" Spacing="9">
                            <DockPanel>
                                <TextBlock Classes="label" Text="OUTPUT LEVEL" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <TextBlock Classes="label" Text="TRUE-PEAK - dBTP" DockPanel.Dock="Right"
                                           Foreground="{StaticResource MutedFaintBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- L - trailing 22px column holds the limiter gain-reduction lamp (right side
                                 = symmetry with the L/R labels on the left + a useful per-channel readout). -->
                            <Grid ColumnDefinitions="14,*,22" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="L" Classes="label" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ui:LevelMeter Grid.Column="1" Name="MeterL" Orientation="Horizontal"
                                               Margin="4,0,0,0" Height="16"/>
                                <Ellipse Grid.Column="2" Classes="grlamp" VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Classes.lit="{Binding LeftLimitActive}" Classes.hard="{Binding LimiterHard}"
                                         ToolTip.Tip="Limiter - amber: catching peaks (healthy) - red: heavy/sustained (lower the input)"/>
                            </Grid>

                            <!-- R -->
                            <Grid ColumnDefinitions="14,*,22" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="R" Classes="label" FontWeight="Bold" VerticalAlignment="Center"/>
                                <ui:LevelMeter Grid.Column="1" Name="MeterR" Orientation="Horizontal"
                                               Margin="4,0,0,0" Height="16"/>
                                <Ellipse Grid.Column="2" Classes="grlamp" VerticalAlignment="Center" HorizontalAlignment="Center"
                                         Classes.lit="{Binding RightLimitActive}" Classes.hard="{Binding LimiterHard}"
                                         ToolTip.Tip="Limiter - amber: catching peaks (healthy) - red: heavy/sustained (lower the input)"/>
                            </Grid>

                            <!-- dB ruler - same 14,*,22 grid so the bar (*) lines up under the meters above. -->
                            <Grid ColumnDefinitions="14,*,22">
                                <StackPanel Grid.Column="1" Margin="4,0,0,0" Spacing="2">
                                    <Grid ColumnDefinitions="*,*,*,*" Height="4">
                                        <Border Grid.Column="0" Classes="mtick" HorizontalAlignment="Left"/>
                                        <Border Grid.Column="0" Classes="mtick" HorizontalAlignment="Right"/>
                                        <Border Grid.Column="1" Classes="mtick" HorizontalAlignment="Right"/>
                                        <Border Grid.Column="2" Classes="mtick" HorizontalAlignment="Right"/>
                                        <Border Grid.Column="3" Classes="mtick" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <TextBlock Grid.Column="0" Classes="mscale" Text="-48" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="0" Classes="mscale" Text="-36" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Classes="mscale" Text="-24" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Classes="mscale" Text="-12" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Classes="mscale" Text="0" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="3" Classes="sep" Margin="0,12" IsVisible="{Binding !IsMini}"/>

                        <!-- === STREAM INFO + NOW PLAYING (left) - INPUT (right) - de-boxed, vertical hairline === -->
                        <Grid Grid.Row="4" ColumnDefinitions="*,1,*" IsVisible="{Binding !IsMini}">
                            <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,16,0">
                                <TextBlock Classes="label" Text="STREAM INFO"/>
                                <!-- LISTENERS + RATE (read-only) - CODEC + QUALITY dropdowns (editable, locked while live) - MOUNT.
                                     x:CompileBindings=False: ComboBox.SelectedItem binds to an enum/int VM property. -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" x:CompileBindings="False">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                        <TextBlock Classes="label" Text="LISTENERS"/>
                                        <Border Classes="readfield">
                                            <TextBlock Classes="value" Text="{Binding ListenersText}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,8">
                                        <TextBlock Classes="label" Text="RATE"/>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding SampleRates}" SelectedItem="{Binding SelectedSampleRate}"
                                                  IsEnabled="{Binding !IsConnected}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static vm:SampleRateLabelConverter.Instance}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,8,8">
                                        <TextBlock Classes="label" Text="CODEC"/>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedProfileFormat}"
                                                  IsEnabled="{Binding !IsConnected}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,0,8">
                                        <TextBlock Classes="label" Text="QUALITY"/>
                                        <ComboBox HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedProfileBitrateKbps}"
                                                  IsEnabled="{Binding !IsConnected}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                                        <TextBlock Classes="label" Text="MOUNT"/>
                                        <Border Classes="readfield">
                                            <TextBlock Classes="value" Text="{Binding MountText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border Classes="sep"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="NOW PLAYING / STATION TITLE"/>
                                    <!-- Input + SEND only usable when song-info is active (on AND codec supports it). -->
                                    <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding IsSongInfoActive}">
                                        <TextBox Grid.Column="0" Text="{Binding NowPlayingText}"
                                                 PlaceholderText="What's playing..." VerticalContentAlignment="Center"/>
                                        <!-- Themed like JUST PLAY's action buttons: a compact primary pill
                                             (accent gradient + glow + hover lift), not the old flat AccentC
                                             segment. Padding override keeps it small in the inline slot. -->
                                        <Button Grid.Column="1" Classes="primary" Content="SEND" Margin="8,0,0,0"
                                                Command="{Binding SendTitleCommand}" Height="34" Padding="18,0" FontSize="12"/>
                                    </Grid>
                                    <!-- Disabled for Opus: Ogg/Opus can't carry live ICY now-playing (MP3 only). -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanBroadcastSongInfo}"
                                                ToolTip.Tip="Live now-playing works on MP3 only - Opus/Ogg streams can't carry track titles.">
                                        <ToggleSwitch IsChecked="{Binding SendSongInfo}" OnContent="" OffContent=""/>
                                        <TextBlock Classes="label" Text="BROADCAST SONG INFO" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource HairlineBrush}" Width="1" Margin="0,2"/>

                            <StackPanel Grid.Column="2" Spacing="10" Margin="16,0,0,0">
                                <DockPanel>
                                    <TextBlock Classes="label" Text="INPUT SOURCE" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <Button Classes="seg" DockPanel.Dock="Right"
                                            Command="{Binding RefreshDeviceListCommand}" ToolTip.Tip="Rescan devices / apps" MinWidth="30">
                                        <ui:JustIcon Kind="Refresh" Width="12" Height="12"/>
                                    </Button>
                                    <!-- Device vs single-App capture. Only shown when the OS build supports
                                         per-process loopback (Windows 10 2004+). App = capture ONE app invisibly. -->
                                    <ToggleSwitch DockPanel.Dock="Right" Margin="20,0,8,0"
                                                  IsVisible="{Binding SupportsAppCapture}"
                                                  IsChecked="{Binding IsAppSourceMode}"
                                                  OffContent="Device" OnContent="App"
                                                  ToolTip.Tip="Device = a sound-card / loopback. App = capture ONE application's audio directly (no cable, no system-sound leak)."/>
                                </DockPanel>
                                <!-- Device / loopback picker (default source). -->
                                <ComboBox IsVisible="{Binding !IsAppSourceMode}"
                                          ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice}"
                                          HorizontalAlignment="Stretch" PlaceholderText="Select input / loopback...">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AudioInputDevice">
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- App picker (per-process capture). DJ apps sort first. -->
                                <ComboBox IsVisible="{Binding IsAppSourceMode}"
                                          ItemsSource="{Binding CaptureApps}" SelectedItem="{Binding SelectedCaptureApp}"
                                          HorizontalAlignment="Stretch" PlaceholderText="Select an app to capture...">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CaptureApp">
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- Master-channel handling for a multi-out DJ device (Master + headphone
                                     Cue on ONE interface, e.g. Reloop Mixtour). "Full mix" downmixes
                                     everything (the Cue bleeds into the broadcast); "Master 1-2/3-4"
                                     captures the native channels and broadcasts only the Master pair.
                                     Validated on Mixtour + Traktor (Chloe 2026-07-02). App mode only. -->
                                <StackPanel IsVisible="{Binding IsAppSourceMode}" Spacing="4">
                                    <TextBlock Classes="label" Text="BROADCAST CHANNELS"/>
                                    <ComboBox x:CompileBindings="False" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding AppChannelOptions}" SelectedItem="{Binding SelectedAppChannels}"
                                              ToolTip.Tip="Which channels of the app go on air. Channels 1-2 (default) - on DJ gear that's usually the Master, so the headphone Cue (usually 3-4) is left out; a normal stereo app is just its audio. Channels 3-4 - if your Master is routed to that pair. Full mix - all channels combined.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static vm:AppChannelsLabelConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <!-- ASIO / WASAPI-exclusive caveat. Per-process loopback taps the Windows
                                     shared audio engine; an app driving its card via ASIO or exclusive mode
                                     bypasses that engine, so it appears in the list but delivers silence.
                                     Honest inline hint so a DJ knows WHY (Chloe 2026-07-02). -->
                                <TextBlock IsVisible="{Binding IsAppSourceMode}" Classes="hint"
                                           Text="No sound from an app? If it drives your DJ card via ASIO or WASAPI-exclusive it bypasses Windows and can't be captured here - set that app's output to a normal Windows device (shared mode), or use a Device source."/>

                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Classes="label" Text="GAIN" VerticalAlignment="Center" Width="40"/>
                                    <Slider Grid.Column="1" Classes="fader" Minimum="-24" Maximum="24" Value="{Binding InputGainDb}"
                                            beh:SliderReset.Default="0"/>
                                    <TextBlock Grid.Column="2" Classes="mono" FontSize="11" Width="48" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding InputGainDb, Converter={x:Static vm:GainDbConverter.Instance}}"/>
                                </Grid>

                                <StackPanel Spacing="10"
                                            ToolTip.Tip="Listen to the processed broadcast on a chosen output of THIS PC - does NOT affect the stream. 'No output (stream only)' = no local monitor (the default; you simply hear the stream itself).">
                                    <!-- LastChildFill=False so the refresh honours Dock=Right and hugs the right edge,
                                         matching the INPUT SOURCE row (where the toggle is the fill child). -->
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Classes="label" Text="MONITOR (LOCAL)" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                        <Button Classes="seg" DockPanel.Dock="Right"
                                                Command="{Binding RefreshDeviceListCommand}" ToolTip.Tip="Rescan devices" MinWidth="30">
                                            <ui:JustIcon Kind="Refresh" Width="12" Height="12"/>
                                        </Button>
                                    </DockPanel>
                                    <ComboBox HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AudioOutputDevice">
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Classes="label" Text="VOL" VerticalAlignment="Center" Width="40"/>
                                        <Slider Grid.Column="1" Classes="fader" Minimum="0" Maximum="1" Value="{Binding MonitorVolume}"
                                                IsEnabled="{Binding IsMonitorDeviceSelected}" VerticalAlignment="Center"
                                                beh:SliderReset.Default="0.8"/>
                                        <TextBlock Grid.Column="2" Classes="mono" FontSize="11" Width="48" TextAlignment="Right"
                                                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding MonitorVolume, Converter={x:Static vm:VolumeDbConverter.Instance}}"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="5" Classes="sep" Margin="0,12" IsVisible="{Binding !IsMini}"/>

                        <!-- === BROADCAST DSP (faders, left) + LIMITER/MAXIMIZER (right) - side by side === -->
                        <StackPanel Grid.Row="6" Spacing="10" IsVisible="{Binding !IsMini}">
                            <DockPanel>
                                <TextBlock Classes="label" Text="BROADCAST DSP" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Border DockPanel.Dock="Right" Background="#16000000" CornerRadius="9" Padding="3"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <!-- Preset chips: built-in Normal/Hard (seeded) + user presets. Click = apply,
                                             right-click = replace / rename / delete, (+) = save current. Same UX as
                                             JUST PLAY's Sound tab (DspPreset CRUD). -->
                                        <ItemsControl ItemsSource="{Binding SoundPresets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:CompileBindings="False">
                                                    <Button Classes="seg" Content="{Binding Name}"
                                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Apply this preset - right-click to replace / rename / delete">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Replace with current" Click="OnPresetReplace"/>
                                                                <MenuItem Header="Rename..." Click="OnPresetRename"/>
                                                                <MenuItem Header="Delete" Click="OnPresetDelete"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Save the current EQ + Tilt + Punch + Limiter as a NEW named preset.
                                             Square (26x26): override seg's 44 MinWidth + side padding so it's not wider than tall. -->
                                        <Button Classes="seg" Content="+" Command="{Binding SavePresetCommand}"
                                                MinWidth="0" Width="26" Padding="0" FontSize="15"
                                                ToolTip.Tip="Save the current DSP settings as a named preset"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>

                            <!-- DSP row - three equal columns (33/33/33): EQ | Auto-Tilt+Punch | Limiter.
                                 All five vertical faders are the SAME control: Classes="fader", Width 62,
                                 Height 72, centred readout - only the Max + binding differ. -->
                            <Grid ColumnDefinitions="*,*,*">

                                <!-- Col 0: 3-band EQ - HIGH -> MID -> LOW (left to right) -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Width="62" Spacing="4">
                                        <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding EqHigh, Converter={x:Static vm:RatioF2Converter.Instance}}"/>
                                        <Slider Classes="fader" Orientation="Vertical" Height="72" HorizontalAlignment="Center" Minimum="0" Maximum="2" Value="{Binding EqHigh}" beh:SliderReset.Default="1"/>
                                        <TextBlock Classes="label" Text="HIGH" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Width="62" Spacing="4">
                                        <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding EqMid, Converter={x:Static vm:RatioF2Converter.Instance}}"/>
                                        <Slider Classes="fader" Orientation="Vertical" Height="72" HorizontalAlignment="Center" Minimum="0" Maximum="2" Value="{Binding EqMid}" beh:SliderReset.Default="1"/>
                                        <TextBlock Classes="label" Text="MID" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Width="62" Spacing="4">
                                        <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                   Text="{Binding EqLow, Converter={x:Static vm:RatioF2Converter.Instance}}"/>
                                        <Slider Classes="fader" Orientation="Vertical" Height="72" HorizontalAlignment="Center" Minimum="0" Maximum="2" Value="{Binding EqLow}" beh:SliderReset.Default="1"/>
                                        <TextBlock Classes="label" Text="LOW" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Col 1: Auto-Tilt + Punch (hairline divider on the left) -->
                                <Border Grid.Column="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Width="62" Spacing="4">
                                            <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding AutoTilt, Converter={x:Static vm:RatioF2Converter.Instance}}"/>
                                            <Slider Classes="fader" Orientation="Vertical" Height="72" HorizontalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding AutoTilt}" beh:SliderReset.Default="0"/>
                                            <TextBlock Classes="label" Text="TILT" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Width="62" Spacing="4">
                                            <TextBlock Classes="mono" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Punch, Converter={x:Static vm:RatioF2Converter.Instance}}"/>
                                            <Slider Classes="fader" Orientation="Vertical" Height="72" HorizontalAlignment="Center" Minimum="0" Maximum="1" Value="{Binding Punch}" beh:SliderReset.Default="0"/>
                                            <TextBlock Classes="label" Text="PUNCH" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Col 2: Limiter / Maximizer - 2x2 LED buttons. Same vertical structure as the
                                     fader columns (readout-height spacer - 72-tall body - label) so it lines up. -->
                                <Border Grid.Column="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                        <TextBlock Classes="mono" FontSize="10" Text=" "/>
                                        <Grid Width="212" Height="72" ColumnDefinitions="*,*" RowDefinitions="*,*">
                                            <Button Grid.Row="0" Grid.Column="0" Classes="limbtn off" Margin="0,0,4,4"
                                                    Command="{Binding SetLimiterDriveCommand}" CommandParameter="Off"
                                                    Classes.active="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Off}">
                                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <Ellipse Classes="lamp off" Classes.on="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Off}"/>
                                                    <TextBlock Text="OFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="0" Grid.Column="1" Classes="limbtn" Margin="4,0,0,4"
                                                    Command="{Binding SetLimiterDriveCommand}" CommandParameter="Soft"
                                                    Classes.active="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Soft}">
                                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <Ellipse Classes="lamp" Classes.on="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Soft}"/>
                                                    <TextBlock Text="SOFT" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="0" Classes="limbtn" Margin="0,4,4,0"
                                                    Command="{Binding SetLimiterDriveCommand}" CommandParameter="Club"
                                                    Classes.active="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Club}">
                                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <Ellipse Classes="lamp" Classes.on="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Club}"/>
                                                    <TextBlock Text="CLUB" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="1" Classes="limbtn" Margin="4,4,0,0"
                                                    Command="{Binding SetLimiterDriveCommand}" CommandParameter="Loud"
                                                    Classes.active="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Loud}">
                                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                                    <Ellipse Classes="lamp" Classes.on="{Binding LimiterDrive, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Loud}"/>
                                                    <TextBlock Text="LOUD" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <TextBlock Classes="label" Text="LIMITER / MAXIMIZER" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Panel>
        </Border>

        <!-- Resize grips kept in markup but DISABLED - JUST STREAM is fixed-size (no dynamic layout),
             so user resizing is off (CanResize=False + these hidden). -->
        <Grid Name="ResizeGrips" IsVisible="False" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"     PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"      PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"      PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"     PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="OnResizePressed" PointerMoved="OnResizeMoved" PointerReleased="OnResizeReleased"/>
        </Grid>
    </Panel>
</Window>
