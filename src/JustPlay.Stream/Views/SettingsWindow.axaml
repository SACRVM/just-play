<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustPlay.Stream.ViewModels"
        xmlns:models="using:JustPlay.Core.Models"
        xmlns:theming="using:JustPlay.UI.Theming"
        xmlns:uic="using:JustPlay.UI.Controls"
        x:Class="JustPlay.Stream.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="JUST STREAM - Settings"
        Width="784" Height="549"
        CanResize="False"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <!-- Themed server-list rows - mirrors JUST PLAY's queue ListBoxItem (MaxView.axaml): flat
         white hover, theme-driven accent swipe on selected (AccentCRow/AccentBRow recolour per
         theme), rounded. Replaces the bare Fluent default that clashed with the dark card. -->
    <Window.Styles>
        <Style Selector="ListBox.servers ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF"/>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="{DynamicResource AccentCRow}"/>
                    <GradientStop Offset="0.6" Color="{DynamicResource AccentBRow}"/>
                    <GradientStop Offset="1"   Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="{DynamicResource AccentCRowHover}"/>
                    <GradientStop Offset="0.6" Color="{DynamicResource AccentBRowHover}"/>
                    <GradientStop Offset="1"   Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- Frameless rounded dialog - same shell as the main console + JUST PLAY (no classic title bar). -->
    <Panel>
        <Border Name="DialogCard" ClipToBounds="False"
                Background="#40000000">
            <Panel>
                <!-- The SHARED surface (JustPlay.UI SurfaceCard) - the flat slab every JUST dialog
                     carries, so a settings window reads as its own object rather than as a second
                     main window. One definition for all nine dialogs and the tweaks sidebar. -->
                <uic:SurfaceCard CornerRadius="14"/>

                <DockPanel LastChildFill="True">

                    <!-- === CHROME / TITLE BAR (frameless; brand left, close right) == -->
                    <Border DockPanel.Dock="Top" Height="36" Name="ChromeBar"
                            Background="Transparent" PointerPressed="OnChromePressed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        Margin="14,0,0,0" VerticalAlignment="Center">
                                <!-- macOS: traffic lights LEFT (min/zoom greyed, dialog-style). -->
                                <uic:WindowControls ShowMinimize="False" ShowMaximize="False"
                                                    IsVisible="{x:Static uic:Platform.IsMac}"
                                                    Margin="0,0,4,0"/>
                                <!-- Tool-window chrome convention: each secondary
                                     window leads with ITS OWN glyph, plain white on transparent - like
                                     SpectrumWindow (bars + "SPECTRUM") - NOT the app brand chip. Same
                                     gear path as the main chrome's settings button. -->
                                <Path Stretch="Uniform" Width="15" Height="15"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="White" StrokeThickness="1.2"
                                      StrokeJoin="Round" Fill="Transparent"
                                      Data="M 7,0 L 9,0 L 9.5,2 L 11.5,2.5 L 13,1.3 L 14.7,3 L 13.5,4.5 L 14,6.5 L 16,7 L 16,9 L 14,9.5 L 13.5,11.5 L 14.7,13 L 13,14.7 L 11.5,13.5 L 9.5,14 L 9,16 L 7,16 L 6.5,14 L 4.5,13.5 L 3,14.7 L 1.3,13 L 2.5,11.5 L 2,9.5 L 0,9 L 0,7 L 2,6.5 L 2.5,4.5 L 1.3,3 L 3,1.3 L 4.5,2.5 L 6.5,2 Z M 8,5.5 A 2.5,2.5 0 1 0 8,10.5 A 2.5,2.5 0 1 0 8,5.5 Z"/>
                                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" LetterSpacing="2"
                                           Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource HairlineBrush}" Width="1" Height="16" Margin="2,0"/>
                                <TextBlock Classes="label" Text="JUST STREAM" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="cap close" Click="OnClose" ToolTip.Tip="Close"
                                    IsVisible="{x:Static uic:Platform.IsNotMac}">
                                <Path Stretch="None" Width="10" Height="10"
                                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                                      Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- === BODY == -->
                    <Grid Margin="18,4,18,16" RowDefinitions="Auto,*">

                        <!-- Shared underline tabs (App.axaml Button.tab / Border.tabline) -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="tab"
                                        Classes.active="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Server}"
                                        Command="{Binding SetSettingsTabCommand}" CommandParameter="Server">
                                    <Panel>
                                        <TextBlock Text="Server" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <Border Classes="tabline"/>
                                    </Panel>
                                </Button>
                                <Button Classes="tab"
                                        Classes.active="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Look}"
                                        Command="{Binding SetSettingsTabCommand}" CommandParameter="Look">
                                    <Panel>
                                        <TextBlock Text="Look" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <Border Classes="tabline"/>
                                    </Panel>
                                </Button>
                                <Button Classes="tab"
                                        Classes.active="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Recording}"
                                        Command="{Binding SetSettingsTabCommand}" CommandParameter="Recording">
                                    <Panel>
                                        <TextBlock Text="Recording" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <Border Classes="tabline"/>
                                    </Panel>
                                </Button>
                                <Button Classes="tab"
                                        Classes.active="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Advanced}"
                                        Command="{Binding SetSettingsTabCommand}" CommandParameter="Advanced">
                                    <Panel>
                                        <TextBlock Text="Advanced" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <Border Classes="tabline"/>
                                    </Panel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- === SERVER - de-boxed: list - vertical hairline - form === -->
                        <Grid Grid.Row="1"
                              IsVisible="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Server}"
                              RowDefinitions="Auto,*" Margin="0,14,0,0">
                            <!-- On-air lock: editing connection details mid-broadcast is blocked. This NEUTRAL
                                 banner (no red) stays readable - it sits OUTSIDE the disabled content grid below. -->
                            <Border Grid.Row="0" IsVisible="{Binding Stream.IsConnected}" Margin="0,0,0,12"
                                    Background="#14FFFFFF" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <!-- Padlock as a shipped vector, not a lock character (CLAUDE.md rule 5) -
                                     it also picks up MutedBrush now, which the emoji never did. -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <uic:JustIcon Kind="Lock" Width="13" Height="13" Margin="0,0,8,0"
                                                  Foreground="{StaticResource MutedBrush}"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock Text="On air - stop the stream to edit server settings."
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" IsEnabled="{Binding CanEditServers}" ColumnDefinitions="210,1,*">
                            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                                <Border DockPanel.Dock="Bottom" Background="#16000000" CornerRadius="9" Padding="3"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                        <Button Classes="seg" Content="+ ADD" Command="{Binding AddServerCommand}"/>
                                        <Button Classes="seg" Content="DUP" Command="{Binding DuplicateServerCommand}"/>
                                        <Button Classes="seg" Content="DEL" Command="{Binding RemoveServerCommand}"/>
                                    </StackPanel>
                                </Border>
                                <ListBox Classes="servers" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:StreamServerProfile">
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Border Grid.Column="1" Background="{StaticResource HairlineBrush}" Width="1" Margin="0,2"/>

                            <!-- Padding right: a gutter so the (overlay) vertical scrollbar sits BESIDE the
                                 fields, not over them, once the station-info rows make the form overflow. -->
                            <ScrollViewer Grid.Column="2" Margin="16,0,0,0" Padding="0,0,14,0"
                                          IsEnabled="{Binding Editing, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <!-- x:CompileBindings=False: Editing.Port (int->TextBox.Text) + enum/int ComboBox needs coercion. -->
                                <Grid x:CompileBindings="False" ColumnDefinitions="96,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      VerticalAlignment="Top">
                                    <!-- UpdateSourceTrigger=LostFocus: commit on blur, not per keystroke - so typing isn't
                                         interrupted by the collection-replace in OnEditingChanged (the focus-loss bug). -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="NAME" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Editing.Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="HOST" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Editing.Host, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="PORT" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Editing.Port, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="MOUNT" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Editing.Mount, UpdateSourceTrigger=LostFocus}" PlaceholderText="/live.mp3" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="USERNAME" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Editing.Username, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="PASSWORD" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding Editing.Password, UpdateSourceTrigger=LostFocus}" PasswordChar="-" Margin="0,0,0,8"/>

                                    <!-- CODEC + BITRATE -> main page (quality settings). PROTOCOL removed too:
                                         the connect is AUTO now (tries PUT, falls back to SOURCE). -->

                                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="TLS / SSL" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding Editing.UseTls}" OnContent="" OffContent="" Margin="0,0,0,8"/>

                                    <!-- Station info (ICY directory fields) - all optional, all the DJ's. We fill NOTHING
                                         promotional ourselves; these are exactly the fields a spammy encoder would cram, so
                                         we hand them to the DJ. Website=ice-url, Genre=ice-genre, Description=ice-description,
                                         Public=ice-public (YP directory listing). See BassBroadcastService / StreamServerProfile. -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Classes="label" Opacity="0.65"
                                               Text="STATION INFO - OPTIONAL, SHOWN IN PLAYERS &amp; DIRECTORY" Margin="0,6,0,10"/>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Classes="label" Text="WEBSITE" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="8" Grid.Column="1" Text="{Binding Editing.Url, UpdateSourceTrigger=LostFocus}" PlaceholderText="https://..." Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Classes="label" Text="GENRE" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="9" Grid.Column="1" Text="{Binding Editing.Genre, UpdateSourceTrigger=LostFocus}" PlaceholderText="Hard Dance" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="10" Grid.Column="0" Classes="label" Text="DESCRIPTION" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="10" Grid.Column="1" Text="{Binding Editing.Description, UpdateSourceTrigger=LostFocus}" PlaceholderText="One line about your stream" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="11" Grid.Column="0" Classes="label" Text="PUBLIC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ToggleSwitch Grid.Row="11" Grid.Column="1" IsChecked="{Binding Editing.IsPublic}" OnContent="" OffContent=""
                                                  ToolTip.Tip="List this stream in the server's public directory (YP). Off keeps a club/private stream unlisted."/>
                                </Grid>
                            </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- === LOOK - theme palette picker (mirrors TweaksPanel's Look tab in JUST PLAY) === -->
                        <StackPanel Grid.Row="1" Spacing="14" Margin="0,16,0,0" VerticalAlignment="Top"
                                    IsVisible="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Look}"
                                    ClipToBounds="False">
                            <StackPanel Spacing="8" ClipToBounds="False">
                                <TextBlock Classes="label" Text="THEME"/>
                                <!-- Swatch row - same chip size/lift/glow as JUST PLAY (JustStyles: Border.swatch / Button.swatchbtn). -->
                                <StackPanel Orientation="Horizontal" Spacing="10" ClipToBounds="False">
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Aurora">
                                        <theming:ThemeSwatchChip ThemeName="Aurora"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Aurora}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Sunset">
                                        <theming:ThemeSwatchChip ThemeName="Sunset"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Sunset}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Midnight">
                                        <theming:ThemeSwatchChip ThemeName="Midnight"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Midnight}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Onyx">
                                        <theming:ThemeSwatchChip ThemeName="Onyx"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Onyx}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Neon">
                                        <theming:ThemeSwatchChip ThemeName="Neon"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Neon}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Hardcore">
                                        <theming:ThemeSwatchChip ThemeName="Hardcore"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Hardcore}"/>
                                    </Button>
                                </StackPanel>
                                <!-- Tracks HOVER preview (live resource), not just the committed theme. -->
                                <TextBlock Text="{DynamicResource DisplayThemeName}" FontSize="10"
                                           Foreground="#73FFFFFF" LetterSpacing="2"/>
                            </StackPanel>

                            <Border Classes="sep"/>

                            <!-- Bottom keyboard-hint bar (the C/R legend) - on by default, off for pros. -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding Stream.ShowKeyHints}" OnContent="" OffContent=""/>
                                    <TextBlock Classes="label" Text="KEYBOARD HINTS" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Classes="hint"
                                           Text="The bottom shortcut bar. Hide it once the keys stick."/>
                            </StackPanel>
                            <Border Classes="sep"/>

                            <!-- Display-sleep guard while the session is hot (StreamViewModel.UpdateKeepAwake). -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding Stream.KeepScreenAwake}" OnContent="" OffContent=""/>
                                    <TextBlock Classes="label" Text="KEEP SCREEN AWAKE" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Classes="hint"
                                           Text="While you are on air or recording, the screen never blanks and the screensaver stays off - DJ software only sees the controller, so the OS thinks you left. Off air, your normal energy settings apply."/>
                            </StackPanel>
                        </StackPanel>

                        <!-- === RECORDING - format / folder / auto-record ("record your set") === -->
                        <StackPanel Grid.Row="1" Spacing="14" Margin="0,16,0,0" VerticalAlignment="Top"
                                    IsVisible="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Recording}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="label" Text="FORMAT"/>
                                <!-- x:CompileBindings=False: SelectedItem binds an enum VM property (same
                                     pattern as the CODEC ComboBox on the main page). -->
                                <ComboBox x:CompileBindings="False" HorizontalAlignment="Left" MinWidth="280"
                                          ItemsSource="{Binding Stream.RecordingFormats}"
                                          SelectedItem="{Binding Stream.RecordingFormat}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static vm:RecordingFormatLabelConverter.Instance}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="hint"
                                           Text="Same as stream mirrors the live codec + bitrate - the honest self-check: the file sounds exactly like your broadcast, artifacts included. Pick MP3 320 or a lossless format for a keeper copy."/>
                            </StackPanel>
                            <Border Classes="sep"/>
                            <StackPanel Spacing="8">
                                <TextBlock Classes="label" Text="FOLDER"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <!-- Empty box = the default folder (shown as the placeholder). -->
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Stream.RecordingFolder, UpdateSourceTrigger=LostFocus}"
                                             PlaceholderText="{Binding Stream.DefaultRecordingFolder}"/>
                                    <Button Grid.Column="1" Classes="seg" Content="BROWSE..." Margin="8,0,0,0"
                                            Click="OnBrowseRecordingFolder" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <Border Classes="sep"/>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding Stream.TrimSilence}" OnContent="" OffContent=""/>
                                    <TextBlock Classes="label" Text="AUTO-TRIM SILENCE" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Classes="hint"
                                           Text="You usually go on air first and start the music later - this keeps the dead air out of the file entirely. REC arms the recorder; the file starts on the first beat and ends on the last, with zero silence at either end. Short breaks (up to 30 s) stay in the mix untouched; anything longer is cut. A recording that never saw any audio is discarded."/>
                            </StackPanel>
                            <Border Classes="sep"/>
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding Stream.AutoRecord}" OnContent="" OffContent=""/>
                                    <TextBlock Classes="label" Text="AUTO-RECORD WHILE ON AIR" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Classes="hint"
                                           Text="Starts the recorder with CONNECT and saves the file on DISCONNECT - nobody remembers to hit record at gig start. If the connection drops, the recording keeps running so the set is never lost."/>
                            </StackPanel>
                        </StackPanel>

                        <!-- === ADVANCED - de-boxed, hairline-separated rows === -->
                        <StackPanel Grid.Row="1" Spacing="14" Margin="0,16,0,0" VerticalAlignment="Top"
                                    IsVisible="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Advanced}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch IsChecked="{Binding Stream.KeepScreenAwake}" OnContent="" OffContent=""/>
                                    <TextBlock Classes="label" Text="KEEP SCREEN AWAKE WHILE ON AIR" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Classes="hint"
                                           Text="Your hands are on the controller, not the keyboard - the OS thinks you're idle and blanks the screen mid-set (Traktor won't stop it either). While you're on air or recording, JUST STREAM keeps the display awake; disconnect, and your normal screensaver policy is back."/>
                            </StackPanel>
                            <Border Classes="sep"/>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="label" Text="AUTO-RECONNECT"/>
                                <TextBlock Classes="hint"
                                           Text="Automatic. If the connection drops, JUST STREAM retries with exponential backoff (2 s -> 30 s) until the stream is back - or you hit DISCONNECT. On-air time keeps counting and a running set recording is never interrupted."/>
                            </StackPanel>
                            <Border Classes="sep"/>
                            <!-- Background=Transparent makes the WHOLE row a right-click target (a
                                 backgroundless panel doesn't hit-test its empty space). Mirrors the REC
                                 button's "Open recordings folder". -->
                            <StackPanel Spacing="3" Background="Transparent"
                                        ToolTip.Tip="Right-click to open this folder in Explorer">
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open in Explorer" Click="OnOpenSettingsFolder"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Classes="label" Text="SETTINGS &amp; LOG FOLDER"/>
                                <TextBlock Classes="mono" FontSize="12" Text="%LOCALAPPDATA%\JustStream"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Classes="hint" Margin="0,4,0,0"
                                           Text="The event log is saved here as a daily file (session-YYYY-MM-DD.log) and kept for 7 days, so you can look back at a set - when the stream dropped and reconnected, what was recorded. settings.json and any crash logs live here too."/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Panel>
        </Border>
    </Panel>
</Window>
