<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JustPlay.Stream.ViewModels"
        xmlns:models="using:JustPlay.Core.Models"
        xmlns:theming="using:JustPlay.UI.Theming"
        x:Class="JustPlay.Stream.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="JUST STREAM — Settings"
        Width="784" Height="544"
        CanResize="False"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner">

    <!-- Themed server-list rows — mirrors JUST PLAY's queue ListBoxItem (MaxView.axaml): flat
         white hover, theme-driven accent swipe on selected (AccentCRow/AccentBRow recolour per
         theme), rounded. Replaces the bare Fluent default that clashed with the dark card. -->
    <Window.Styles>
        <Style Selector="ListBox.servers ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF"/>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="{DynamicResource AccentCRow}"/>
                    <GradientStop Offset="0.6" Color="{DynamicResource AccentBRow}"/>
                    <GradientStop Offset="1"   Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ListBox.servers ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Offset="0"   Color="{DynamicResource AccentCRowHover}"/>
                    <GradientStop Offset="0.6" Color="{DynamicResource AccentBRowHover}"/>
                    <GradientStop Offset="1"   Color="#00000000"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- Frameless rounded dialog — same shell as the main console + JUST PLAY (no classic title bar). -->
    <Panel>
        <Border CornerRadius="14" ClipToBounds="False"
                Margin="20,20,20,22"
                Background="#40000000"
                BoxShadow="0 18 50 -12 #B0000000">
            <Panel>
                <Rectangle Fill="{StaticResource BgLinear}" RadiusX="14" RadiusY="14"/>
                <Rectangle Fill="{StaticResource BgGlowA}"   RadiusX="14" RadiusY="14"/>
                <Rectangle Fill="{StaticResource BgGlowB}"   RadiusX="14" RadiusY="14"/>

                <DockPanel LastChildFill="True">

                    <!-- ─── CHROME / TITLE BAR (frameless; brand left, close right) ── -->
                    <Border DockPanel.Dock="Top" Height="36" Name="ChromeBar"
                            Background="Transparent" PointerPressed="OnChromePressed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        Margin="14,0,0,0" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="5"
                                        Background="{StaticResource AccentGradient}">
                                    <Path Stretch="Uniform" Width="11" Height="11"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="White" StrokeThickness="1.8"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          Data="M4.9 16.1 C1 12.2 1 5.8 4.9 1.9
                                                M7.8 4.7 a6.14 6.14 0 0 0 -.8 7.5
                                                M10 9 A2 2 0 1 0 14 9 A2 2 0 1 0 10 9
                                                M16.2 4.8 c2 2 2.26 5.11 .8 7.47
                                                M19.1 1.9 a9.96 9.96 0 0 1 0 14.1
                                                M9.5 18 h5
                                                M8 22 l4 -11 l4 11"/>
                                </Border>
                                <TextBlock Classes="brand" Text="SETTINGS" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource HairlineBrush}" Width="1" Height="16" Margin="2,0"/>
                                <TextBlock Classes="label" Text="JUST STREAM" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="cap close" Click="OnClose" ToolTip.Tip="Close">
                                <Path Stretch="None" Width="10" Height="10"
                                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1"
                                      Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ─── BODY ── -->
                    <Grid Margin="18,4,18,16" RowDefinitions="Auto,*">

                        <!-- Shared underline tabs (App.axaml Button.tab / Border.tabline) -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="tab"
                                        Classes.active="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Server}"
                                        Command="{Binding SetSettingsTabCommand}" CommandParameter="Server">
                                    <Panel>
                                        <TextBlock Text="Server" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <Border Classes="tabline"/>
                                    </Panel>
                                </Button>
                                <Button Classes="tab"
                                        Classes.active="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Look}"
                                        Command="{Binding SetSettingsTabCommand}" CommandParameter="Look">
                                    <Panel>
                                        <TextBlock Text="Look" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <Border Classes="tabline"/>
                                    </Panel>
                                </Button>
                                <Button Classes="tab"
                                        Classes.active="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Advanced}"
                                        Command="{Binding SetSettingsTabCommand}" CommandParameter="Advanced">
                                    <Panel>
                                        <TextBlock Text="Advanced" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <Border Classes="tabline"/>
                                    </Panel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- ═══ SERVER — de-boxed: list · vertical hairline · form ═══ -->
                        <Grid Grid.Row="1"
                              IsVisible="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Server}"
                              RowDefinitions="Auto,*" Margin="0,14,0,0">
                            <!-- On-air lock: editing connection details mid-broadcast is blocked. This NEUTRAL
                                 banner (no red) stays readable — it sits OUTSIDE the disabled content grid below. -->
                            <Border Grid.Row="0" IsVisible="{Binding Stream.IsConnected}" Margin="0,0,0,12"
                                    Background="#14FFFFFF" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <TextBlock Text="🔒  On air — stop the stream to edit server settings."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Border>
                            <Grid Grid.Row="1" IsEnabled="{Binding CanEditServers}" ColumnDefinitions="210,1,*">
                            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                                <Border DockPanel.Dock="Bottom" Background="#16000000" CornerRadius="9" Padding="3"
                                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                        <Button Classes="seg" Content="+ ADD" Command="{Binding AddServerCommand}"/>
                                        <Button Classes="seg" Content="DUP" Command="{Binding DuplicateServerCommand}"/>
                                        <Button Classes="seg" Content="DEL" Command="{Binding RemoveServerCommand}"/>
                                    </StackPanel>
                                </Border>
                                <ListBox Classes="servers" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:StreamServerProfile">
                                            <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <Border Grid.Column="1" Background="{StaticResource HairlineBrush}" Width="1" Margin="0,2"/>

                            <ScrollViewer Grid.Column="2" Margin="16,0,0,0"
                                          IsEnabled="{Binding Editing, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <!-- x:CompileBindings=False: Editing.Port (int→TextBox.Text) + enum/int ComboBox needs coercion. -->
                                <Grid x:CompileBindings="False" ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      VerticalAlignment="Top">
                                    <!-- UpdateSourceTrigger=LostFocus: commit on blur, not per keystroke — so typing isn't
                                         interrupted by the collection-replace in OnEditingChanged (the focus-loss bug). -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="NAME" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Editing.Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="HOST" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Editing.Host, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="PORT" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Editing.Port, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="MOUNT" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Editing.Mount, UpdateSourceTrigger=LostFocus}" PlaceholderText="/live.mp3" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="USERNAME" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Editing.Username, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="PASSWORD" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                    <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding Editing.Password, UpdateSourceTrigger=LostFocus}" PasswordChar="•" Margin="0,0,0,8"/>

                                    <!-- CODEC + BITRATE → main page (quality settings). PROTOCOL removed too:
                                         the connect is AUTO now (tries PUT, falls back to SOURCE). -->

                                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="TLS / SSL" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ToggleSwitch Grid.Row="6" Grid.Column="1" IsChecked="{Binding Editing.UseTls}" OnContent="" OffContent=""/>
                                </Grid>
                            </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- ═══ LOOK — theme palette picker (mirrors TweaksPanel's Look tab in JUST PLAY) ═══ -->
                        <StackPanel Grid.Row="1" Spacing="14" Margin="0,16,0,0" VerticalAlignment="Top"
                                    IsVisible="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Look}"
                                    ClipToBounds="False">
                            <StackPanel Spacing="8" ClipToBounds="False">
                                <TextBlock Classes="label" Text="THEME"/>
                                <!-- Swatch row — same chip size/lift/glow as JUST PLAY (JustStyles: Border.swatch / Button.swatchbtn). -->
                                <StackPanel Orientation="Horizontal" Spacing="10" ClipToBounds="False">
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Aurora">
                                        <theming:ThemeSwatchChip ThemeName="Aurora"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Aurora}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Sunset">
                                        <theming:ThemeSwatchChip ThemeName="Sunset"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Sunset}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Midnight">
                                        <theming:ThemeSwatchChip ThemeName="Midnight"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Midnight}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Onyx">
                                        <theming:ThemeSwatchChip ThemeName="Onyx"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Onyx}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Neon">
                                        <theming:ThemeSwatchChip ThemeName="Neon"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Neon}"/>
                                    </Button>
                                    <Button Classes="swatchbtn" Command="{Binding SetThemeCommand}" CommandParameter="Hardcore">
                                        <theming:ThemeSwatchChip ThemeName="Hardcore"
                                                IsActive="{Binding CurrentTheme, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Hardcore}"/>
                                    </Button>
                                </StackPanel>
                                <!-- Tracks HOVER preview (live resource), not just the committed theme. -->
                                <TextBlock Text="{DynamicResource DisplayThemeName}" FontSize="10"
                                           Foreground="#73FFFFFF" LetterSpacing="2"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ═══ ADVANCED — de-boxed, hairline-separated rows ═══ -->
                        <StackPanel Grid.Row="1" Spacing="14" Margin="0,16,0,0" VerticalAlignment="Top"
                                    IsVisible="{Binding SettingsTab, Converter={x:Static vm:StringEqualsConverter.Instance}, ConverterParameter=Advanced}">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="label" Text="AUTO-RECONNECT"/>
                                <TextBlock Classes="value" Text="Planned — exponential backoff on dropped connections."
                                           Foreground="{StaticResource MutedBrush}" FontWeight="Normal"/>
                            </StackPanel>
                            <Border Classes="sep"/>
                            <StackPanel Spacing="3">
                                <TextBlock Classes="label" Text="SETTINGS &amp; LOG FOLDER"/>
                                <TextBlock Classes="mono" FontSize="12" Text="%LOCALAPPDATA%\JustStream"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Panel>
        </Border>
    </Panel>
</Window>
