<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Ships as "JustStream.exe" — sibling product to JustPlay. RootNamespace stays
         JustPlay.Stream so x:Class / clr-namespace references resolve. -->
    <AssemblyName>JustStream</AssemblyName>
    <AssemblyTitle>JUST STREAM</AssemblyTitle>
    <Product>JUST STREAM</Product>
    <Company>Chloe Dream</Company>
    <!-- Static Win32 exe icon (Explorer / shortcuts) = the JUST STREAM brand mark, Aurora theme +
         radio-tower glyph. Generated from BrandGlyphs.RadioTower via build/make-stream-icon (SkiaSharp).
         The live taskbar/title-bar icon is still rendered per-theme by ThemedWindowIcon at runtime. -->
    <ApplicationIcon>Assets\juststream.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
  </ItemGroup>

  <!-- Reuses the shared, platform-agnostic Core + the BASS adapter (capture engine + broadcast
       service + bus DSP rack) + JustPlay.UI (the shared suite UI lib: chrome, caption buttons,
       themed icon, theme engine). No reference to JustPlay.App — JUST STREAM is its own front end;
       genuinely shared UI lives in JustPlay.UI, NOT copied from the player. The native BASS DLLs
       (bass/bassmix/bassenc/bassenc_mp3) flow in transitively from JustPlay.Audio.Bass. -->
  <ItemGroup>
    <ProjectReference Include="..\JustPlay.Core\JustPlay.Core.csproj" />
    <ProjectReference Include="..\JustPlay.Audio.Bass\JustPlay.Audio.Bass.csproj" />
    <ProjectReference Include="..\JustPlay.Analysis\JustPlay.Analysis.csproj" />
    <ProjectReference Include="..\JustPlay.UI\JustPlay.UI.csproj" />
  </ItemGroup>
</Project>
