<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:beh="using:JustPlay.UI.Behaviors"
        xmlns:theming="using:JustPlay.UI.Theming"
        x:Class="JustPlay.UI.Theming.JustStyles">
    <!--
      ════════════════════════════════════════════════════════════════════════
      J.U.S.T. SUITE — SHARED CONTROL STYLES (chrome, tabs, cursor, text)
      ════════════════════════════════════════════════════════════════════════
      The look that EVERY JUST app shares, written once. JUST PLAY is the
      reference; these are lifted verbatim from its App.axaml. App-specific control
      styles (the player transport, broadcast meters, dialog buttons, …) stay in
      each app's own App.axaml and layer AFTER this include, so an app can still
      add or extend (e.g. JUST PLAY's Button.cap.streaming / .update).

      Consumes the shared palette (JustPalette) via DynamicResource — merge that
      dictionary into Application.Resources alongside this StyleInclude.
    -->

    <!--
      Global text styling:
      • ClipToBounds=False: descenders (y, g, p, J, Y…) sometimes get cut by tight
        bounding boxes. Letting TextBlock render past its own bounds is the cheap fix.
      • DropShadowEffect: a soft 1-px black drop under every TextBlock — keeps glyphs
        legible against the aurora background and gives the UI a "lifted" feel. Kept
        small (blur 2, opacity .45) to stay cheap even on dense lists.
    -->
    <Style Selector="TextBlock">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
        </Setter>
    </Style>

    <!--
      Kill the default TAB focus traversal + keyboard focus ring in EVERY window of the suite.
      Avalonia's built-in navigation moves focus on Tab before any handler we add and ignores
      e.Handled, so we suppress it via the KeyboardNav behavior (restores focus on Tab → no-op).
      A view that REPURPOSES Tab (the PRE CUE FINDER's folders/files switch) opts out with
      beh:KeyboardNav.SuppressTab="False". :is(Window) so it also matches every derived window
      (MainWindow, dialogs, …). Chloe 2026-07-06: "default Tab raus, aus allen Apps/Sichten."
    -->
    <Style Selector=":is(Window)">
        <Setter Property="(beh:KeyboardNav.SuppressTab)" Value="True"/>
    </Style>

    <!--
      Hand cursor on everything clickable — web-style affordance. Covers the control
      types that represent a click action; clickable TextBlocks set Cursor="Hand"
      inline where they live.
    -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!--
      Frameless-window CHROME — square 36×36 caption buttons (pair with the shared
      WindowControls), transparent until hovered, dark grey on hover, Close goes red.
      Path icons inside Content scale via the button's Foreground so hover brightens
      the glyph too.
    -->
    <Style Selector="Button.cap">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B3FFFFFF"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.cap:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>
    <Style Selector="Button.cap:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.cap:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>
    <!--
      The close button sits in the TOP-RIGHT corner. Without this corner radius its
      hover/pressed background paints a square red that sticks out past the card's
      rounded top-right corner (CornerRadius=14 on the card Border). Matching the
      top-right radius keeps the hover red flush inside the rounded window edge.
    -->
    <Style Selector="Button.cap.close">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E81123"/>
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.close:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.cap.close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#A21020"/>
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <!--
      macOS: the caption buttons sit LEFT (traffic lights), so an ordinary cap button ends
      up in the top-right corner instead of the close button — same square-hover-vs-rounded-
      card problem as above. The "corner" class is assigned from code-behind on macOS only
      (it can move at runtime, e.g. JUST PLAY's update badge appearing right of the log).
    -->
    <Style Selector="Button.cap.corner">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.corner:pointerover /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.corner:pressed /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>

    <!-- ════ Underline tabs (SHARED) ════
         A Button with Classes="tab" (add "active", or bind Classes.active) whose Content is
         a Panel holding the label (top) + a <Border Classes="tabline"/> (bottom). No frame,
         no hover fill — just an accent-gradient underline that spans the text width, with a
         glow when active. Used by JUST PLAY (UP NEXT / Lyrics, Tweaks panel) and JUST STREAM
         (settings) so the two products look like one family. -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="2,8,14,0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="#73FFFFFF"/>
    </Style>
    <Style Selector="Button.tab /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.tabline">
        <Setter Property="Height" Value="2"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,-1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab.active Border.tabline">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="{DynamicResource AccentB}" BlurRadius="11" OffsetX="0" OffsetY="0" Opacity="1"/>
        </Setter>
    </Style>

    <!--
      Shared dialog button — pill, dark translucent, hover lift. Used by the suite's frameless
      dialog windows (the shared About, and JUST PLAY's Transfer / InputDialog). Overriding the
      pointerover/pressed ContentPresenter background keeps FluentTheme's accent from leaking
      through (the documented custom-button quirk).
    -->
    <Style Selector="Button.dialog-close">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="28,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.dialog-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2EFFFFFF"/>
    </Style>
    <Style Selector="Button.dialog-close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <!--
      "ghost" variant — a de-emphasised dialog action (e.g. "Ignore this version" sitting to the
      left of the primary). Transparent until hover, muted text, tighter padding so a long label
      doesn't crowd the primary actions. Pair with Classes="dialog-close ghost".
    -->
    <Style Selector="Button.dialog-close.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#80FFFFFF"/>
        <Setter Property="Padding" Value="6,9"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="Button.dialog-close.ghost /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.dialog-close.ghost:pointerover">
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
    </Style>
    <Style Selector="Button.dialog-close.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!--
      Shared fader look — used by JUST PLAY (EQ + Revive sliders in TweaksPanel) and JUST STREAM
      (EQ + AutoTilt + Punch + Gain + Monitor faders). Lifted verbatim from TweaksPanel so the two
      products share one implementation. WHITE thumb — theme-independent, not the OS SystemAccent
      which rendered wrong (red) on Chloe's Midnight theme. AccentABrush fills the value side
      (PART_DecreaseButton); a faint groove sits past the thumb (PART_IncreaseButton). Selectors
      no-op when a part is absent (i.e., the opposite orientation's template parts are simply missing).

      Classes to apply:
        Classes="eq fader"  — for EQ-range sliders (Minimum=0, Maximum=2, kill/flat/+6dB)
        Classes="fader"     — for all other themed sliders (0..1 range, gain, monitor)
    -->
    <!-- Mouse-wheel nudges every themed fader (one shared behaviour, both apps) — the operation must
         feel identical in JUST PLAY and JUST STREAM. 2.5%/notch. -->
    <Style Selector="Slider.fader">
        <Setter Property="beh:SliderWheel.Enabled" Value="True"/>
    </Style>

    <!-- EQ geometry only (Minimum/Maximum). The visual look comes from Slider.fader.
         NO explicit Width: a vertical Fluent Slider's track lives in an Auto middle column
         with MinWidth 32 (SliderVerticalWidth, verified against release/12.0.3
         Themes.Fluent/Controls/Slider.xaml). Forcing the Slider narrower than that (the old
         Width=30) under-sizes the track so its optical centre drifts off the centred label.
         Letting it size naturally — exactly like JUST STREAM's faders — keeps track and label
         on the same centre. -->
    <Style Selector="Slider.eq">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider.fader /template/ Thumb">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="Black" BlurRadius="4" OffsetX="0" OffsetY="1" Opacity="0.4"/>
        </Setter>
    </Style>
    <Style Selector="Slider.fader /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource AccentABrush}"/>
    </Style>
    <Style Selector="Slider.fader /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>

    <!--
      Round transparent transport buttons + filled icon glyphs (seek / play / pause / add …).
      Born in the Pre-Cue Finder's player bar, lifted here (2026-07-12) so every JUST app uses
      the SAME transport buttons instead of re-inventing them (JUST BOOTLEG was the second
      consumer). Glyphs are FILLED Path.xicon in a shared ~9×10 box + Uniform stretch, so
      play / pause / seek all render the exact same size (the text-glyph size trap, 2026-07-07).

      Classes to apply:
        Button Classes="xport"  — the round hover-brightening button (30×30)
        Path   Classes="xicon"  — the glyph inside (Fill follows the button's Foreground)
    -->
    <Style Selector="Button.xport">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#D9FFFFFF"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.xport /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.xport:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#16FFFFFF"/>
    </Style>
    <Style Selector="Button.xport:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.xport:disabled">
        <Setter Property="Foreground" Value="#4DFFFFFF"/>
    </Style>
    <Style Selector="Path.xicon">
        <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
      Palette swatch (chip) — coloured ring + accent glow when active. Used by JUST PLAY's
      TweaksPanel and JUST STREAM's SettingsWindow Look tab. Defined here (shared) so the two
      products stay visually identical without duplicating the swatch/swatchbtn styles.
    -->
    <!--
      Swatches now carry the theme's BACKGROUND gradient (dark) so the picker can't tell the ACTIVE
      one apart by fill (same dark as the card). The selection cue is a RING in the swatch's OWN
      highlight colour (BorderBrush set inline per swatch via {theming:ThemeAccent <Name>}): the active
      theme shows it persistently; every other swatch shows it only on hover. The ring is toggled by
      growing BorderThickness 0→2 (the colour is the inline per-theme accent), so each swatch lights in
      ITS theme's highlight, not the globally-active one. (Chloe 2026-06-30.)
    -->
    <Style Selector="Border.swatch">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- ACTIVE theme: persistent ring in its own highlight colour (the inline per-theme accent). -->
    <Style Selector="Border.swatch.active">
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <!--
      Wrapper button for each swatch. ClipToBounds=False lets the active chip's DropShadowEffect
      glow bleed past the button bounds (the Fluent ContentPresenter clip would crop it otherwise).
    -->
    <Style Selector="Button.swatchbtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector="Button.swatchbtn /template/ ContentPresenter">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.swatchbtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.swatchbtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Hover any swatch (incl. non-active): lift + show ITS highlight ring (inline per-theme accent). -->
    <Style Selector="Button.swatchbtn:pointerover Border.swatch">
        <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.swatchbtn:pressed Border.swatch">
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
    </Style>

    <!--
      Codec/bitrate segmented radio buttons — shared look for the CodecBitrateEditor
      (JustPlay.UI.Views) used on JUST STREAM's main page. Identical to the locally-scoped
      fmt-radio/bps-radio styles in JustPlay.App/Controls/StreamingPanel.axaml; lifted here
      so the suite shares one definition without duplicating markup.
      Active state (Classes.active) fills with the theme's AccentGradient so it follows
      live theme switches without any extra wiring (DynamicResource).
    -->
    <Style Selector="Button.fmt-radio">
        <Setter Property="Background" Value="#0FFFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Foreground" Value="#B3FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.fmt-radio.active">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.bps-radio">
        <Setter Property="Background" Value="#0FFFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="#B3FFFFFF"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.bps-radio.active">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!--
      Shared TextBox optical-centering padding (both apps). Our fields rarely contain descenders
      (g/j/y/p), so mathematically-centred text READS as floating too high. Nudge it down: a touch
      MORE padding on top, LESS on bottom. Padding only (no VerticalContentAlignment) so multi-line
      boxes (e.g. the log) stay top-aligned. Class-scoped fields (stream-field, the input dialog) carry
      the same asymmetry locally. Tune the 8/5 split if it ever feels off.
    -->
    <Style Selector="TextBox">
        <Setter Property="Padding" Value="11,8,11,5"/>
    </Style>

    <!--
      Fluent gives a FOCUSED TextBox a bold accent border (TextControlBorderBrushFocused) — which on
      the red-accent Hardcore theme reads as a harsh RED outline — and an ERRORED one a hard red border
      (SystemControlErrorTextForegroundBrush). Both clash with our calm hairline fields. Replace them,
      suite-wide, with a subtle brighter hairline that just lifts a touch on focus (Chloe 2026-07-05:
      "focus suchfeld - roter rand" — UI is mine to own). Part verified = PART_BorderElement against the
      Avalonia 12.0.3 Fluent TextBox template.
    -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Segmented / compact action button (limiter-drive segments, the device-rescan ↻, log show/clear)
         — SHARED so JUST PLAY + STREAM use the IDENTICAL control. Moved here from STREAM's App.axaml
         ("lens-seg"); theme brushes via DynamicResource so it tracks live theme switches. -->
    <Style Selector="Button.seg">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedDimBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.seg /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>
    <Style Selector="Button.seg.active">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.seg.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentCBrush}"/>
    </Style>

    <!--
      Theme-picker swatch chip (shared, all apps) — see ThemeSwatchChip.cs. A 46×46 rounded square split
      on the bottom-left→top-right diagonal: PART_Bg (a Border) carries the theme BACKGROUND gradient over
      the whole face; PART_Accent (the upper-left triangle, Polygon points (0,0)(46,0)(0,46)) sits on top
      with the theme accent gradient; PART_Card is the per-theme ring; the glow + hover-zoom are from code.

      LAYERS (avalonia skill — verified): PART_Glow is a sibling BEHIND, NOT clipped, so its BoxShadow
      bloom escapes; PART_Bg is the ONLY ClipToBounds=True element (rounds the corners + the diagonal).
      Pitfalls that bit earlier cuts: (1) a DropShadowEffect on the control rasterised it offscreen →
      aliased edges + the glow vanished — use BoxShadow on the unclipped sibling instead; (2) a stroke-less
      Rectangle as the bg field measures to ~0 and renders NOTHING (black void) — use a Border.Background.
      (Chloe 2026-06-30.)
    -->
    <Style Selector="theming|ThemeSwatchChip">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <!-- Glow sibling BEHIND, never clipped — its BoxShadow blooms (set from code when lit). -->
                    <Border Name="PART_Glow" CornerRadius="10" Background="Transparent" ClipToBounds="False"/>
                    <!-- The chip FACE: PART_Bg.Background = the theme BACKGROUND gradient (a Border fills
                         reliably; a stroke-less Rectangle measures to ~0 and renders nothing). The accent
                         triangle sits on top; ClipToBounds rounds the corners + the diagonal. The ONLY clip. -->
                    <Border Name="PART_Bg" CornerRadius="10" ClipToBounds="True">
                        <Polygon Name="PART_Accent" Points="0,0 46,0 0,46"/>
                    </Border>
                    <!-- Per-theme ring on top. -->
                    <Border Name="PART_Card" CornerRadius="10" BorderThickness="1.5"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ═══ Hint / explainer text (shared) ═══
         The small description paragraphs under settings controls. A subtle 1-px drop shadow
         lifts the text off the aurora glow — readability fix for the bright/green themes
         (Chloe 2026-07-05: "mehr weiß, weniger durchsichtig + text drop shadow"). -->
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource MutedFaintBrush}"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.55"/>
        </Setter>
    </Style>

    <!-- ═══ Keyboard-hint chip + label (shared) ═══
         The little key-cap + its action label, used by the shared KeyLegend bar (PRE CUE FINDER +
         JUST STREAM) and the finder's F1 help overlay. Lifted here so there's ONE definition
         (Chloe 2026-07-06: "ein Guss — reused funktionality"). -->
    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.kbd &gt; TextBlock">
        <Setter Property="Foreground" Value="#BFFFFFFF"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.kbdlabel">
        <Setter Property="Foreground" Value="{DynamicResource MutedDimBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
      ═══ Vertical scrollbar — the SUITE pill (shared) ═══
      The JUST PLAY queue scrollbar, lifted VERBATIM from MaxView so every JUST window (the
      queue, the PRE CUE FINDER, JUST STREAM's log/settings) shows the identical thin white
      pill instead of the fat grey Fluent bar (Chloe 2026-07-05: "einfach wie die liste in
      JUST PLAY … immer so machen wie immer"). FULL CUSTOM TEMPLATE because `/template/`
      overrides of the Fluent scrollbar didn't win reliably (dark track, square thumb, line
      buttons all slipped through). With our own ControlTemplate we own the tree end-to-end:

      • Root Grid transparent — no painted track strip.
      • DecreaseButton / IncreaseButton: opacity-0 RepeatButtons (still page-scrollable, invisible).
      • Thumb: its OWN template — one Border, CornerRadius 3 (= half of the 6-px width → a pill).
      • NO line buttons (top/bottom chevrons) — simply absent from the template.
      • Bar floats FLUSH at the right edge (no horizontal margin); the gap to content comes from
        each list's row right-margin (16 in the queue + finder). BOTH orientations are themed the
        same way (the horizontal one shows e.g. in the Event Log's no-wrap text box).
    -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <!-- Hidden by default; fades in only while the scroll area is hovered OR holds focus (Chloe
             2026-07-07). Our own opacity-driven hide (the two selectors below), NOT Avalonia's AllowAutoHide,
             so it works with this fully-custom template. -->
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           IsDirectionReversed="True"
                           Orientation="Vertical">
                        <Track.DecreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb MinHeight="32" Background="#80FFFFFF">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
        <Setter Property="Background" Value="#BFFFFFFF"/>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
        <Setter Property="Background" Value="#E6FFFFFF"/>
    </Style>
    <!-- Show the pill while the containing scroll area is moused-over or holds keyboard focus; it fades
         back out otherwise (descendant selectors reach the ScrollBar inside any ScrollViewer, incl. the
         ListBox's internal one, so folder/file lists + the INFO/FILTER panes all behave the same). -->
    <Style Selector="ScrollViewer:pointerover ScrollBar:vertical">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ScrollViewer:focus-within ScrollBar:vertical">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <!-- ⚠ And the bar's OWN hover, which is what keeps it alive while you DRAG it. The rule above
         alone loses the bar mid-drag: the pill is 6 px flush at the right edge, so sliding a few
         pixels sideways while holding the thumb takes the pointer out of the ScrollViewer, the
         condition goes false, and the thing you are holding fades away under your hand (Chloe
         2026-07-31: "pack ich die scrollbar und drag scrolle - verschwindet diese"). During a drag
         the Thumb holds pointer CAPTURE, so the ScrollBar stays pointer-over wherever the mouse
         goes — this selector is true for the whole drag, off-edge included. -->
    <Style Selector="ScrollBar:vertical:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ScrollBar:horizontal:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Horizontal bar — same slim pill as vertical, laid on its side (Height 6, Orientation Horizontal,
         Thumb MinWidth). Shows in no-wrap scroll areas like the Event Log. Chloe 2026-07-08. -->
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="Margin" Value="4,0,4,0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="Horizontal">
                        <Track.DecreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb MinWidth="32" Background="#80FFFFFF">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb:pointerover">
        <Setter Property="Background" Value="#BFFFFFFF"/>
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb:pressed">
        <Setter Property="Background" Value="#E6FFFFFF"/>
    </Style>
    <Style Selector="ScrollViewer:pointerover ScrollBar:horizontal">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ScrollViewer:focus-within ScrollBar:horizontal">
        <Setter Property="Opacity" Value="1"/>
    </Style>
</Styles>
