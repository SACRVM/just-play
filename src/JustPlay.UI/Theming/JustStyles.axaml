<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:beh="using:JustPlay.UI.Behaviors"
        xmlns:controls="using:JustPlay.UI.Controls"
        xmlns:theming="using:JustPlay.UI.Theming"
        x:Class="JustPlay.UI.Theming.JustStyles">
    <!--
      ========================================================================
      J.U.S.T. SUITE - SHARED CONTROL STYLES (chrome, tabs, cursor, text)
      ========================================================================
      The look that EVERY JUST app shares, written once. JUST PLAY is the
      reference; these are lifted verbatim from its App.axaml. App-specific control
      styles (the player transport, broadcast meters, dialog buttons, ...) stay in
      each app's own App.axaml and layer AFTER this include, so an app can still
      add or extend (e.g. JUST PLAY's Button.cap.streaming / .update).

      Consumes the shared palette (JustPalette) via DynamicResource - merge that
      dictionary into Application.Resources alongside this StyleInclude.
    -->

    <!--
      Global text styling:
      - ClipToBounds=False: descenders (y, g, p, J, Y...) sometimes get cut by tight
        bounding boxes. Letting TextBlock render past its own bounds is the cheap fix.
      - DropShadowEffect: a soft 1-px black drop under every TextBlock - keeps glyphs
        legible against the aurora background and gives the UI a "lifted" feel. Kept
        small (blur 2, opacity .45) to stay cheap even on dense lists.
    -->
    <Style Selector="TextBlock">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.45"/>
        </Setter>
    </Style>

    <!--
      Kill the default TAB focus traversal + keyboard focus ring in EVERY window of the suite.
      Avalonia's built-in navigation moves focus on Tab before any handler we add and ignores
      e.Handled, so we suppress it via the KeyboardNav behavior (restores focus on Tab -> no-op).
      A view that REPURPOSES Tab (the PRE CUE FINDER's folders/files switch) opts out with
      beh:KeyboardNav.SuppressTab="False". :is(Window) so it also matches every derived window
      (MainWindow, dialogs, ...) so default Tab focus/ring is suppressed everywhere, across every
      app and view.
    -->
    <Style Selector=":is(Window)">
        <Setter Property="(beh:KeyboardNav.SuppressTab)" Value="True"/>
    </Style>

    <!--
      Hand cursor on everything clickable - web-style affordance. Covers the control
      types that represent a click action; clickable TextBlocks set Cursor="Hand"
      inline where they live.
    -->
    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--
      ComboBox - the SUITE default, not a per-app chore. FluentTheme paints an open dropdown's
      hover/selected rows with the Windows SYSTEM ACCENT, which on this machine is RED and has
      now shown up in three different apps. JUST PLAY (device-picker) and JUST STREAM each carry
      their own identical copy of this fix; putting it in the shared sheet means the next app
      cannot forget it. Those two keep working unchanged - their local rules set the same values.
    -->
    <Style Selector="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="#16FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
    </Style>
    <Style Selector="ComboBox /template/ Popup Border">
        <Setter Property="Background" Value="#F01a1828"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ComboBox ComboBoxItem">
        <Setter Property="Foreground" Value="#E6FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ComboBox ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>
    <Style Selector="ComboBox ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="ComboBox ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!--
      ========================================================================
      THE WINDOW CARD - rounded, shadowed ... and SQUARE when maximized
      ========================================================================
      Every JUST window is one Border named RootCard: a rounded card inside a transparent margin
      that the drop shadow blooms into (and that hosts the resize grips). Maximized, all three of
      those have to go - full screen means filling the screen.

      (!) THE DEFAULTS LIVE HERE, AS STYLES, ON PURPOSE. They used to sit INLINE on the Border
      (Margin="20,20,20,22" CornerRadius="14" BoxShadow="..."), and an inline value is
      BindingPriority.LocalValue = 0, which beats StyleTrigger - verified against Avalonia
      release/12.0.3, src/Avalonia.Base/Data/BindingPriority.cs. So the .maximized setters below
      could never win, in ANY of the four windows, and maximizing left the transparent frame and
      the rounded corners exactly where they were. It is the same precedence trap CLAUDE.md already records for BoxShadow inside a
      ControlTemplate. With both states at style priority, the class selector wins because it comes
      later and is more specific.

      Per-app values that are NOT state-dependent (Background, ClipToBounds) stay on the element.
    -->
    <Style Selector="Border#RootCard">
        <Setter Property="Margin" Value="20,20,20,22"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BoxShadow" Value="{DynamicResource WindowOuter}"/>
    </Style>
    <!-- The layered background rectangles carry the card's radius themselves (the card is
         ClipToBounds=False so a glow can bloom past its edge), so they square off too. -->
    <Style Selector="Border#RootCard &gt; Panel &gt; Rectangle">
        <Setter Property="RadiusX" Value="14"/>
        <Setter Property="RadiusY" Value="14"/>
    </Style>
    <Style Selector="Border#RootCard.maximized">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>
    <Style Selector="Border#RootCard.maximized &gt; Panel &gt; Rectangle">
        <Setter Property="RadiusX" Value="0"/>
        <Setter Property="RadiusY" Value="0"/>
    </Style>
    <!-- The 1-px hairline outline drawn over the card edge (the finder and JUST TAG have one) -
         it traces the same corner and has to square off with it. -->
    <Style Selector="Border#RootCard Border.cardedge">
        <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Border#RootCard.maximized Border.cardedge">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!--
      ========================================================================
      PANEL CLOSE (x) - the corner of a slide-in panel, shared
      ========================================================================
      Both slide-in panels - JUST PLAY's TWEAKS and JUST TAG's SETTINGS - close from a x in their
      top-right corner, and the two did NOT look the same.

      (!) The cause is worth knowing, because it is still live elsewhere: both were written as
      Classes="ghost", but `Button.ghost` is declared SEPARATELY in each app's App.axaml and the two
      declarations are different controls. JUST PLAY's is a bare transparent icon button (padding 8,
      no border, #A6FFFFFF at 15); JUST TAG's is a filled pill (#0FFFFFFF, 1 px border, radius 8,
      12 SemiBold). Same class name, two meanings - so "use the same class" quietly produced two
      different buttons. Values below are JUST PLAY's, verbatim, because that is the reference.

      This fixes the x. It does NOT fix `Button.ghost` itself, which still means two things in two
      apps and will bite again - that wants a rename pass, not a patch smuggled in here.
    -->
    <Style Selector="Button.panelclose">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Foreground" Value="#A6FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.panelclose:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!--
      ========================================================================
      THE DIALOG CARD - a window card, one level higher
      ========================================================================
      Every JUST dialog is one Border named DialogCard. Same shape as Border#RootCard above, and for
      the same reason these live as STYLES and not as inline attributes: an inline value is
      BindingPriority.LocalValue and would beat anything a selector wants to say later.

      What makes it a dialog rather than a window is exactly two things, and both are deliberate:
      the FLAT SurfaceCard fill inside it (windows carry the gradient ramp plus two accent blooms),
      and DialogOuter - a deeper, darker shadow, so it reads as floating ABOVE the app instead of
      lying in the same plane. The bottom margin is 26 because that is what DialogOuter needs to fade
      out instead of clipping at the window edge; the two are a pair, change them together.
    -->
    <Style Selector="Border#DialogCard">
        <Setter Property="Margin" Value="20,20,20,26"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BoxShadow" Value="{DynamicResource DialogOuter}"/>
    </Style>

    <!--
      ========================================================================
      THE LIFTED SURFACE - controls:SurfaceCard (dialogs + slide-in panels)
      ========================================================================
      ONE flat fill + the hairline edge - see JustPalette.axaml for why flat is the point and
      not a shortcut (a low-contrast gradient bands on a tall narrow panel; Avalonia does not
      dither gradient fills).

      ClipToBounds stays False, matching the window card above ("so a glow can bloom past its
      edge") and the Border this replaced, which never set it either. Worth knowing before anyone
      "fixes" it: Border implements IVisualWithRoundRectClip (ClipToBoundsRadius => CornerRadius,
      verified against Avalonia release/12.0.3, src/Avalonia.Controls/Border.cs), so its clip is
      rounded - but ONLY when ClipToBounds is switched on. Off is a choice here, not an oversight.
    -->
    <Style Selector="controls|SurfaceCard">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceEdge}"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource SurfaceFill}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--
      ========================================================================
      CAUTION NOTE - a legitimate choice with a consequence worth naming
      ========================================================================
      The frosted-card vocabulary (radius 9, hairline edge) in the warm sand of the Caution*
      tokens. NOT red - the thing being flagged is a setting somebody meant to choose, not an
      error; NOT the accent - the accent means "selected/active" here, and a caution borrowing
      it would read as a chosen state.

      Three users today, all saying the SAME fact in the same words (see
      ViewModels/Id3ConversionNotice): the ID3 write-format card in JUST TAG's settings, the
      per-file notice above Save in the shared TagEditorPanel, and the RAW TAGS window.

      (!) It lived in JUST TAG's own App.axaml, which the shared library cannot see - so
      RawTagsWindow had to repeat all five setters inline, and the notice could not be shared at
      all. Its Caution* COLOURS had already moved into JustPalette; the style follows them here so
      the last per-app copy is gone.
    -->
    <Style Selector="Border.caution">
        <Setter Property="Background" Value="{DynamicResource CautionSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CautionEdgeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="13,11"/>
    </Style>
    <Style Selector="TextBlock.cautiontitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource CautionBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Body + the "how to avoid it" line: plain muted text, so the tone stays calm. -->
    <Style Selector="TextBlock.cautionbody">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.cautionfix">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedDimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--
      Frameless-window CHROME - square 36x36 caption buttons (pair with the shared
      WindowControls), transparent until hovered, dark grey on hover, Close goes red.
      Path icons inside Content scale via the button's Foreground so hover brightens
      the glyph too.
    -->
    <Style Selector="Button.cap">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#B3FFFFFF"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.cap:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>
    <Style Selector="Button.cap:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.cap:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>
    <!--
      The close button sits in the TOP-RIGHT corner. Without this corner radius its
      hover/pressed background paints a square red that sticks out past the card's
      rounded top-right corner (CornerRadius=14 on the card Border). Matching the
      top-right radius keeps the hover red flush inside the rounded window edge.
    -->
    <Style Selector="Button.cap.close">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E81123"/>
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.close:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.cap.close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#A21020"/>
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <!--
      macOS: the caption buttons sit LEFT (traffic lights), so an ordinary cap button ends
      up in the top-right corner instead of the close button - same square-hover-vs-rounded-
      card problem as above. The "corner" class is assigned from code-behind on macOS only
      (it can move at runtime, e.g. JUST PLAY's update badge appearing right of the log).
    -->
    <Style Selector="Button.cap.corner">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.corner:pointerover /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>
    <Style Selector="Button.cap.corner:pressed /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0,14,0,0"/>
    </Style>

    <!-- (!) MAXIMIZED: these MUST come AFTER the rules above. Avalonia has no CSS specificity -
         among styles of equal priority the LAST matching setter wins, so a "more specific"
         selector placed earlier loses to a plainer one placed later. That is exactly how the
         close button stayed rounded in full screen after the card itself had been squared off.
         Maximized there is no corner left to match,
         so the button and its hover/pressed fills - which carry their own radius on the templated
         ContentPresenter - all square off. -->
    <Style Selector="Border#RootCard.maximized Button.cap.close">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border#RootCard.maximized Button.cap.close:pointerover /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border#RootCard.maximized Button.cap.close:pressed /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <!-- macOS puts the caption buttons LEFT, so the top-right corner belongs to whatever sits there
         (JUST PLAY's log / update badge, JUST STREAM's gear) via Button.cap.corner. Same rule. -->
    <Style Selector="Border#RootCard.maximized Button.cap.corner:pointerover /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border#RootCard.maximized Button.cap.corner:pressed /template/ ContentPresenter">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- ==== Underline tabs (SHARED) ====
         A Button with Classes="tab" (add "active", or bind Classes.active) whose Content is
         a Panel holding the label (top) + a <Border Classes="tabline"/> (bottom). No frame,
         no hover fill - just an accent-gradient underline that spans the text width, with a
         glow when active. Used by JUST PLAY (UP NEXT / Lyrics, Tweaks panel) and JUST STREAM
         (settings) so the two products look like one family. -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="2,8,14,0"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="#73FFFFFF"/>
    </Style>
    <Style Selector="Button.tab /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.tabline">
        <Setter Property="Height" Value="2"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,-1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tab.active Border.tabline">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="{DynamicResource AccentB}" BlurRadius="11" OffsetX="0" OffsetY="0" Opacity="1"/>
        </Setter>
    </Style>

    <!--
      Shared dialog button - pill, dark translucent, hover lift. Used by the suite's frameless
      dialog windows (the shared About, and JUST PLAY's Transfer / InputDialog). Overriding the
      pointerover/pressed ContentPresenter background keeps FluentTheme's accent from leaking
      through (the documented custom-button quirk).
    -->
    <Style Selector="Button.dialog-close">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="28,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.dialog-close:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2EFFFFFF"/>
    </Style>
    <Style Selector="Button.dialog-close:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <!--
      "ghost" variant - a de-emphasised dialog action (e.g. "Ignore this version" sitting to the
      left of the primary). Transparent until hover, muted text, tighter padding so a long label
      doesn't crowd the primary actions. Pair with Classes="dialog-close ghost".
    -->
    <Style Selector="Button.dialog-close.ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#80FFFFFF"/>
        <Setter Property="Padding" Value="6,9"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="Button.dialog-close.ghost /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.dialog-close.ghost:pointerover">
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
    </Style>
    <Style Selector="Button.dialog-close.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!--
      Shared text LINK - a credit or an address that opens in the browser (the About card's author
      line today). Deliberately not underlined: the suite's dialogs are quiet, and the accent colour
      plus the hand cursor already say "this is clickable" without adding a second visual language.
      Foreground is the muted text tone so it sits at the weight of the line it replaces, and lifts
      to the theme accent on hover. The three ContentPresenter overrides are the documented
      FluentTheme quirk - without them the accent fill leaks through on hover and pressed.
    -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.link:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
    </Style>
    <Style Selector="Button.link:pressed">
        <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
        <Setter Property="Opacity" Value="0.75"/>
    </Style>

    <!--
      Shared fader look - used by JUST PLAY (EQ + Revive sliders in TweaksPanel) and JUST STREAM
      (EQ + AutoTilt + Punch + Gain + Monitor faders). Lifted verbatim from TweaksPanel so the two
      products share one implementation. WHITE thumb - theme-independent, not the OS SystemAccent
      which rendered wrong (red) on the Midnight theme. AccentABrush fills the value side
      (PART_DecreaseButton); a faint groove sits past the thumb (PART_IncreaseButton). Selectors
      no-op when a part is absent (i.e., the opposite orientation's template parts are simply missing).

      Classes to apply:
        Classes="eq fader"  - for EQ-range sliders (Minimum=0, Maximum=2, kill/flat/+6dB)
        Classes="fader"     - for all other themed sliders (0..1 range, gain, monitor)
    -->
    <!-- Mouse-wheel nudges every themed fader (one shared behaviour, both apps) - the operation must
         feel identical in JUST PLAY and JUST STREAM. 2.5%/notch. -->
    <Style Selector="Slider.fader">
        <Setter Property="beh:SliderWheel.Enabled" Value="True"/>
    </Style>

    <!-- EQ geometry only (Minimum/Maximum). The visual look comes from Slider.fader.
         NO explicit Width: a vertical Fluent Slider's track lives in an Auto middle column
         with MinWidth 32 (SliderVerticalWidth, verified against release/12.0.3
         Themes.Fluent/Controls/Slider.xaml). Forcing the Slider narrower than that (the old
         Width=30) under-sizes the track so its optical centre drifts off the centred label.
         Letting it size naturally - exactly like JUST STREAM's faders - keeps track and label
         on the same centre. -->
    <Style Selector="Slider.eq">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider.fader /template/ Thumb">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="Black" BlurRadius="4" OffsetX="0" OffsetY="1" Opacity="0.4"/>
        </Setter>
    </Style>
    <Style Selector="Slider.fader /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource AccentABrush}"/>
    </Style>
    <Style Selector="Slider.fader /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>

    <!--
      Round transparent transport buttons + filled icon glyphs (seek / play / pause / add ...).
      Born in the Pre-Cue Finder's player bar, lifted here (2026-07-12) so every JUST app uses
      the SAME transport buttons instead of re-inventing them (JUST BOOTLEG was the second
      consumer). Glyphs are FILLED Path.xicon in a shared ~9x10 box + Uniform stretch, so
      play / pause / seek all render the exact same size (the text-glyph size trap, 2026-07-07).

      Classes to apply:
        Button Classes="xport"  - the round hover-brightening button (30x30)
        Path   Classes="xicon"  - the glyph inside (Fill follows the button's Foreground)
    -->
    <Style Selector="Button.xport">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#D9FFFFFF"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.xport /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.xport:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#16FFFFFF"/>
    </Style>
    <Style Selector="Button.xport:pointerover">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.xport:disabled">
        <Setter Property="Foreground" Value="#4DFFFFFF"/>
    </Style>
    <Style Selector="Path.xicon">
        <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
      Palette swatch (chip) - coloured ring + accent glow when active. Used by JUST PLAY's
      TweaksPanel and JUST STREAM's SettingsWindow Look tab. Defined here (shared) so the two
      products stay visually identical without duplicating the swatch/swatchbtn styles.
    -->
    <!--
      Swatches now carry the theme's BACKGROUND gradient (dark) so the picker can't tell the ACTIVE
      one apart by fill (same dark as the card). The selection cue is a RING in the swatch's OWN
      highlight colour (BorderBrush set inline per swatch via {theming:ThemeAccent <Name>}): the active
      theme shows it persistently; every other swatch shows it only on hover. The ring is toggled by
      growing BorderThickness 0->2 (the colour is the inline per-theme accent), so each swatch lights in
      ITS theme's highlight, not the globally-active one.
    -->
    <Style Selector="Border.swatch">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransform" Value="none"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- ACTIVE theme: persistent ring in its own highlight colour (the inline per-theme accent). -->
    <Style Selector="Border.swatch.active">
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <!--
      Wrapper button for each swatch. ClipToBounds=False lets the active chip's DropShadowEffect
      glow bleed past the button bounds (the Fluent ContentPresenter clip would crop it otherwise).
    -->
    <Style Selector="Button.swatchbtn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="ClipToBounds" Value="False"/>
    </Style>
    <Style Selector="Button.swatchbtn /template/ ContentPresenter">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.swatchbtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.swatchbtn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- Hover any swatch (incl. non-active): lift + show ITS highlight ring (inline per-theme accent). -->
    <Style Selector="Button.swatchbtn:pointerover Border.swatch">
        <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.swatchbtn:pressed Border.swatch">
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
    </Style>

    <!--
      Codec/bitrate segmented radio buttons - shared look for the CodecBitrateEditor
      (JustPlay.UI.Views) used on JUST STREAM's main page. Identical to the locally-scoped
      fmt-radio/bps-radio styles in JustPlay.App/Controls/StreamingPanel.axaml; lifted here
      so the suite shares one definition without duplicating markup.
      Active state (Classes.active) fills with the theme's AccentGradient so it follows
      live theme switches without any extra wiring (DynamicResource).
    -->
    <Style Selector="Button.fmt-radio">
        <Setter Property="Background" Value="#0FFFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Foreground" Value="#B3FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.fmt-radio.active">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style Selector="Button.bps-radio">
        <Setter Property="Background" Value="#0FFFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="#B3FFFFFF"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.bps-radio.active">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!--
      Shared TextBox optical-centering padding (both apps). Our fields rarely contain descenders
      (g/j/y/p), so mathematically-centred text READS as floating too high. Nudge it down: a touch
      MORE padding on top, LESS on bottom. Padding only (no VerticalContentAlignment) so multi-line
      boxes (e.g. the log) stay top-aligned. Class-scoped fields (stream-field, the input dialog) carry
      the same asymmetry locally. Tune the 8/5 split if it ever feels off.
    -->
    <Style Selector="TextBox">
        <Setter Property="Padding" Value="11,8,11,5"/>
    </Style>

    <!--
      Fluent gives a FOCUSED TextBox a bold accent border (TextControlBorderBrushFocused) - which on
      the red-accent Hardcore theme reads as a harsh RED outline - and an ERRORED one a hard red border
      (SystemControlErrorTextForegroundBrush). Both clash with our calm hairline fields. Replace them,
      suite-wide, with a subtle brighter hairline that just lifts a touch on focus. Part verified = PART_BorderElement against the
      Avalonia 12.0.3 Fluent TextBox template.
    -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox:error /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Segmented / compact action button (limiter-drive segments, the device-rescan refresh, log show/clear)
         - SHARED so JUST PLAY + STREAM use the IDENTICAL control. Moved here from STREAM's App.axaml
         ("lens-seg"); theme brushes via DynamicResource so it tracks live theme switches. -->
    <Style Selector="Button.seg">
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedDimBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.seg /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>
    <Style Selector="Button.seg.active">
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.seg.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentCBrush}"/>
    </Style>

    <!--
      Theme-picker swatch chip (shared, all apps) - see ThemeSwatchChip.cs. A 46x46 rounded square split
      on the bottom-left->top-right diagonal: PART_Bg (a Border) carries the theme BACKGROUND gradient over
      the whole face; PART_Accent (the upper-left triangle, Polygon points (0,0)(46,0)(0,46)) sits on top
      with the theme accent gradient; PART_Card is the per-theme ring; the glow + hover-zoom are from code.

      LAYERS (avalonia skill - verified): PART_Glow is a sibling BEHIND, NOT clipped, so its BoxShadow
      bloom escapes; PART_Bg is the ONLY ClipToBounds=True element (rounds the corners + the diagonal).
      Pitfalls that bit earlier cuts: (1) a DropShadowEffect on the control rasterised it offscreen ->
      aliased edges + the glow vanished - use BoxShadow on the unclipped sibling instead; (2) a stroke-less
      Rectangle as the bg field measures to ~0 and renders NOTHING (black void) - use a Border.Background.
      (2026-06-30.)
    -->
    <Style Selector="theming|ThemeSwatchChip">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <!-- Glow sibling BEHIND, never clipped - its BoxShadow blooms (set from code when lit). -->
                    <Border Name="PART_Glow" CornerRadius="10" Background="Transparent" ClipToBounds="False"/>
                    <!-- The chip FACE: PART_Bg.Background = the theme BACKGROUND gradient (a Border fills
                         reliably; a stroke-less Rectangle measures to ~0 and renders nothing). The accent
                         triangle sits on top; ClipToBounds rounds the corners + the diagonal. The ONLY clip. -->
                    <Border Name="PART_Bg" CornerRadius="10" ClipToBounds="True">
                        <Polygon Name="PART_Accent" Points="0,0 46,0 0,46"/>
                    </Border>
                    <!-- Per-theme ring on top. -->
                    <Border Name="PART_Card" CornerRadius="10" BorderThickness="1.5"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- === Hint / explainer text (shared) ===
         The small description paragraphs under settings controls. A subtle 1-px drop shadow
         lifts the text off the aurora glow - readability fix for the bright/green themes, which
         also called for whiter, less transparent hint text. -->
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource MutedFaintBrush}"/>
        <Setter Property="Effect">
            <DropShadowEffect Color="Black" BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.55"/>
        </Setter>
    </Style>

    <!-- === Keyboard-hint chip + label (shared) ===
         The little key-cap + its action label, used by the shared KeyLegend bar (PRE CUE FINDER +
         JUST STREAM) and the finder's F1 help overlay. Lifted here so there's ONE definition. -->
    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.kbd &gt; TextBlock">
        <Setter Property="Foreground" Value="#BFFFFFFF"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style Selector="TextBlock.kbdlabel">
        <Setter Property="Foreground" Value="{DynamicResource MutedDimBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
      === Vertical scrollbar - the SUITE pill (shared) ===
      The JUST PLAY queue scrollbar, lifted VERBATIM from MaxView so every JUST window (the
      queue, the PRE CUE FINDER, JUST STREAM's log/settings) shows the identical thin white
      pill instead of the fat grey Fluent bar. FULL CUSTOM TEMPLATE because `/template/`
      overrides of the Fluent scrollbar didn't win reliably (dark track, square thumb, line
      buttons all slipped through). With our own ControlTemplate we own the tree end-to-end:

      - Root Grid transparent - no painted track strip.
      - DecreaseButton / IncreaseButton: opacity-0 RepeatButtons (still page-scrollable, invisible).
      - Thumb: its OWN template - one Border, CornerRadius 3 (= half of the 6-px width -> a pill).
      - NO line buttons (top/bottom chevrons) - simply absent from the template.
      - Bar floats FLUSH at the right edge (no horizontal margin); the gap to content comes from
        each list's row right-margin (16 in the queue + finder). BOTH orientations are themed the
        same way (the horizontal one shows e.g. in the Event Log's no-wrap text box).
    -->
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
        <!-- Hidden by default; fades in only while the scroll area is hovered OR holds focus.
             Our own opacity-driven hide (the two selectors below), NOT Avalonia's AllowAutoHide,
             so it works with this fully-custom template. -->
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           IsDirectionReversed="True"
                           Orientation="Vertical">
                        <Track.DecreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb MinHeight="32" Background="#80FFFFFF">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
        <Setter Property="Background" Value="#BFFFFFFF"/>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
        <Setter Property="Background" Value="#E6FFFFFF"/>
    </Style>
    <!-- Show the pill while the containing scroll area is moused-over or holds keyboard focus; it fades
         back out otherwise (descendant selectors reach the ScrollBar inside any ScrollViewer, incl. the
         ListBox's internal one, so folder/file lists + the INFO/FILTER panes all behave the same). -->
    <Style Selector="ScrollViewer:pointerover ScrollBar:vertical">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ScrollViewer:focus-within ScrollBar:vertical">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <!-- (!) And the bar's OWN hover, which is what keeps it alive while you DRAG it. The rule above
         alone loses the bar mid-drag: the pill is 6 px flush at the right edge, so sliding a few
         pixels sideways while holding the thumb takes the pointer out of the ScrollViewer, the
         condition goes false, and the thing you are holding fades away under your hand. During a drag
         the Thumb holds pointer CAPTURE, so the ScrollBar stays pointer-over wherever the mouse
         goes - this selector is true for the whole drag, off-edge included. -->
    <Style Selector="ScrollBar:vertical:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ScrollBar:horizontal:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!-- Horizontal bar - same slim pill as vertical, laid on its side (Height 6, Orientation Horizontal,
         Thumb MinWidth). Shows in no-wrap scroll areas like the Event Log. -->
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="Margin" Value="4,0,4,0"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="Transparent">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="Horizontal">
                        <Track.DecreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          Opacity="0"/>
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb MinWidth="32" Background="#80FFFFFF">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb:pointerover">
        <Setter Property="Background" Value="#BFFFFFFF"/>
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb:pressed">
        <Setter Property="Background" Value="#E6FFFFFF"/>
    </Style>
    <Style Selector="ScrollViewer:pointerover ScrollBar:horizontal">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="ScrollViewer:focus-within ScrollBar:horizontal">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!--
      ========================================================================
      TRACK-ROW CELLS - the styling the shared TrackRow needs, wherever it runs
      ========================================================================
      These belong WITH the control (JustPlay.UI/Controls/TrackRow.axaml), not with
      whichever app happens to host it. They lived in JUST PLAY's App.axaml until the
      row moved here (2026-08-05) - a second app rendering the row would otherwise have
      had to copy them, which is exactly the drift this refactor exists to end.
    -->

    <!--
      ========================================================================
      EDITABLE FIELD - the frosted box, its tick and its clear button
      ========================================================================
      The LOOK of an input, one definition for the suite. TagFieldBox composes it (caption, tick,
      input, X) and the tag editor's file-name row reuses the same three classes for its mask picker,
      so a ComboBox in a field position is the same object as a TextBox in one.

      It lives here rather than inside TagFieldBox because two different controls wear it. The values
      were written out TWICE before this (once for a plain TextBox, once for the inner TextBox of an
      AutoCompleteBox, which has no InnerLeftContent slot to hang a tick on - verified against
      Avalonia 12.0.3) and that duplication is what this replaces.
    -->
    <!--
      (!) THE VERTICAL PADDING IS 8/5, NOT 5/5, AND IT IS THE SUITE'S NUMBER - not a taste.

      A standard TextBox in this suite carries Padding 11,8,11,5 (see "Shared TextBox optical-centering
      padding" above): 13 px of vertical chrome plus 2 px of border on a ~15.6 px line box = ~30.6 px.
      The tag editor's fields sat at 5/5 and so came out ~27.6 - a THIRD field height in the same
      window, and one that also threw away the optical centring the shared style exists for (our
      fields rarely hold descenders, so mathematically-centred text reads as floating high).

      Matching it means there is one field height in the app. The horizontal 8 stays: the editor is a
      narrow pane and 11 costs it real room, which the vertical number does not.
    -->
    <Style Selector="Border.fieldbox">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="8,8,8,5"/>
    </Style>
    <Style Selector="Border.fieldbox:pointerover">
        <Setter Property="BorderBrush" Value="#33FFFFFF"/>
    </Style>
    <!-- focus-WITHIN, not focus: the element that takes the caret is the input INSIDE the border
         (and, for the genre box, inside AutoCompleteBox's template), so :focus would never fire on
         the border itself. Both pseudo-classes verified in Avalonia 12.0.3,
         src/Avalonia.Base/Input/InputElement.cs. -->
    <Style Selector="Border.fieldbox:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBBrush}"/>
    </Style>
    <!-- Not part of the save. The box says so by going quiet rather than by growing a second label. -->
    <Style Selector="Border.fieldbox.locked">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <!--
      The tick that puts a field in the save. Our own template with the shipped Check vector: the
      stock CheckBox is 32 px tall and would set the height of every field in the panel.
    -->
    <Style Selector="ToggleButton.fieldtick">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Tick" CornerRadius="4" BorderThickness="1"
                        Background="#0FFFFFFF" BorderBrush="#33FFFFFF">
                    <controls:JustIcon Name="TickMark" Kind="Check" Width="10" Height="10"
                                       Foreground="White" Opacity="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- State-dependent, so OUTSIDE the template - an inline value has LocalValue precedence and
         would beat these (see "Styles in App.axaml" in CLAUDE.md). -->
    <Style Selector="ToggleButton.fieldtick:pointerover /template/ Border#Tick">
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
    </Style>
    <Style Selector="ToggleButton.fieldtick:checked /template/ Border#Tick">
        <Setter Property="Background" Value="{DynamicResource AccentBBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBBrush}"/>
    </Style>
    <Style Selector="ToggleButton.fieldtick:checked /template/ controls|JustIcon#TickMark">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <!--
      The input that goes INSIDE a fieldbox, stripped of its own chrome - the Border around it is the
      field now. Two shapes, because the genre box needs suggestions and the rest do not; both end up
      looking like one thing, which is the point.
    -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#ECFFFFFF"/>
        <Setter Property="SelectionBrush" Value="#448a5fff"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- (!) The suite gives a focused TextBox a 1 px ring (see "Fluent gives a FOCUSED TextBox..."
         above). Inside a fieldbox that is a SECOND ring nested in the field's own, which is what made
         a focused mask box look wrong. The field owns the focus state here, so the inner one is
         switched off - for the error ring too, same reason. -->
    <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.bare:error /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!--
      (!!) AND the ERROR ADORNER, which is a different thing again. DataValidationErrors wraps the
      box INSIDE its template and draws Fluent's own red (SystemControlErrorTextForegroundBrush)
      around it - outside PART_BorderElement, so neutralising that border does not touch it. That is
      the red that kept flashing through a field while it was being typed in.

      It is given an empty template rather than a recoloured one on purpose: a field inside a
      fieldbox has its own way of saying something is wrong (the panel says it in words, next to the
      box), and the suite's rule is that the OS red is never allowed through - the same reason the
      focused-border colour above exists.
    -->
    <Style Selector="TextBox.bare">
        <Setter Property="(DataValidationErrors.ErrorTemplate)">
            <DataTemplate><Panel/></DataTemplate>
        </Setter>
    </Style>
    <Style Selector="AutoCompleteBox.bare">
        <Setter Property="(DataValidationErrors.ErrorTemplate)">
            <DataTemplate><Panel/></DataTemplate>
        </Setter>
    </Style>

    <Style Selector="AutoCompleteBox.bare">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="AutoCompleteBox.bare /template/ TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#ECFFFFFF"/>
        <Setter Property="SelectionBrush" Value="#448a5fff"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBBrush}"/>
    </Style>
    <!-- The suggestion list - never left in stock chrome. -->
    <Style Selector="AutoCompleteBox.bare /template/ ListBox">
        <Setter Property="Background" Value="#F01a1828"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MaxHeight" Value="220"/>
    </Style>
    <Style Selector="AutoCompleteBox.bare /template/ ListBox ListBoxItem">
        <Setter Property="Foreground" Value="#D9FFFFFF"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!--
      The X inside a field: empty it. Same mark as every other close in the suite, at field size.

      (!) 15, like the tick, and that is a CONSTRAINT rather than a taste: nothing inside a field may
      be taller than the text line beside it, or the control starts driving the field's height. At 17
      it did - a 13 px line box is about 15.6 px, so every ticked field came out ~1.4 px taller than
      the rest of the panel. Keep new in-field controls at
      or under 15.
    -->
    <Style Selector="Button.fieldclear">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.fieldclear /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.fieldclear:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1AFFFFFF"/>
    </Style>

    <!--
      TAG-EDITOR tab pill (TAGS | ANALYSIS, EDITOR | ANALYSIS | FILTER). A pill rather than an
      underline: these headers are narrow and sit inside rounded cards, where an underline reads as a
      stray rule. Shared because the switch belongs to each HOST's header now, not to the panel.
    -->
    <!-- Tab switch. A pill rather than an underline: the panel is narrow and lives inside a
         rounded card, where an underline reads as a stray rule. -->
    <Style Selector="Button.tag-tab">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="1.6"/>
        <Setter Property="Foreground" Value="#73FFFFFF"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- FluentTheme paints the templated ContentPresenter, so every state has to be answered
         explicitly or the pill flickers back to the stock hover grey. -->
    <Style Selector="Button.tag-tab /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.tag-tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0FFFFFFF"/>
    </Style>
    <Style Selector="Button.tag-tab:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Button.tag-tab.selected">
        <Setter Property="Foreground" Value="#F2FFFFFF"/>
    </Style>
    <Style Selector="Button.tag-tab.selected /template/ ContentPresenter">
        <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>
    <Style Selector="Button.tag-tab.selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#26FFFFFF"/>
    </Style>

    <!-- Column-header label - tracked caps. FlushTrailing reclaims the trailing letter-spacing so
         right/centre labels sit flush with the untracked row values below (single-source: derived from
         LetterSpacing). Shared, because each host draws its own leading NAME cell beside the strip and
         that label must be the identical one. -->
    <Style Selector="TextBlock.colhead">
        <Setter Property="Foreground" Value="#73FFFFFF"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="(controls:HeaderText.FlushTrailing)" Value="True"/>
    </Style>
    <!-- Active-sort arrow: smaller, snug, no tracking. Defined after .colhead so it wins on the shared
         cells. Collapses (IsVisible off the glyph) when unsorted, so unsorted headers reserve no arrow
         gap -> flush; when sorted, its left margin is the gap that hangs on the arrow. -->
    <Style Selector="TextBlock.sortarrow">
        <Setter Property="FontSize" Value="7"/>
        <Setter Property="LetterSpacing" Value="0"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- Collapse the arrow when this column isn't the active sort (glyph = "") so the empty slot
             + its StackPanel spacing don't leave a gap. Self-bound, so no call site has to remember it. -->
        <Setter Property="IsVisible"
                Value="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Style>
    <!-- The same arrow, as the SHIPPED VECTOR it is now (CLAUDE.md rule 5 - "^"/"v" were characters,
         and the font that draws a character is the OS's choice, not ours). Geometry, colour, size and
         the collapse-when-unsorted rule all live HERE, so a header only names the class and binds the
         Kind - which is why swapping two dozen call sites cost one line each. -->
    <Style Selector="controls|JustIcon.sortarrow">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Foreground" Value="#73FFFFFF"/>
        <Setter Property="Margin" Value="3,1,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsVisible"
                Value="{Binding $self.Kind, Converter={x:Static controls:IconConverters.IsSet}}"/>
    </Style>

    <!--
      PREP "GAIN" cell. Default + clip colour are BOTH styles (no inline Foreground): an inline
      value has LocalValue precedence and would beat the .gain-clip setter, so the red would
      silently never show (the documented Avalonia precedence trap). Red = the track would clip
      on playback (brick-walled, or a positive gain overflows) - see TrackViewModel.GainClips.
    -->
    <Style Selector="TextBlock.gain-cell">
        <Setter Property="Foreground" Value="#CCFFFFFF"/>
    </Style>
    <Style Selector="TextBlock.gain-cell.gain-clip">
        <Setter Property="Foreground" Value="#FF6B6B"/>
    </Style>

    <!-- LIKE-column heart: dim by default, accent when the track is favorited. -->
    <!-- The like heart - dim by default, theme accent once the track is liked. It is a shipped vector
         (controls:JustIcon), not a "heart": U+2665 is one of the characters Apple renders with EMOJI
         presentation by default, so on the Mac this cell would have gone red on its own, in a colour
         nobody chose. CLAUDE.md rule 5. -->
    <Style Selector="controls|JustIcon.likecell">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Foreground" Value="#33FFFFFF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="controls|JustIcon.likecell.active">
        <Setter Property="Foreground" Value="{DynamicResource AccentABrush}"/>
    </Style>
    <!-- Transparent, no-chrome, hand-cursor heart button so the heart cell is clickable in the row. -->
    <Style Selector="Button.heartcell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.heartcell /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
</Styles>
