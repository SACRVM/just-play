<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JustPlay.UI.Views.InputDialog"
        Title="Name"
        Width="360" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <Window.Styles>
        <!-- TextBox: themed edit field. Overrides SelectionBrush AND the focused PART_BorderElement so
             the Windows SYSTEM accent (red on this machine) never shows on selection / focus border. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="CornerRadius" Value="9"/>
            <!-- Optical centering: more top, less bottom (descender-poor text reads too high). -->
            <Setter Property="Padding" Value="10,9,10,6"/>
            <Setter Property="SelectionBrush" Value="#448a5fff"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        </Style>
    </Window.Styles>

    <!--
      Shared tiny themed text-input dialog (e.g. "name this preset"). Frameless rounded card matching the
      shared About dialog; NOT card-draggable so the TextBox stays clickable. ShowDialog returns the
      entered string (trimmed) or null on Cancel/empty — see InputDialog.AskAsync.
    -->
    <Border CornerRadius="16" Margin="14" ClipToBounds="True"
            BoxShadow="0 18 54 0 #B3000000">
        <Panel>
            <Rectangle Fill="{DynamicResource BgLinear}" RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowA}"   RadiusX="16" RadiusY="16"/>
            <Rectangle Fill="{DynamicResource BgGlowB}"   RadiusX="16" RadiusY="16"/>
            <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16"/>

            <StackPanel Margin="28,26,28,22" Spacing="0">
                <TextBlock x:Name="PromptText" Text="Name" FontSize="14" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBox x:Name="Input" Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Classes="dialog-close" Content="Cancel" Click="OnCancel"/>
                    <Button Classes="dialog-close" Content="OK" Click="OnOk"/>
                </StackPanel>
            </StackPanel>
        </Panel>
    </Border>
</Window>
