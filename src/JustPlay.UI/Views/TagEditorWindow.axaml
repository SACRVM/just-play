<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:JustPlay.UI.Controls"
        xmlns:vm="using:JustPlay.UI.ViewModels"
        x:Class="JustPlay.UI.Views.TagEditorWindow"
        x:DataType="vm:TagEditorViewModel"
        Title="Edit tags"
        Width="560" Height="780"
        MinWidth="480" MinHeight="440"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      The floating tag editor - ALWAYS ON TOP (Chloe 2026-08-02: "wir machen nen tag edit window -
      was immer im vordergrund bleibt"). Same frameless rounded card as the rest of the suite; the
      body is the SHARED TagEditorPanel, which JUST TAG will dock as its sidebar unchanged.

      ShowInTaskbar=False: this is a tool window belonging to the app that opened it, not a second
      entry to alt-tab through.

      WindowStartupLocation=CenterOwner is the FIRST-open rule. WindowPlacement only sets a
      position when it has a remembered one, so without this the very first open is a Manual
      window placed wherever the OS likes - which on two monitors is not the one you are
      working on (Chloe 2026-08-09). From the second open on, the remembered spot wins.
    -->

    <Panel>
        <Border Name="DialogCard" ClipToBounds="False"
                Background="#40000000">
            <Panel>
                <!-- The SHARED surface (JustPlay.UI SurfaceCard) - the flat slab every JUST dialog
                     and tool window carries, so it reads as its own object rather than as a second
                     main window. One definition for every one of them. -->
                <controls:SurfaceCard CornerRadius="14"/>

                <DockPanel LastChildFill="True">

                    <!-- === CHROME / TITLE BAR === -->
                    <Border DockPanel.Dock="Top" Height="36" Name="ChromeBar"
                            Background="Transparent" PointerPressed="OnChromePressed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- 16 = the card inset the body below carries, so the tag mark, the label
                                 and the first field all start on one line. It was 14, which put the
                                 chrome 2 px left of everything under it. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        Margin="16,0,0,0" VerticalAlignment="Center">
                                <!-- macOS: traffic lights LEFT (dialog-style, no min/zoom). -->
                                <controls:WindowControls ShowMinimize="False" ShowMaximize="False"
                                                         IsVisible="{x:Static controls:Platform.IsMac}"
                                                         Margin="0,0,4,0"/>
                                <!-- Lucide "tag" - the same mark JUST TAG carries. -->
                                <Path Stretch="Uniform" Width="14" Height="14"
                                      VerticalAlignment="Center"
                                      Stroke="#D9FFFFFF" StrokeThickness="2"
                                      StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      Data="M12.586 2.586 A2 2 0 0 0 11.172 2 H4 a2 2 0 0 0 -2 2 v7.172
                                            a2 2 0 0 0 .586 1.414 l8.704 8.704 a2.426 2.426 0 0 0 3.42 0
                                            l6.58 -6.58 a2.426 2.426 0 0 0 0 -3.42 Z
                                            M6.3 7.5 A1.2 1.2 0 1 0 8.7 7.5 A1.2 1.2 0 1 0 6.3 7.5"/>
                                <TextBlock Text="EDIT TAGS" FontSize="11" FontWeight="SemiBold"
                                           LetterSpacing="2" Foreground="#D9FFFFFF"
                                           VerticalAlignment="Center"/>
                                <!-- Unsaved marker: a dot, not a word - it must read at a glance from
                                     the corner of the eye while you are looking at the list. -->
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentBBrush}"
                                         IsVisible="{Binding IsDirty}"
                                         ToolTip.Tip="Unsaved changes"/>
                                <!-- The file FACTS (type / length / kbps). They used to be the first
                                     row of the panel BODY; they are not something you edit, so they
                                     belong to the chrome that says what you are looking at - and in
                                     the docked host that is what puts them on the same line as the
                                     neighbouring pane's header instead of one row below it. -->
                                <TextBlock Text="{Binding FileInfo}" FontSize="10.5"
                                           Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding FileInfo}"/>
                            </StackPanel>

                            <!-- TAGS | ANALYSIS - the panel's two halves, switched from the CHROME.
                                 The switch used to live inside TagEditorPanel; it moved out so a host
                                 with its own pane header (JUST TAG) does not end up with two rows of
                                 tabs (Chloe 2026-08-05). Here the chrome IS the header, so this is
                                 where it belongs. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding HasFile}">
                                <Button Classes="tag-tab" Content="TAGS" Click="OnShowTags"
                                        Classes.selected="{Binding !#Panel.ShowAnalysis}"/>
                                <!-- ANALYSIS is ONE file's measurements; across a selection there is
                                     no such thing, so the tab is not offered (SetSelectionAsync puts
                                     the panel back on TAGS if you were standing on it). -->
                                <Button Classes="tag-tab" Content="ANALYSIS" Click="OnShowAnalysis"
                                        IsVisible="{Binding CanShowAnalysis}"
                                        Classes.selected="{Binding #Panel.ShowAnalysis}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="cap close" Click="OnClose" ToolTip.Tip="Close"
                                    IsVisible="{x:Static controls:Platform.IsNotMac}">
                                <controls:JustIcon Kind="Close" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- The horizontal inset lives HERE, not in the panel: this host has a rounded
                         card, so its body needs to stand off the edge. JUST TAG docks the same panel
                         as a bare pane with no frame and gives it none. -->
                    <controls:TagEditorPanel Name="Panel" Margin="16,0"/>
                </DockPanel>
            </Panel>
        </Border>

        <!-- Edge/corner resize grips in the transparent shadow ring (shared FramelessResizeBehavior).
             A frameless window gets no OS resize frame, so without these the editor would be stuck at
             its start size - and its size is remembered per WindowPlacement, so resizing it once is
             a lasting setting. -->
        <Grid Name="ResizeGrips" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"/>
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast"/>
        </Grid>
    </Panel>
</Window>
