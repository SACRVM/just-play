<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:JustPlay.UI.Controls"
        xmlns:vm="using:JustPlay.UI.ViewModels"
        x:Class="JustPlay.UI.Views.RenamePreviewWindow"
        Title="Rename preview"
        Width="760" Height="560"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      Every old -> new name a pattern would produce, BEFORE anything moves.

      It exists because a bulk rename fails in a way you cannot see from the pattern: two files
      resolving to the same name, or a name the folder already holds. Both are caught here and
      marked, and the save refuses while any is unresolved - protection in front of the action rather
      than an undo behind it.

      Nothing here opens a file: the tags the pattern needs came off the rows, which the library
      index fills. A 500-file preview costs nothing, which is what makes showing it the default.
    -->

    <Panel>
        <Border Name="DialogCard" ClipToBounds="False" Background="#40000000">
            <Panel>
                <uic:SurfaceCard CornerRadius="14"/>

                <DockPanel LastChildFill="True">

                    <!-- === CHROME === -->
                    <Border DockPanel.Dock="Top" Height="36" Background="Transparent"
                            PointerPressed="OnChromePressed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        Margin="16,0,0,0" VerticalAlignment="Center">
                                <uic:WindowControls ShowMinimize="False" ShowMaximize="False"
                                                    IsVisible="{x:Static uic:Platform.IsMac}"
                                                    Margin="0,0,4,0"/>
                                <uic:JustIcon Kind="Eye" Width="14" Height="14" Foreground="#D9FFFFFF"
                                              VerticalAlignment="Center"/>
                                <TextBlock Text="RENAME PREVIEW" FontSize="11" FontWeight="SemiBold"
                                           LetterSpacing="2" Foreground="#D9FFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Name="MaskText" FontSize="11"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="12,0,8,0"/>

                            <Button Grid.Column="2" Classes="cap close" Click="OnClose" ToolTip.Tip="Close"
                                    IsVisible="{x:Static uic:Platform.IsNotMac}">
                                <uic:JustIcon Kind="Close" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- === FOOTER: the verdict, and the way out ===
                         The count is the headline: "37 files, 2 problems" is the one sentence that
                         decides whether you go back to the pattern or hit save. -->
                    <Border DockPanel.Dock="Bottom" Margin="16,10,16,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Name="SummaryText" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <Button Grid.Column="1" Classes="dialog-close" Content="Close" Click="OnClose"/>
                        </Grid>
                    </Border>

                    <!-- === THE LIST === -->
                    <DockPanel Margin="16,4,16,0" LastChildFill="True">
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="*,*,Auto">
                                <TextBlock Grid.Column="0" Text="NOW" FontSize="10" FontWeight="SemiBold"
                                           LetterSpacing="2" Foreground="#8CFFFFFF"/>
                                <TextBlock Grid.Column="1" Text="AFTER" FontSize="10" FontWeight="SemiBold"
                                           LetterSpacing="2" Foreground="#8CFFFFFF" Margin="10,0,0,0"/>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Name="Rows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RenamePreviewRow">
                                        <Grid ColumnDefinitions="*,*,Auto" Margin="0,0,0,5">
                                            <TextBlock Grid.Column="0" Text="{Binding From}"
                                                       FontSize="12" Foreground="#8CFFFFFF"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding From}"/>
                                            <!-- The new name reads BRIGHT and the old one dim: the
                                                 question this window answers is what you are about
                                                 to get, not what you already have. -->
                                            <TextBlock Grid.Column="1" Text="{Binding To}"
                                                       FontSize="12" Foreground="#ECFFFFFF"
                                                       Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding To}"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        Spacing="5" Margin="10,0,0,0"
                                                        IsVisible="{Binding IsProblem}">
                                                <uic:JustIcon Kind="Warning" Width="11" Height="11"
                                                              Foreground="{DynamicResource CautionBrush}"
                                                              VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding IssueText}" FontSize="11"
                                                           Foreground="{DynamicResource CautionBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Panel>
        </Border>

        <!-- Shared edge/corner grips: a frameless window gets no OS resize frame. -->
        <Grid Name="ResizeGrips" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"/>
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast"/>
        </Grid>
    </Panel>
</Window>
