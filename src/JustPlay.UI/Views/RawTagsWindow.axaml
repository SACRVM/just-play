<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:JustPlay.UI.Controls"
        xmlns:vm="using:JustPlay.UI.ViewModels"
        x:Class="JustPlay.UI.Views.RawTagsWindow"
        x:DataType="vm:RawTagsViewModel"
        Title="Raw tags"
        Width="880" Height="640"
        MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      RAW TAGS = every frame/field in a file exactly as it sits on disk. Read-only, one file at a
      time, with prev/next through the selection you opened it from.

      WHY: we measured on 2026-07-31 that our writer hands back 787 of 787 vendor frame payloads
      byte-identical, where other taggers truncate Serato's Markers2, rename Mixed In Key's frames
      and wipe POPM. Nothing in the suite could SHOW that. This is the showing.

      WHAT IT MUST NEVER BECOME: it proves we PRESERVE, it does not pretend we UNDERSTAND. A row
      says "GEOB:Serato Markers2 = 470 bytes" (measured). It will never say "cue 3 at 2:14", because
      we do not decode those blobs. Binary entries show a SIZE, never a hexdump.

      SHELL: copied verbatim from MaskHelpWindow / RenamePreviewWindow. Frameless rounded card,
      SurfaceCard, the 36 px OnChromePressed drag bar, shared ResizeGrips. The shell is never
      re-invented per window (CLAUDE.md, JUST suite UI philosophy).

      NOT Topmost, unlike the pattern cheat sheet. That window is a reference you park BESIDE the
      editor while you work in it; this one is an inspection you open, read and close, and it is
      big. It is shown as a DIALOG of its owner, so it is already above the app it belongs to -
      Topmost would additionally float it over unrelated windows, which for a 880 px card is a
      nuisance and not a feature. Modal also means no save can run behind it, so the version notice
      below cannot go stale while it is being read.
    -->

    <Window.Styles>
        <!-- === Vendor chip = the "your cues are still here" proof, as a count.
             Deliberately NEUTRAL, not the green Ok token: a chip states a MEASUREMENT, a traffic
             light would state a verdict, and this window is in no position to give one while the
             caution notice below may be saying the frame labels are about to be rewritten. -->
        <Style Selector="Border.vendorchip">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,3"/>
        </Style>

        <!-- Section header: a whole-width toggle, flat until hover. -->
        <Style Selector="Button.sechead">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- FluentTheme leaks its own Background onto the templated ContentPresenter in all three
             states; pin them or the hover does nothing and the base state goes grey. -->
        <Style Selector="Button.sechead /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.sechead:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style Selector="Button.sechead:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF"/>
        </Style>

        <!-- One entry. A button because the ONE thing that may leave this window is text: click a
             row, that line is on the clipboard. No menu, no second gesture to learn. -->
        <Style Selector="Button.rawrow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.rawrow /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.rawrow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#12FFFFFF"/>
        </Style>
        <Style Selector="Button.rawrow:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF"/>
        </Style>

        <!-- Lead with what matters: a frame somebody's DJ software owns reads at full strength, an
             ordinary text frame one notch back. The ordinary ones are already shown, decoded, in the
             editor next door - here they are context, not the subject.
             (!) Set through the STYLE, never inline on the TextBlock: an inline value has LocalValue
             precedence and would beat the .plain setter silently. -->
        <!-- Ordered so the more specific pair lands LAST: a handle carries both classes, and among
             equally specific selectors the one declared later wins. -->
        <Style Selector="Button.rawrow TextBlock.mono">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style Selector="Button.rawrow.plain TextBlock.mono">
            <Setter Property="Foreground" Value="#73FFFFFF"/>
        </Style>
        <Style Selector="Button.rawrow TextBlock.handle">
            <Setter Property="Foreground" Value="#ECFFFFFF"/>
        </Style>
        <Style Selector="Button.rawrow.plain TextBlock.handle">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
        </Style>

        <!-- The chevron turns instead of swapping to a second icon (one shape, one meaning).
             RenderTransformOrigin defaults to Center in Avalonia (Visual.cs), so no origin wiring. -->
        <Style Selector="uic|JustIcon.chev">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>
        <Style Selector="uic|JustIcon.chev.collapsed">
            <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
        </Style>

        <!-- The copy hint says "Copied" in the Ok green, and "Could not copy" in caution when the
             platform clipboard refused - see CopyAsync for why that case is real. -->
        <Style Selector="TextBlock#CopiedHint">
            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
        </Style>
        <Style Selector="TextBlock#CopiedHint.failed">
            <Setter Property="Foreground" Value="{DynamicResource CautionBrush}"/>
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas,monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Styles>

    <Panel>
        <Border Name="DialogCard" ClipToBounds="False" Background="#40000000">
            <Panel>
                <uic:SurfaceCard CornerRadius="14"/>

                <DockPanel LastChildFill="True">

                    <!-- === CHROME ===
                         The eye: look, do not touch. It is the suite's preview mark and this window
                         is the most read-only surface in the product. -->
                    <Border DockPanel.Dock="Top" Height="36" Background="Transparent"
                            PointerPressed="OnChromePressed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        Margin="16,0,0,0" VerticalAlignment="Center">
                                <uic:WindowControls ShowMinimize="False" ShowMaximize="False"
                                                    IsVisible="{x:Static uic:Platform.IsMac}"
                                                    Margin="0,0,4,0"/>
                                <uic:JustIcon Kind="Eye" Width="14" Height="14" Foreground="#D9FFFFFF"
                                              VerticalAlignment="Center"/>
                                <TextBlock Text="RAW TAGS" FontSize="11" FontWeight="SemiBold"
                                           LetterSpacing="2" Foreground="#D9FFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Classes="cap close" Click="OnClose" ToolTip.Tip="Close"
                                    IsVisible="{x:Static uic:Platform.IsNotMac}">
                                <uic:JustIcon Kind="Close" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- === FOOTER ===
                         The standing statement of what this window is, and the only way anything
                         leaves it. -->
                    <Border DockPanel.Dock="Bottom" Margin="20,10,20,14">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" FontSize="11.5" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,14,0"
                                       Foreground="{DynamicResource MutedDimBrush}"
                                       Text="Read-only. Frames are shown as they sit on disk - a binary one by its size, because what is inside belongs to the app that wrote it. Click a line to copy it."/>
                            <TextBlock Grid.Column="1" Name="CopiedHint" Text="Copied" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="False"/>
                            <Button Grid.Column="2" Classes="dialog-close" Content="Copy all"
                                    Click="OnCopyAll" IsEnabled="{Binding HasContent}"/>
                        </Grid>
                    </Border>

                    <!-- === WHICH FILE ===
                         A selection can be more than one file, and comparing two of them is a real
                         question ("why does this one load in Serato and that one does not"), so the
                         window steps rather than showing only the first. Reading stays lazy: only
                         the file on screen has been opened. -->
                    <Grid DockPanel.Dock="Top" Margin="20,2,20,0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#ECFFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FolderPath}" FontSize="11"
                                       Foreground="{DynamicResource MutedFaintBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FolderPath}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center" IsVisible="{Binding HasMany}">
                            <Button Classes="seg" Content="PREV" Click="OnPrev"
                                    IsEnabled="{Binding CanPrev}"/>
                            <TextBlock Text="{Binding PositionText}" FontSize="11" MinWidth="46"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="Left and Right also step through the selection."
                                       Foreground="{DynamicResource MutedBrush}"/>
                            <Button Classes="seg" Content="NEXT" Click="OnNext"
                                    IsEnabled="{Binding CanNext}"/>
                        </StackPanel>
                    </Grid>

                    <!-- === THE HEADLINE: who else's data is in this file ===
                         This strip is the whole point of the window, so it sits above the table and
                         not inside it. -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0" Spacing="10">

                        <ItemsControl ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RawTagVendorBadge">
                                    <Border Classes="vendorchip" Margin="0,0,7,0">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                       FontWeight="SemiBold" LetterSpacing="1.4"
                                                       Foreground="#ECFFFFFF"/>
                                            <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                                       Foreground="{DynamicResource MutedDimBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The absence is an answer too, and a common one, so it is said out loud
                             rather than left as a blank strip. -->
                        <TextBlock IsVisible="{Binding HasNoBadges}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedDimBrush}"
                                   Text="No Serato, Traktor or Mixed In Key data in this file."/>

                        <!--
                          === THE ONE HONEST WARNING ===
                          Measured 2026-07-31 (128 writes / 787 vendor frames): an ID3v2 VERSION change
                          re-serialises the tag and re-encodes GEOB descriptors. No vendor byte is lost;
                          the LABEL Serato and MIK search by is what changes. JUST TAG's write-format
                          setting is the only thing in the suite that can trigger it.

                          THIS WINDOW KEEPS ITS COPY even though the tag editor now carries one above
                          Save, because the two answer different questions and this one is stricter: it
                          also requires the file to actually hold a Serato / Mixed In Key GEOB. Without
                          it the vendor chips right above would stand as an unqualified "your cues are
                          here" while a save is about to relabel them. It is also reachable from any
                          selection in JUST TAG's file list, with the editor pointed somewhere else.
                          Both surfaces render Id3ConversionNotice, so it is one sentence, not two.
                        -->
                        <Border Classes="caution" IsVisible="{Binding HasVersionNotice}">
                            <Grid ColumnDefinitions="Auto,11,*">
                                <uic:JustIcon Grid.Column="0" Kind="Warning" Width="14" Height="14"
                                              VerticalAlignment="Top" Margin="0,1,0,0"
                                              Foreground="{DynamicResource CautionBrush}"/>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Classes="cautiontitle" Text="{Binding VersionNotice}"/>
                                    <TextBlock Classes="cautionbody"
                                               Text="{x:Static vm:Id3ConversionNotice.Body}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- A file we could not open at all: one honest line, never an empty table.
                             The plain sentence leads and the reader's own reason follows it - the
                             exception text is the useful half for a DJ chasing a broken download, but
                             "CorruptFileException" on its own is not an answer to anybody. -->
                        <Grid IsVisible="{Binding HasFailure}" ColumnDefinitions="Auto,9,*">
                            <uic:JustIcon Grid.Column="0" Kind="Warning" Width="13" Height="13"
                                          VerticalAlignment="Top" Margin="0,2,0,0"
                                          Foreground="{DynamicResource CautionBrush}"/>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Could not read this file." FontSize="12"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource CautionBrush}"/>
                                <TextBlock Text="{Binding FailureReason}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding CountLine}" FontSize="10" FontWeight="SemiBold"
                                   LetterSpacing="1.6" Foreground="#73FFFFFF"
                                   IsVisible="{Binding HasContent}"/>
                    </StackPanel>

                    <!-- === THE CONTAINERS === -->
                    <ScrollViewer Margin="20,8,20,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RawTagSection">
                                    <StackPanel Margin="0,0,0,10">

                                        <Button Classes="sechead" Click="OnToggleSection">
                                            <Grid ColumnDefinitions="Auto,9,Auto,*">
                                                <uic:JustIcon Grid.Column="0" Classes="chev"
                                                              Classes.collapsed="{Binding IsCollapsed}"
                                                              Kind="ChevronDown" Width="10" Height="10"
                                                              VerticalAlignment="Center"
                                                              Foreground="#8CFFFFFF"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Label}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           LetterSpacing="1.4" Foreground="#ECFFFFFF"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CountText}"
                                                           FontSize="11" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedFaintBrush}"/>
                                            </Grid>
                                        </Button>

                                        <StackPanel IsVisible="{Binding IsExpanded}" Margin="19,2,0,0">

                                            <!-- A container the reader does not walk in detail gets ONE
                                                 greyed explanatory row. An empty table would read as
                                                 "this file has nothing here", which is a different and
                                                 false statement. -->
                                            <TextBlock IsVisible="{Binding IsUnsupported}"
                                                       Text="{Binding UnsupportedReason}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="8,2,0,4"
                                                       Foreground="{DynamicResource MutedFaintBrush}"/>

                                            <ItemsControl ItemsSource="{Binding Rows}"
                                                          IsVisible="{Binding HasRows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RawTagRow">
                                                        <Button Classes="rawrow" Click="OnCopyRow"
                                                                Classes.plain="{Binding !HasVendor}"
                                                                ToolTip.Tip="Click to copy this line">
                                                            <Grid ColumnDefinitions="230,108,*">
                                                                <TextBlock Grid.Column="0" Classes="mono handle"
                                                                           Text="{Binding Handle}"
                                                                           ToolTip.Tip="{Binding Handle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Vendor}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           LetterSpacing="1.2"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding HasVendor}"
                                                                           Foreground="#8CFFFFFF"/>
                                                                <TextBlock Grid.Column="2" Classes="mono"
                                                                           Text="{Binding Value}"
                                                                           ToolTip.Tip="{Binding Value}"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Panel>
        </Border>

        <!-- Shared edge/corner grips: a frameless window gets no OS resize frame. -->
        <Grid Name="ResizeGrips" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"/>
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast"/>
        </Grid>
    </Panel>
</Window>
