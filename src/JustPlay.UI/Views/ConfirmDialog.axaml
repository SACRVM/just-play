<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:JustPlay.UI.Controls"
        x:Class="JustPlay.UI.Views.ConfirmDialog"
        Title="Confirm"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      Shared tiny themed yes/no dialog - the suite's "are you sure?" for anything that would
      discard work (same frameless rounded card as InputDialog/About). ShowDialog returns
      true on confirm, false on cancel/Esc - see ConfirmDialog.AskAsync.
    -->
    <Border Name="DialogCard" ClipToBounds="True"
            BoxShadow="0 18 54 0 #B3000000">
        <Panel>
            <!-- The SHARED surface (JustPlay.UI SurfaceCard) - the ONE thing that makes a dialog
                 read as its own object instead of a second main window (Chloe 2026-08-05/06). The
                 distinction is FLAT vs GRADIENT: windows carry the ramp plus two accent blooms, a
                 dialog carries a flat slab. Gradient and glass were both tried on this surface and
                 both failed for measured reasons - see JustPalette.axaml (banding) and
                 AboutWindow.axaml (window-level blur eats the shadow margin). -->
            <uic:SurfaceCard CornerRadius="14"/>

            <StackPanel Margin="28,26,28,22" Spacing="0">
                <TextBlock x:Name="TitleText" Text="Confirm" FontSize="14" FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="12.5"
                           TextWrapping="Wrap" Foreground="#B3FFFFFF"/>

                <!-- Left to right = least to most committing. The third button is collapsed unless
                     AskSaveDiscardCancelAsync is used: an unsaved-changes question needs a way OUT
                     that neither saves nor discards, or a mis-click costs the work. -->
                <StackPanel Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" Classes="dialog-close" Content="Cancel" Click="OnCancel"/>
                    <Button x:Name="MiddleButton" Classes="dialog-close" Content="Discard"
                            IsVisible="False" Click="OnMiddle"/>
                    <Button x:Name="ConfirmButton" Classes="dialog-close" Content="OK" Click="OnConfirm"/>
                </StackPanel>
            </StackPanel>
        </Panel>
    </Border>
</Window>
