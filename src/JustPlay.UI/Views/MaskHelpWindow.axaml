<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uic="using:JustPlay.UI.Controls"
        xmlns:views="using:JustPlay.UI.Views"
        x:Class="JustPlay.UI.Views.MaskHelpWindow"
        Title="Pattern help"
        Width="470" Height="560"
        MinWidth="360" MinHeight="300"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      The pattern vocabulary, as a card you can leave open beside the editor.

      It used to be a line of grey text under the mask box. That is the wrong place for a reference:
      help you have read is help that is in the way, and help you have not read yet is help that is
      too small to use. A window you open once and park is neither - it is a cheat sheet, and it
      stays out of the panel entirely.

      Topmost + not in the taskbar: it belongs to the editor you are working in, not to the desktop.

      WindowStartupLocation=CenterOwner is the FIRST-open rule. WindowPlacement only sets a
      position when it has a remembered one, so without this the very first open is a Manual
      window placed wherever the OS likes - which on two monitors is not the one you are
      working on. From the second open on, the remembered spot wins.
    -->

    <Panel>
        <Border Name="DialogCard" ClipToBounds="False" Background="#40000000">
            <Panel>
                <uic:SurfaceCard CornerRadius="14"/>

                <DockPanel LastChildFill="True">

                    <Border DockPanel.Dock="Top" Height="36" Background="Transparent"
                            PointerPressed="OnChromePressed">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                                        Margin="16,0,0,0" VerticalAlignment="Center">
                                <uic:WindowControls ShowMinimize="False" ShowMaximize="False"
                                                    IsVisible="{x:Static uic:Platform.IsMac}"
                                                    Margin="0,0,4,0"/>
                                <TextBlock Text="PATTERNS" FontSize="11" FontWeight="SemiBold"
                                           LetterSpacing="2" Foreground="#D9FFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="cap close" Click="OnClose" ToolTip.Tip="Close"
                                    IsVisible="{x:Static uic:Platform.IsNotMac}">
                                <uic:JustIcon Kind="Close" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Margin="20,0,20,18" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14">

                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Text="A pattern describes how a file NAME is put together. Read one way it builds a name out of tags; read the other way it pulls tags out of a name."/>

                            <StackPanel Spacing="2">
                                <TextBlock Text="THE PLACEHOLDERS" FontSize="10" FontWeight="Bold"
                                           LetterSpacing="2" Foreground="#73FFFFFF" Margin="0,0,0,4"/>
                                <ItemsControl Name="Fields">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="views:MaskHelpRow">
                                            <Grid ColumnDefinitions="130,*" Margin="0,0,0,4">
                                                <TextBlock Grid.Column="0" Text="{Binding Term}"
                                                           FontSize="12.5" FontFamily="Consolas,monospace"
                                                           Foreground="#ECFFFFFF"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Means}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Height="1" Background="#14FFFFFF"/>

                            <StackPanel Spacing="2">
                                <TextBlock Text="EXAMPLES" FontSize="10" FontWeight="Bold"
                                           LetterSpacing="2" Foreground="#73FFFFFF" Margin="0,0,0,4"/>
                                <ItemsControl Name="Examples">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="views:MaskHelpRow">
                                            <StackPanel Spacing="1" Margin="0,0,0,9">
                                                <TextBlock Text="{Binding Term}" FontSize="12.5"
                                                           FontFamily="Consolas,monospace"
                                                           Foreground="#ECFFFFFF" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Means}" FontSize="11.5"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Height="1" Background="#14FFFFFF"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="GOOD TO KNOW" FontSize="10" FontWeight="Bold"
                                           LetterSpacing="2" Foreground="#73FFFFFF"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="A name that does not fit the pattern is LEFT ALONE - never half-filled. The count beside the box says how many of your selection fit, and it moves while you type."/>
                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="Spelling is forgiving where it should be: a dash also matches an en or em dash, and spaces also match underscores. What the pattern SAYS is still required - a pattern with a dash needs a dash."/>
                                <TextBlock TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="Where two fields meet, the FIRST separator is the split and the rest belongs to the last field - so &quot;A - B - C&quot; with %artist% - %title% gives artist A and title B - C."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Panel>
        </Border>

        <Grid Name="ResizeGrips" ColumnDefinitions="20,*,20" RowDefinitions="20,*,20">
            <Border Grid.Row="0" Grid.Column="0" Background="#01000000" Cursor="TopLeftCorner"     Tag="NorthWest"/>
            <Border Grid.Row="0" Grid.Column="1" Background="#01000000" Cursor="TopSide"           Tag="North"/>
            <Border Grid.Row="0" Grid.Column="2" Background="#01000000" Cursor="TopRightCorner"    Tag="NorthEast"/>
            <Border Grid.Row="1" Grid.Column="0" Background="#01000000" Cursor="LeftSide"          Tag="West"/>
            <Border Grid.Row="1" Grid.Column="2" Background="#01000000" Cursor="RightSide"         Tag="East"/>
            <Border Grid.Row="2" Grid.Column="0" Background="#01000000" Cursor="BottomLeftCorner"  Tag="SouthWest"/>
            <Border Grid.Row="2" Grid.Column="1" Background="#01000000" Cursor="BottomSide"        Tag="South"/>
            <Border Grid.Row="2" Grid.Column="2" Background="#01000000" Cursor="BottomRightCorner" Tag="SouthEast"/>
        </Grid>
    </Panel>
</Window>
