<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:JustPlay.UI.Views"
        xmlns:c="using:JustPlay.UI.Controls"
        x:Class="JustPlay.UI.Views.AboutWindow"
        x:DataType="v:AboutInfo"
        Title="About"
        Width="384" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="Transparent,Mica,Blur"
        WindowDecorations="None">

    <!--
      SHARED "About" dialog for the whole J.U.S.T. suite (JustPlay.UI). Renders in the active palette
      through DynamicResource (SurfaceCard's fill, AccentGradient/TitleGradient brand mark), so it
      follows live theme switches with no extra wiring and looks identical across apps. The per-app
      content (name, tagline, version, glyph) comes from the AboutInfo DataContext; the brand glyph is
      built in code-behind with the same logic as ThemedWindowIcon so it matches the taskbar mark.
    -->
    <!-- Border#DialogCard: margin, radius and the deeper DialogOuter shadow all come from the shared
         style in JustStyles.axaml - a dialog floats above the app, a window does not. -->
    <!-- (!) Shadow values and the card margin are a PAIR. Setting Margin here would be a LocalValue and
         would beat the style, which is how the old "0 18 54 0" literal at Margin 14 ended up clipping
         hard at the window edge (Chloe 2026-07-05). -->
    <Border Name="DialogCard" ClipToBounds="True"
            PointerPressed="OnCardPressed">
        <Panel>
            <!--
              (!!) GLASS WAS TRIED HERE ON 2026-08-06 AND DOES NOT WORK WITH THIS WINDOW SHAPE.
              Do not re-attempt without solving the thing below first.

              The ask was exactly right and exactly specific: blur DIRECTLY BEHIND the window, not
              around it. Avalonia can do the first half - ExperimentalAcrylicBorder's material is
              drawn as a RoundedRect in the visual's own bounds
              (ServerCompositionExperimentalAcrylicVisual.RenderCore). I read that and concluded the
              BLUR was clipped to the card too. It is not, and that was my error: the blur is not
              part of the material, it is a window-level effect. WinUiCompositedWindow builds it as a
              sibling visual under a container with SetRelativeSizeAdjustment(1,1) - i.e. sized to
              the WHOLE window - and WindowImpl.SetTransparencyAcrylicBlur turns the per-pixel-alpha
              path off (SetLegacyTransparency(false)). Every JUST window is a rounded card inside a
              20/22 transparent margin that the drop shadow blooms into, so the blur filled that
              margin and the dialog came up inside a hard box (Chloe: "ich sehe deutlich drum herum
              einen harten kasten mit fehlender transparenz").

              So on Win32 it is one or the other: a transparent shadow margin, or window backdrop
              blur. The suite chrome is not negotiable, so the dialog keeps the window recipe and
              the SurfaceCard treatment carries the "this is a different object" job instead.
            -->
            <!-- The SHARED surface (JustPlay.UI SurfaceCard) - the flat slab that makes this read as
                 a dialog and not as a second main window. Identical in all nine dialogs and in the
                 JUST PLAY tweaks sidebar, from one definition. -->
            <c:SurfaceCard CornerRadius="14"/>

            <!-- Close (x) in the rounded top-right corner (shared Button.cap.close) - Windows.
                 macOS gets the traffic lights top-LEFT instead (min/zoom greyed, dialog-style). -->
            <Button Classes="cap close" Click="OnCloseClick" ToolTip.Tip="Close"
                    IsVisible="{x:Static c:Platform.IsNotMac}"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <c:JustIcon Kind="Close" Width="12" Height="12"/>
            </Button>
            <c:WindowControls ShowMinimize="False" ShowMaximize="False"
                              IsVisible="{x:Static c:Platform.IsMac}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0"/>

            <StackPanel Margin="30,34,30,28" Spacing="0" HorizontalAlignment="Center">
                <!-- Brand mark: NO chip background - just the app's white glyph (Chloe 2026-06-30).
                     The glyph (GlyphHost.Content) is built in code-behind from AboutInfo.Glyph, sized to
                     fill the area the gradient chip used to occupy. -->
                <Border Width="74" Height="74"
                        Background="Transparent"
                        HorizontalAlignment="Center">
                    <ContentControl x:Name="GlyphHost"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Name (gradient) + tagline. -->
                <TextBlock Text="{Binding AppName}" FontSize="31" FontWeight="Bold"
                           Foreground="{DynamicResource TitleGradient}"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding Tagline}" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>

                <!-- Version. -->
                <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold"
                           LetterSpacing="0.5"
                           Foreground="{DynamicResource MutedDimBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>

                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,20"/>

                <!-- Suite brand: J.U.S.T. = "Just Useful Sound Tools". -->
                <TextBlock Text="{Binding SuiteLine}" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <!-- The maker credo - every JUST app carries it. -->
                <TextBlock Text="{Binding Motto}" FontSize="10" FontWeight="SemiBold"
                           LetterSpacing="2.4"
                           Foreground="{DynamicResource AccentABrush}" Opacity="0.85"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding By}" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Copyright}" FontSize="11"
                           Foreground="{DynamicResource MutedDimBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>

                <Button Classes="dialog-close" Content="Close" Click="OnCloseClick"
                        Margin="0,24,0,0"/>
            </StackPanel>
        </Panel>
    </Border>
</Window>
