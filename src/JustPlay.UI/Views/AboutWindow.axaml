<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:JustPlay.UI.Views"
        xmlns:c="using:JustPlay.UI.Controls"
        x:Class="JustPlay.UI.Views.AboutWindow"
        x:DataType="v:AboutInfo"
        Title="About"
        Width="384" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="#00000000"
        TransparencyLevelHint="AcrylicBlur,Transparent,Blur"
        WindowDecorations="None">

    <!--
      SHARED "About" dialog for the whole J.U.S.T. suite (JustPlay.UI). Renders in the active
      palette by consuming the same DynamicResource keys the main windows use (BgLinear/BgGlowA/
      BgGlowB background, AccentGradient/TitleGradient brand mark) — so it follows live theme
      switches with no extra wiring, and looks identical across apps. The per-app content (name,
      tagline, version, glyph) comes from the AboutInfo DataContext; the brand glyph is built in
      code-behind with the same logic as ThemedWindowIcon so it matches the taskbar mark.
    -->
    <!-- Shared WindowOuter shadow + the suite-standard 20/22 transparent margin — the old
         "0 18 54 0" literal at Margin 14 clipped hard at the window edge (Chloe 2026-07-05). -->
    <Border CornerRadius="16" Margin="20,20,20,22" ClipToBounds="True"
            BoxShadow="{DynamicResource WindowOuter}"
            PointerPressed="OnCardPressed">
        <Panel>
            <!--
              ⚗ EXPERIMENT (Chloe 2026-08-06, "vllt sogar mit einem glass effect ... ich meine nur
              blur direkt hinter dem fenster - nicht um das fenster herum"): the dialog as GLASS
              instead of a second copy of the window recipe. Deliberately inline and on ONE dialog
              until her eye rules on it — building the shared abstraction first would be backwards.

              Why the shadow margin survives: ServerCompositionExperimentalAcrylicVisual.RenderCore
              draws the material as a RoundedRect in the VISUAL's own bounds (verified against
              Avalonia release/12.0.3), not window-wide. So the blur stops at the card and the
              20/22 margin the drop shadow blooms into stays fully transparent.
              On Win32 this resolves to DWMWA_USE_HOSTBACKDROPBRUSH + BlurEffect.Acrylic
              (src/Windows/Avalonia.Win32/WindowImpl.cs) — it samples the windows BEHIND the dialog,
              which is what "blur directly behind" means. Mica was dropped from the hint list on
              purpose: it samples the desktop WALLPAPER, not the app underneath.

              The two radial glows are gone here on purpose — BgGlowB is AccentC at FULL alpha and
              would sit on the glass as an opaque blob. A dialog reading calmer than the main window
              is the point, not a side effect.
            -->
            <ExperimentalAcrylicBorder CornerRadius="16">
                <ExperimentalAcrylicBorder.Material>
                    <ExperimentalAcrylicMaterial
                        BackgroundSource="Digger"
                        TintColor="{DynamicResource BgVia}"
                        TintOpacity="0.85"
                        MaterialOpacity="0.55"
                        FallbackColor="{DynamicResource BgVia}"/>
                </ExperimentalAcrylicBorder.Material>
            </ExperimentalAcrylicBorder>
            <Border BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16"/>

            <!-- Close (×) in the rounded top-right corner (shared Button.cap.close) — Windows.
                 macOS gets the traffic lights top-LEFT instead (min/zoom greyed, dialog-style). -->
            <Button Classes="cap close" Click="OnCloseClick" ToolTip.Tip="Close"
                    IsVisible="{x:Static c:Platform.IsNotMac}"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="✕" FontSize="13"/>
            </Button>
            <c:WindowControls ShowMinimize="False" ShowMaximize="False"
                              IsVisible="{x:Static c:Platform.IsMac}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0"/>

            <StackPanel Margin="30,34,30,28" Spacing="0" HorizontalAlignment="Center">
                <!-- Brand mark: NO chip background — just the app's white glyph (Chloe 2026-06-30).
                     The glyph (GlyphHost.Content) is built in code-behind from AboutInfo.Glyph, sized to
                     fill the area the gradient chip used to occupy. -->
                <Border Width="74" Height="74"
                        Background="Transparent"
                        HorizontalAlignment="Center">
                    <ContentControl x:Name="GlyphHost"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Name (gradient) + tagline. -->
                <TextBlock Text="{Binding AppName}" FontSize="31" FontWeight="Bold"
                           Foreground="{DynamicResource TitleGradient}"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding Tagline}" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>

                <!-- Version. -->
                <TextBlock Text="{Binding Version}" FontSize="12" FontWeight="SemiBold"
                           LetterSpacing="0.5"
                           Foreground="{DynamicResource MutedDimBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>

                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,20"/>

                <!-- Suite brand: J.U.S.T. = "Just Useful Sound Tools". -->
                <TextBlock Text="{Binding SuiteLine}" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <!-- The maker credo — every JUST app carries it. -->
                <TextBlock Text="{Binding Motto}" FontSize="10" FontWeight="SemiBold"
                           LetterSpacing="2.4"
                           Foreground="{DynamicResource AccentABrush}" Opacity="0.85"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding By}" FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Copyright}" FontSize="11"
                           Foreground="{DynamicResource MutedDimBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>

                <Button Classes="dialog-close" Content="Close" Click="OnCloseClick"
                        Margin="0,24,0,0"/>
            </StackPanel>
        </Panel>
    </Border>
</Window>
