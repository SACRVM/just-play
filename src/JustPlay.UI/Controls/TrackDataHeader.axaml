<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:JustPlay.UI.Controls"
             x:Class="JustPlay.UI.Controls.TrackDataHeader">

    <!-- The shared data-column header strip (docked right by the host). Every cell: fixed ColW* width (SAME
         resource as the TrackRow cell), Tag = lowercase column id (drives the sort click), IsVisible off the
         shared Columns, a label + a sort arrow that collapses when the column isn't the active sort. Column
         order + alignment are defined ONCE here and shared by both lists. -->
    <!-- The .colhead / .sortarrow label styles live in the SHARED sheet (JustPlay.UI/Theming/
         JustStyles.axaml), not locally here: every host draws its OWN leading NAME cell next to this
         strip, and that label has to be the same one. They were scoped to this control until JUST TAG
         needed the same head (2026-08-05) — a second copy is how two headers start looking alike
         instead of being alike. -->

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- ARTIST (left) — finder-only sortable column -->
        <Border Width="{DynamicResource ColWArtist}" Background="Transparent" Tag="artist" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowArtist}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="ARTIST"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.ArtistSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ArtistSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- ALBUM (left) -->
        <Border Width="{DynamicResource ColWAlbum}" Background="Transparent" Tag="album" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowAlbum}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="ALBUM"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.AlbumSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.AlbumSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- ALBUM ARTIST (left) -->
        <Border Width="{DynamicResource ColWAlbumArtist}" Background="Transparent" Tag="albumartist" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowAlbumArtist}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="ALBUM ARTIST"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.AlbumArtistSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.AlbumArtistSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- GENRE (left) -->
        <Border Width="{DynamicResource ColWGenre}" Background="Transparent" Tag="genre" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowGenre}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="GENRE"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.GenreSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.GenreSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- YEAR (right — over right-aligned digits) -->
        <Border Width="{DynamicResource ColWYear}" Background="Transparent" Tag="year" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowYear}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="YEAR"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.YearSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.YearSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- TRACK # (right) -->
        <Border Width="{DynamicResource ColWTrackNo}" Background="Transparent" Tag="trackno" Cursor="Hand" ToolTip.Tip="Track number"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowTrackNo}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="#"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.TrackNoSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.TrackNoSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- BPM (centre) -->
        <Border Width="{DynamicResource ColWBpm}" Background="Transparent" Tag="bpm" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowBpm}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="BPM"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.BpmSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.BpmSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- KEY (centre) -->
        <Border Width="{DynamicResource ColWKey}" Background="Transparent" Tag="key" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowKey}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="KEY"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.KeySortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.KeySortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- NRG (centre) -->
        <Border Width="{DynamicResource ColWNrg}" Background="Transparent" Tag="nrg" Cursor="Hand" ToolTip.Tip="Energy"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowNrg}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="NRG"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.NrgSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.NrgSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- GAIN (centre) -->
        <Border Width="{DynamicResource ColWGain}" Background="Transparent" Tag="gain" Cursor="Hand" ToolTip.Tip="Replay gain (dB)"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowGain}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="GAIN"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.GainSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.GainSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- LUFS (centre) -->
        <Border Width="{DynamicResource ColWLufs}" Background="Transparent" Tag="lufs" Cursor="Hand" ToolTip.Tip="Integrated loudness (LUFS)"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowLufs}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="LUFS"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.LufsSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.LufsSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- DRK (centre) -->
        <Border Width="{DynamicResource ColWVibe}" Background="Transparent" Tag="dark" Cursor="Hand" ToolTip.Tip="Darkness"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowDark}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="DRK"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.DarkSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.DarkSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- HYP (centre) -->
        <Border Width="{DynamicResource ColWVibe}" Background="Transparent" Tag="hypnotic" Cursor="Hand" ToolTip.Tip="Hypnotic"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowHypnotic}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="HYP"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.HypnoticSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.HypnoticSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- GRV (centre) -->
        <Border Width="{DynamicResource ColWVibe}" Background="Transparent" Tag="groove" Cursor="Hand" ToolTip.Tip="Groove"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowGroove}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="GRV"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.GrooveSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.GrooveSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- PUN (centre) -->
        <Border Width="{DynamicResource ColWVibe}" Background="Transparent" Tag="punch" Cursor="Hand" ToolTip.Tip="Punch"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowPunch}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="PUN"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.PunchSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.PunchSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- HRS (centre) -->
        <Border Width="{DynamicResource ColWVibe}" Background="Transparent" Tag="harsh" Cursor="Hand" ToolTip.Tip="Harshness"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowHarsh}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="HRS"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.HarshSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.HarshSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- COMMENT (left) — the DJ-software COMM field -->
        <Border Width="{DynamicResource ColWComment}" Background="Transparent" Tag="comment" Cursor="Hand" ToolTip.Tip="Comment tag (what DJ software reads)"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowComment}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="COMMENT"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.CommentSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.CommentSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- ANALYSIS (centre) — the traffic light. Sorting it groups the folder into
             never-analysed / outdated / current, which is exactly the order you work through. -->
        <Border Width="{DynamicResource ColWAnalysis}" Background="Transparent" Tag="analysis" Cursor="Hand"
                ToolTip.Tip="Our analysis: green = current, sand = older version, ring = none"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowAnalysis}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="AN"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.AnalysisSortGlyph}"/>
            </StackPanel>
        </Border>

        <!-- COV (centre) -->
        <Border Width="{DynamicResource ColWCover}" Background="Transparent" Tag="cover" Cursor="Hand" ToolTip.Tip="Has a cover"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowCover}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="COV"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.CoverSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.CoverSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- ID3 (centre) -->
        <Border Width="{DynamicResource ColWId3}" Background="Transparent" Tag="id3" Cursor="Hand" ToolTip.Tip="ID3v2 version in the file"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowId3}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="ID3"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.Id3SortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.Id3SortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- FILE TYPE (centre) -->
        <Border Width="{DynamicResource ColWFileType}" Background="Transparent" Tag="filetype" Cursor="Hand" ToolTip.Tip="File format"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowFileType}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="TYPE"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.FileTypeSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.FileTypeSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- DURATION (right) — the one host-specific label: queue = set total (LS 0), finder = "TIME" (LS 2). -->
        <Border Width="{DynamicResource ColWDuration}" Background="Transparent" Tag="duration" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowDuration}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Classes="colhead"
                           LetterSpacing="{Binding $parent[controls:TrackDataHeader].DurationHeaderLetterSpacing}"
                           Text="{Binding $parent[controls:TrackDataHeader].DurationHeader}"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.DurationSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.DurationSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- LIKE (centre) -->
        <Border Width="{DynamicResource ColWLike}" Background="Transparent" Tag="like" Cursor="Hand"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowLike}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="♥"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.LikeSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.LikeSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- FILE NAME (left) — last, like the cell it heads. -->
        <Border Width="{DynamicResource ColWFileName}" Background="Transparent" Tag="filename" Cursor="Hand" ToolTip.Tip="Name on disk"
                Tapped="OnHeaderTapped" IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.ShowFileName}">
            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="colhead" Text="FILE NAME"/>
                <TextBlock Classes="colhead sortarrow" Text="{Binding $parent[controls:TrackDataHeader].Columns.FileNameSortGlyph}"
                           IsVisible="{Binding $parent[controls:TrackDataHeader].Columns.FileNameSortGlyph, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
