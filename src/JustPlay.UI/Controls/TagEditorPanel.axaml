<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.UI.ViewModels"
             x:Class="JustPlay.UI.Controls.TagEditorPanel"
             x:DataType="vm:TagEditorViewModel">

    <!--
      The SHARED tag editor body. Two hosts, one implementation: the floating always-on-top window
      (JUST PLAY / PRE CUE FINDER) and JUST TAG's docked sidebar. Nothing in here knows which one it
      is sitting in — that is the whole point, and why it must never grow a host-specific branch.

      Styling is SELF-CONTAINED (tag-* classes, theme keys via DynamicResource): the app-level
      .label / .field / .ghost classes are defined per app today and differ, so relying on them
      would make this control look different in every host. It follows the live theme regardless.
    -->

    <UserControl.Styles>
        <!-- Field caption above each input. -->
        <Style Selector="TextBlock.tag-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Foreground" Value="#73FFFFFF"/>
        </Style>

        <Style Selector="TextBlock.tag-muted">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <!-- Editable field — frosted box, accent focus ring (the OS red is never allowed through). -->
        <Style Selector="TextBox.tag-field">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Foreground" Value="#ECFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="SelectionBrush" Value="#448a5fff"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBBrush}"/>
        </Style>
        <Style Selector="TextBox.tag-field:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="TextBox.tag-field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBBrush}"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>

        <!-- Genre suggestions: an AutoCompleteBox wearing the same clothes as the plain fields, so
             the row does not announce itself as a different KIND of input. The inner TextBox carries
             the look; the outer control is only a shell. -->
        <Style Selector="AutoCompleteBox.tag-field">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="AutoCompleteBox.tag-field /template/ TextBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Foreground" Value="#ECFFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="SelectionBrush" Value="#448a5fff"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBBrush}"/>
        </Style>
        <!-- The suggestion list — never left in stock chrome. -->
        <Style Selector="AutoCompleteBox.tag-field /template/ ListBox">
            <Setter Property="Background" Value="#F01a1828"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="MaxHeight" Value="220"/>
        </Style>
        <Style Selector="AutoCompleteBox.tag-field /template/ ListBox ListBoxItem">
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- The locked extension next to the name box. -->
        <Style Selector="TextBlock.tag-ext">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
        </Style>

        <!-- Secondary button (Open cover, Revert). -->
        <Style Selector="Button.tag-ghost">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tag-ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.tag-ghost:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Save — the one primary action in this panel. -->
        <Style Selector="Button.tag-save">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- State-dependent, so OUTSIDE the template (an inline value would beat the pseudo-class
             setter — see CLAUDE.md "Styles in App.axaml"). -->
        <Style Selector="Button.tag-save:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
    </UserControl.Styles>

    <Panel>

        <!-- ── NOTHING SELECTED ─────────────────────────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding !HasFile}" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="8" Margin="24">
            <Path Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center"
                  Stroke="#59FFFFFF" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                  Data="M12.586 2.586 A2 2 0 0 0 11.172 2 H4 a2 2 0 0 0 -2 2 v7.172
                        a2 2 0 0 0 .586 1.414 l8.704 8.704 a2.426 2.426 0 0 0 3.42 0
                        l6.58 -6.58 a2.426 2.426 0 0 0 0 -3.42 Z
                        M6.3 7.5 A1.2 1.2 0 1 0 8.7 7.5 A1.2 1.2 0 1 0 6.3 7.5"/>
            <TextBlock Text="Pick a track to edit its tags." Classes="tag-muted"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ── THE EDITOR ───────────────────────────────────────────────────────────────────── -->
        <DockPanel IsVisible="{Binding HasFile}" LastChildFill="True">

            <!-- Footer first (DockPanel fills with the LAST child) so the action row is pinned to
                 the bottom and the fields scroll behind it. -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="16,10,16,14">
                <TextBlock Grid.Column="0" Text="{Binding Status}" Classes="tag-muted"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"/>
                <Button Grid.Column="1" Classes="tag-ghost" Content="Revert" Margin="0,0,8,0"
                        Click="OnRevert" IsEnabled="{Binding IsDirty}"
                        ToolTip.Tip="Throw the unsaved edits away and read the file again"/>
                <Button Grid.Column="2" Classes="tag-save" Content="Save"
                        Click="OnSave" IsEnabled="{Binding IsDirty}"/>
            </Grid>

            <!-- ⚠ Margin on the CONTENT, not Padding on the ScrollViewer: the ScrollViewer's own
                 padding is not subtracted from the width it offers its child, so every field came
                 out exactly Padding.Right too wide and the top row ran off the card
                 (Chloe's screenshot, 2026-08-03). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="16,4,16,4">

                    <!-- File identity -->
                    <TextBlock Text="{Binding FileInfo}" Classes="tag-muted" FontSize="10.5"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- FILE NAME — not a tag, but the thing you most want to fix while tidying up.
                         The extension sits outside the box and is carried over verbatim, so a typo
                         cannot make the file unplayable. -->
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="FILE NAME" Classes="tag-label"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="tag-ghost" Padding="8,2" FontSize="10"
                                    Content="Name from tags ▾"
                                    ToolTip.Tip="Fill the name from the tags — nothing is renamed until you save">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Artist - Title"
                                                  Tag="%artist% - %title%" Click="OnRenameMask"/>
                                        <MenuItem Header="Title - Artist"
                                                  Tag="%title% - %artist%" Click="OnRenameMask"/>
                                        <MenuItem Header="Artist - Title (Album)"
                                                  Tag="%artist% - %title% (%album%)" Click="OnRenameMask"/>
                                        <MenuItem Header="Track - Artist - Title"
                                                  Tag="%track% - %artist% - %title%" Click="OnRenameMask"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Classes="tag-field" Text="{Binding BaseName}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Extension}" Classes="tag-ext"/>
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="#14FFFFFF"/>

                    <!-- Cover + the two headline fields -->
                    <Grid ColumnDefinitions="104,14,*">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <Border Width="104" Height="104" CornerRadius="9" ClipToBounds="True"
                                    Background="#12FFFFFF"
                                    BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Panel>
                                    <TextBlock Text="No cover" Classes="tag-muted" FontSize="10.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !HasCover}"/>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                           IsVisible="{Binding HasCover}"/>
                                </Panel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Button Classes="tag-ghost" Content="Change…" Padding="10,4" FontSize="11"
                                        Click="OnChangeCover"/>
                                <Button Classes="tag-ghost" Padding="7,4" Click="OnRemoveCover"
                                        ToolTip.Tip="Remove cover">
                                    <Path Stretch="Uniform" Width="12" Height="12"
                                          Stroke="#E6FFFFFF" StrokeThickness="1.5"
                                          StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                          Data="M3 6 h18 M8 6 V4 a1 1 0 0 1 1 -1 h6 a1 1 0 0 1 1 1 v2
                                                M19 6 v14 a2 2 0 0 1 -2 2 H7 a2 2 0 0 1 -2 -2 V6
                                                M10 11 v6 M14 11 v6"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="9">
                            <StackPanel Spacing="3">
                                <TextBlock Text="TITLE" Classes="tag-label"/>
                                <TextBox Classes="tag-field" Text="{Binding Title}"/>
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Text="ARTIST" Classes="tag-label"/>
                                <TextBox Classes="tag-field" Text="{Binding Artist}"/>
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Text="ALBUM" Classes="tag-label"/>
                                <TextBox Classes="tag-field" Text="{Binding Album}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="ALBUM ARTIST" Classes="tag-label"/>
                            <TextBox Classes="tag-field" Text="{Binding AlbumArtist}"/>
                        </StackPanel>
                        <!-- Suggests from the genres this library ALREADY uses (most-used first),
                             then a fallback vocabulary — so the same style stops being spelled four
                             ways. Free text is always accepted; this never restricts. -->
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="GENRE" Classes="tag-label"/>
                            <AutoCompleteBox Classes="tag-field" Text="{Binding Genre}"
                                             ItemsSource="{Binding GenreSuggestions}"
                                             FilterMode="Contains" MinimumPrefixLength="1"
                                             MaxDropDownHeight="220"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="YEAR" Classes="tag-label"/>
                            <TextBox Classes="tag-field" Text="{Binding Year}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="TRACK #" Classes="tag-label"/>
                            <TextBox Classes="tag-field" Text="{Binding Track}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="3">
                        <TextBlock Text="COMMENT" Classes="tag-label"/>
                        <TextBox Classes="tag-field" Text="{Binding Comment}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"/>
                    </StackPanel>

                    <!-- ── ANALYSIS — hand-correctable ────────────────────────────────────────
                         These three are OUR measurements, so correcting one is a statement about
                         the detector, not a typo fix. What the DSP measured stays visible right
                         underneath, so the correction is made against a number instead of blind. -->
                    <Border Height="1" Background="#14FFFFFF" Margin="0,2,0,0"/>

                    <Grid ColumnDefinitions="*,10,*,10,*">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="BPM" Classes="tag-label"/>
                            <TextBox Classes="tag-field" Text="{Binding BpmText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Text="KEY" Classes="tag-label"/>
                            <TextBox Classes="tag-field" Text="{Binding KeyText}"
                                     ToolTip.Tip="Am, F#m, 8A — Camelot works too"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="3">
                            <TextBlock Text="ENERGY" Classes="tag-label"/>
                            <TextBox Classes="tag-field" Text="{Binding EnergyText}"
                                     ToolTip.Tip="1 to 10"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDetected}">
                        <TextBlock Text="WE MEASURED" Classes="tag-label" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DetectedSummary}" Classes="tag-muted"
                                   FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Panel>
</UserControl>
