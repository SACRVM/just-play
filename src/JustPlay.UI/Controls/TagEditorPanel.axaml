<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.UI.ViewModels"
             xmlns:controls="using:JustPlay.UI.Controls"
             x:Class="JustPlay.UI.Controls.TagEditorPanel"
             x:DataType="vm:TagEditorViewModel">

    <!--
      The SHARED tag editor body. Two hosts, one implementation: the floating always-on-top window
      (JUST PLAY / PRE CUE FINDER) and JUST TAG's docked sidebar. Nothing in here knows which one it
      is sitting in - that is the whole point, and why it must never grow a host-specific branch.

      Styling is SELF-CONTAINED (tag-* classes, theme keys via DynamicResource): the app-level
      .label / .field / .ghost classes are defined per app today and differ, so relying on them
      would make this control look different in every host. It follows the live theme regardless.
    -->

    <UserControl.Styles>
        <!-- Field caption above each input. -->
        <Style Selector="TextBlock.tag-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Foreground" Value="#73FFFFFF"/>
        </Style>

        <Style Selector="TextBlock.tag-muted">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <!-- (!) The field LOOK is no longer written here. The frosted box, the tick, the X and the
             chromeless input are suite styles (Theming/JustStyles.axaml, "EDITABLE FIELD"), composed
             by TagFieldBox - which is what let the genre box stop being a second, hand-matched copy
             of the same design. -->

        <!-- The pattern picker in the file-name row. It sits INSIDE a fieldbox, so it brings no
             chrome of its own - only the text and the chevron that says it opens a list. -->
        <Style Selector="Button.maskpick">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="#ECFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.maskpick /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- The locked extension next to the name box. -->
        <Style Selector="TextBlock.tag-ext">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
        </Style>

        <!-- Secondary button (Open cover, Revert). -->
        <Style Selector="Button.tag-ghost">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.tag-ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.tag-ghost:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Save - the one primary action in this panel. -->
        <Style Selector="Button.tag-save">
            <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- State-dependent, so OUTSIDE the template (an inline value would beat the pseudo-class
             setter - see CLAUDE.md "Styles in App.axaml"). -->
        <Style Selector="Button.tag-save:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- The .tag-tab pill styles moved to the SHARED sheet (JustPlay.UI/Theming/JustStyles.axaml)
             together with the switch itself: the buttons now live in each HOST's header, which is
             outside this control and therefore outside its style scope. -->

        <!-- Character bar. Solid accent, not the gradient: a gradient compresses into the filled
             part, so two different values would draw two different colour ramps. -->
        <Style Selector="ProgressBar.tag-bar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- A measured value: readable, but not as loud as an editable field. -->
        <Style Selector="TextBlock.tag-value">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#DEFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Panel>

        <!-- == NOTHING SELECTED =============================================================== -->
        <StackPanel IsVisible="{Binding !HasFile}" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="8" Margin="24">
            <Path Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center"
                  Stroke="#59FFFFFF" StrokeThickness="1.6"
                  StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                  Data="M12.586 2.586 A2 2 0 0 0 11.172 2 H4 a2 2 0 0 0 -2 2 v7.172
                        a2 2 0 0 0 .586 1.414 l8.704 8.704 a2.426 2.426 0 0 0 3.42 0
                        l6.58 -6.58 a2.426 2.426 0 0 0 0 -3.42 Z
                        M6.3 7.5 A1.2 1.2 0 1 0 8.7 7.5 A1.2 1.2 0 1 0 6.3 7.5"/>
            <TextBlock Text="Pick a track to edit its tags." Classes="tag-muted"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- == THE EDITOR ===================================================================== -->
        <DockPanel IsVisible="{Binding HasFile}" LastChildFill="True">

            <!-- TAGS = what the file tells other tools, and therefore editable.
                 ANALYSIS = what WE heard, and therefore not. The split is by who reads a value,
                 not by how many fields there are.
                 (!) The SWITCH between the two is NOT here any more: a panel that
                 carries its own tab bar gives its host a second row of tabs above the first. The host
                 owns the pane header and drives this panel through the ShowAnalysis property -
                 JUST TAG as EDITOR | ANALYSIS | FILTER, the floating window in its own chrome. -->

            <!-- Footer first (DockPanel fills with the LAST child) so the action row is pinned to
                 the bottom and the fields scroll behind it.
                 The left cell is a MESSAGE line - what happened, not what is open. It stays empty
                 until there is something to say; the file's identity lives in the FILE NAME field
                 and in the host's own list. -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,14">
                <TextBlock Grid.Column="0" Text="{Binding Status}" Classes="tag-muted"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"/>
                <Button Grid.Column="1" Classes="tag-ghost" Content="Revert" Margin="0,0,8,0"
                        Click="OnRevert" IsEnabled="{Binding IsDirty}"
                        ToolTip.Tip="Throw the unsaved edits away and read the file again"/>
                <Button Grid.Column="2" Classes="tag-save" Content="Save"
                        Click="OnSave" IsEnabled="{Binding IsDirty}"/>
            </Grid>

            <!-- ID3 VERSION CONVERSION NOTICE. Docked AFTER the footer, so it lands directly ABOVE
                 Save - the last thing read before an irreversible click - and the fields scroll
                 behind both.

                 It appears only when saving what is open would ALSO change its ID3v2 version, i.e.
                 only when the host has put this editor on one of the three CONVERT write formats AND
                 the open file (or a file in the selection) is not on that version already. The
                 default keeps every file's own version, converts nothing, and never shows this.
                 Measured 2026-07-31: the version change re-encodes GEOB descriptors, which is how
                 Serato and Mixed In Key find their frames - see ViewModels/Id3ConversionNotice for
                 the fact and the copy, which the RAW TAGS window shares word for word.

                 The caution card is the SHARED vocabulary (JustStyles: Border.caution + the three
                 TextBlock roles) on the shared Caution* tokens, and the mark is the shipped vector
                 (JustIcon Warning), not a locally drawn Path - one triangle for the suite. -->
            <Border DockPanel.Dock="Bottom" Classes="caution" Margin="0,10,0,0"
                    IsVisible="{Binding HasId3Notice}">
                <Grid ColumnDefinitions="Auto,11,*">
                    <controls:JustIcon Grid.Column="0" Kind="Warning" Width="14" Height="14"
                                       VerticalAlignment="Top" Margin="0,1,0,0"
                                       Foreground="{DynamicResource CautionBrush}"/>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="cautiontitle" Text="{Binding Id3Notice}"/>
                        <TextBlock Classes="cautionbody"
                                   Text="{x:Static vm:Id3ConversionNotice.Body}"/>
                        <TextBlock Classes="cautionfix" Text="{Binding Id3NoticeFix}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Panel>

            <!-- (!) NO horizontal inset in here. This is a shared BODY, and how far it sits from an
                 edge depends on what is around it: JUST TAG docks it as a bare PANE with no card and
                 no frame, where a 16 px gutter is a margin against nothing and just narrows every
                 field; the floating window has a rounded card, so THAT host adds the inset itself.
                 A host-specific value inside a shared control is how the two drift.

                 (!) The vertical margin stays on the CONTENT rather than becoming Padding on the
                 ScrollViewer: a ScrollViewer does not subtract its own padding from the width it
                 offers its child, so every field came out exactly Padding.Right too wide and the top
                 row ran off the card (2026-08-03). -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding !$parent[controls:TagEditorPanel].ShowAnalysis}">
                <StackPanel Spacing="12" Margin="0,4,0,4">

                    <!-- (!) The file-fact line (type / length / kbps) is NOT here any more. It is not
                         something you edit, it is what you are looking AT - so it belongs in the
                         host's pane header, on the same line as the neighbouring pane's header, the
                         way the PLAYER header carries the track name and FILES carries its count.
                         Sitting as the first CONTENT row it hung one line below every header beside
                         it and made the two panes read as misaligned. Both hosts bind
                         TagEditorViewModel.FileInfo in their own header. -->

                    <!-- Cover + the four name fields.
                         (!) The cover is NOT given a height: its row is `*`, so the picture takes
                         exactly what the four fields beside it leave over and the buttons close
                         flush with the last box - it comes out flush with exactly four field rows.
                         A hard-coded height would drift apart from the fields the
                         moment a font metric or a padding changes. The COLUMN is 158 so the box
                         comes out square at the window's own width. -->
                    <Grid ColumnDefinitions="158,14,*">
                        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                            <!-- The caption is what lines the cover up with the TITLE box beside it -
                                 same label, same 3px gap, so the two columns start on one line. -->
                            <TextBlock Grid.Row="0" Text="COVER" Classes="tag-label" Margin="0,0,0,3"/>
                            <Border Grid.Row="1" CornerRadius="9" ClipToBounds="True"
                                    Background="#12FFFFFF"
                                    BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <Panel>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                           IsVisible="{Binding HasCover}"/>

                                    <!-- What an empty slot MEANS. One file: there is no picture.
                                         A selection: the same sentence the text fields show, in the
                                         same words - the picture is a field like the others. -->
                                    <TextBlock Text="No cover" Classes="tag-muted" FontSize="10.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding ShowNoCover}"/>
                                    <TextBlock Text="{Binding CoverHint}" Classes="tag-muted"
                                               FontSize="10.5" FontStyle="Italic" Margin="8,0"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding HasCoverHint}"/>

                                    <!-- The tick and the X, drawn INTO the picture.
                                         The picture IS this field, so its two controls sit inside it
                                         exactly as they sit inside a text box - and they mean the
                                         same two things. The scrim keeps them legible on bright
                                         artwork; without it a white sleeve swallows both. -->
                                    <Border Background="#66000000" CornerRadius="7" Padding="4"
                                            Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            IsVisible="{Binding IsMulti}">
                                        <ToggleButton Classes="fieldtick"
                                                      IsChecked="{Binding WriteCover, Mode=TwoWay}"
                                                      ToolTip.Tip="Include the cover when saving"/>
                                    </Border>
                                    <Border Background="#66000000" CornerRadius="7" Padding="3"
                                            Margin="6" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <Button Classes="fieldclear" Click="OnRemoveCover"
                                                ToolTip.Tip="Remove the cover">
                                            <controls:JustIcon Kind="Close" Width="9" Height="9"
                                                               Foreground="#D9FFFFFF"/>
                                        </Button>
                                    </Border>
                                </Panel>
                            </Border>

                            <!-- Removing is the X in the picture now, so only ONE button is left
                                 under it - the trash can was a second way to say the same thing in a
                                 different place. -->
                            <Button Grid.Row="2" Classes="tag-ghost" Content="Change..." Padding="10,6"
                                    Margin="0,6,0,0" Click="OnChangeCover" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Four fields, and the cover measures itself against them. ALBUM ARTIST is
                             up here rather than in a row of its own because that is the fourth line
                             the cover needs - and it belongs with the other three names anyway. -->
                        <StackPanel Grid.Column="2" Spacing="9">
                            <controls:TagFieldBox Label="TITLE" ShowTick="{Binding IsMulti}"
                                                  Text="{Binding Title, Mode=TwoWay}"
                                                  Ticked="{Binding WriteTitle, Mode=TwoWay}"
                                                  Hint="{Binding TitleHint}"
                                              Locked="{Binding TitleFromName}"/>
                            <controls:TagFieldBox Label="ARTIST" ShowTick="{Binding IsMulti}"
                                                  Text="{Binding Artist, Mode=TwoWay}"
                                                  Ticked="{Binding WriteArtist, Mode=TwoWay}"
                                                  Hint="{Binding ArtistHint}"
                                              Locked="{Binding ArtistFromName}"/>
                            <controls:TagFieldBox Label="ALBUM" ShowTick="{Binding IsMulti}"
                                                  Text="{Binding Album, Mode=TwoWay}"
                                                  Ticked="{Binding WriteAlbum, Mode=TwoWay}"
                                                  Hint="{Binding AlbumHint}"
                                              Locked="{Binding AlbumFromName}"/>
                            <controls:TagFieldBox Label="ALBUM ARTIST" ShowTick="{Binding IsMulti}"
                                                  Text="{Binding AlbumArtist, Mode=TwoWay}"
                                                  Ticked="{Binding WriteAlbumArtist, Mode=TwoWay}"
                                                  Hint="{Binding AlbumArtistHint}"
                                              Locked="{Binding AlbumArtistFromName}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Genre keeps twice the width: a style name runs long, a year is four digits.
                         Suggestions come from the genres this library ALREADY uses (most-used
                         first), then a fallback vocabulary - so the same style stops being spelled
                         four ways. Free text is always accepted; this never restricts. -->
                    <Grid ColumnDefinitions="2*,12,*,12,*">
                        <controls:TagFieldBox Grid.Column="0" Label="GENRE" ShowTick="{Binding IsMulti}"
                                              Text="{Binding Genre, Mode=TwoWay}"
                                              Ticked="{Binding WriteGenre, Mode=TwoWay}"
                                              Hint="{Binding GenreHint}"
                                              Locked="{Binding GenreFromName}"
                                              Suggestions="{Binding GenreSuggestions}"/>
                        <controls:TagFieldBox Grid.Column="2" Label="YEAR" ShowTick="{Binding IsMulti}"
                                              Text="{Binding Year, Mode=TwoWay}"
                                              Ticked="{Binding WriteYear, Mode=TwoWay}"
                                              Hint="{Binding YearHint}"
                                              Locked="{Binding YearFromName}"/>
                        <controls:TagFieldBox Grid.Column="4" Label="TRACK #" ShowTick="{Binding IsMulti}"
                                              Text="{Binding Track, Mode=TwoWay}"
                                              Ticked="{Binding WriteTrack, Mode=TwoWay}"
                                              Hint="{Binding TrackHint}"
                                              Locked="{Binding TrackFromName}"/>
                    </Grid>

                    <controls:TagFieldBox Label="COMMENT" ShowTick="{Binding IsMulti}" Multiline="True"
                                          MinHeight="72"
                                          Text="{Binding Comment, Mode=TwoWay}"
                                          Ticked="{Binding WriteComment, Mode=TwoWay}"
                                          Hint="{Binding CommentHint}"/>

                    <!-- == ANALYSIS - hand-correctable ========================================
                         These three are OUR measurements, so correcting one is a statement about
                         the detector, not a typo fix. What the DSP measured stays visible right
                         underneath, so the correction is made against a number instead of blind. -->
                    <Border Height="1" Background="#14FFFFFF" Margin="0,2,0,0"/>

                    <!-- (!) These three get a tick like everything else, with no special case: across
                         a selection they essentially never agree, so their tick starts OFF by the
                         same rule that governs every other field. The guard is the rule, not an
                         exception to it. -->
                    <Grid ColumnDefinitions="*,10,*,10,*">
                        <controls:TagFieldBox Grid.Column="0" Label="BPM" ShowTick="{Binding IsMulti}"
                                              Text="{Binding BpmText, Mode=TwoWay}"
                                              Ticked="{Binding WriteBpm, Mode=TwoWay}"
                                              Hint="{Binding BpmHint}"/>
                        <controls:TagFieldBox Grid.Column="2" Label="KEY" ShowTick="{Binding IsMulti}"
                                              Text="{Binding KeyText, Mode=TwoWay}"
                                              Ticked="{Binding WriteKey, Mode=TwoWay}"
                                              Hint="{Binding KeyHint}"
                                              Tip="Am, F#m, 8A - Camelot works too"/>
                        <controls:TagFieldBox Grid.Column="4" Label="ENERGY" ShowTick="{Binding IsMulti}"
                                              Text="{Binding EnergyText, Mode=TwoWay}"
                                              Ticked="{Binding WriteEnergy, Mode=TwoWay}"
                                              Hint="{Binding EnergyHint}"
                                              Tip="1 to 10"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDetected}">
                        <TextBlock Text="WE MEASURED" Classes="tag-label" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DetectedSummary}" Classes="tag-muted"
                                   FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- == FILE NAME - LAST ===================================================
                         Not a tag: it renames the file on disk, which is the heaviest thing this
                         panel can do. It sits at the END because the tags are what you came for -
                         renaming the file belongs last, as the heaviest action here.
                         The extension stays outside the box and is carried over verbatim, so a
                         typo cannot make the file unplayable. -->
                    <Border Height="1" Background="#14FFFFFF" Margin="0,2,0,0"/>

                    <!-- == TAGS FROM THE NAME ==================================================
                         The same mask language as the rename below, read the other way: instead of
                         building a name out of tags, it pulls tags out of a name. They sit together
                         because they are one language, and seeing both directions next to each other
                         is what makes the placeholders obvious.

                         There is no tick here. Picking a pattern IS switching it on, and "Leave tags
                         alone" is how it goes off - a tick would be a second switch for one decision.

                         ONE file: the pattern FILLS the boxes above, where you can correct it before
                         saving. A SELECTION: every file gets its own values, so the fields it owns
                         say "from the file name" and stop taking input - a box cannot show a value
                         that is different in every file, and pretending otherwise is worse than
                         saying so. -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="TAGS FROM NAME" Classes="tag-label"/>
                        <!-- (!) TYPE IT. The presets are SUGGESTIONS in the drop-down, not the whole
                             language: five canned patterns cover almost none of a real library.
                             Real names carry label prefixes, vinyl sides, remix brackets, underscores
                             - and often the album or genre in the FOLDER, which a mask reaches with
                             a slash. The box is the same AutoCompleteBox the GENRE field is, so
                             typing and picking are one control. -->
                        <Border Classes="fieldbox">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <AutoCompleteBox Grid.Column="0" Name="TagMask" Classes="bare"
                                                 Text="{Binding TagFromNameMask, Mode=TwoWay}"
                                                 ItemsSource="{Binding TagMaskSuggestions}"
                                                 FilterMode="Contains" MinimumPrefixLength="0"
                                                 MaxDropDownHeight="240"
                                                 PlaceholderText="Leave tags alone"/>

                                <!-- The dial. Without a number that moves while you type, a mask box
                                     is guess - open preview - close - adjust; with it you stop when
                                     the count stops climbing. -->
                                <TextBlock Grid.Column="1" Text="{Binding TagFromNameFit}"
                                           FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}"/>

                                <!-- The vocabulary lives in a card you can park beside the editor,
                                     not in a line of grey text under the box: help you have read is
                                     help that is in the way. -->
                                <Button Grid.Column="2" Classes="fieldclear" Margin="6,0,0,0"
                                        Click="OnMaskHelp"
                                        ToolTip.Tip="What can go in a pattern">
                                    <TextBlock Text="?" FontSize="12" FontWeight="Bold"
                                               Foreground="#A6FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>

                                <Button Grid.Column="3" Classes="fieldclear" Margin="4,0,0,0"
                                        Click="OnPreviewTagsFromName"
                                        IsVisible="{Binding IsMulti}"
                                        IsEnabled="{Binding HasTagFromName}"
                                        ToolTip.Tip="Preview what every file would get">
                                    <controls:JustIcon Kind="Eye" Width="12" Height="12"
                                                       Foreground="#D9FFFFFF"/>
                                </Button>
                            </Grid>
                        </Border>

</StackPanel>

                    <StackPanel Spacing="3">
                        <TextBlock Text="FILE NAME" Classes="tag-label"/>

                        <!-- == A SELECTION: a PATTERN, not a name ==============================
                             There is no one name that fits 37 files, so the box becomes a picker of
                             patterns, resolved per file against that file's own tags. It wears the
                             same tick as every other field, in the same place, and the eye beside it
                             shows every old -> new before anything moves - which is where the two
                             ways this goes wrong (two files landing on one name, a name already
                             taken) get caught, rather than being discovered afterwards. -->
                        <Border Classes="fieldbox" IsVisible="{Binding IsMulti}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- (!) The tick hangs off HasRenameMask. Without a pattern there is
                                     nothing to tick INTO: it would say "these get renamed" and then
                                     rename nothing, because the plan has no mask to run. Picking a
                                     pattern ticks this by itself, so the only way in is the way that
                                     works. -->
                                <ToggleButton Grid.Column="0" Classes="fieldtick" Margin="0,0,8,0"
                                              IsChecked="{Binding WriteName, Mode=TwoWay}"
                                              IsEnabled="{Binding HasRenameMask}"
                                              ToolTip.Tip="{Binding RenameTickTip}"/>

                                <Button Grid.Column="1" Classes="maskpick"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding RenameMaskLabel}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <controls:JustIcon Grid.Column="1" Kind="ChevronDown"
                                                           Width="11" Height="11" Margin="8,0,0,0"
                                                           Foreground="#8CFFFFFF"
                                                           VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Artist - Title"
                                                      Tag="%artist% - %title%" Click="OnPickMask"/>
                                            <MenuItem Header="Title - Artist"
                                                      Tag="%title% - %artist%" Click="OnPickMask"/>
                                            <MenuItem Header="Artist - Title (Album)"
                                                      Tag="%artist% - %title% (%album%)" Click="OnPickMask"/>
                                            <MenuItem Header="Track - Artist - Title"
                                                      Tag="%track% - %artist% - %title%" Click="OnPickMask"/>
                                            <Separator/>
                                            <MenuItem Header="Leave names alone" Click="OnPickMask"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- No Width/Height override: an in-field control that is taller than
                                     the text line beside it starts driving the row's height, and this
                                     row has to sit level with the fields above it. -->
                                <Button Grid.Column="2" Classes="fieldclear"
                                        Margin="6,0,0,0" Click="OnPreviewNames"
                                        IsEnabled="{Binding HasRenameMask}"
                                        ToolTip.Tip="{Binding RenamePreviewTip}">
                                    <controls:JustIcon Kind="Eye" Width="12" Height="12"
                                                       Foreground="#D9FFFFFF"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- == ONE FILE: the name itself =====================================
                             The pencil belongs to the NAME BOX, not to the section: it offers ways
                             to fill that one field, so it sits at its right end like any picker -
                             that reads more logical and visually cleaner. The extension stays
                             between them, outside the box, and is carried over verbatim so a typo
                             cannot make the file unplayable. -->
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !IsMulti}">
                            <Border Grid.Column="0" Classes="fieldbox">
                                <TextBox Classes="bare" Text="{Binding BaseName}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Extension}" Classes="tag-ext"/>
                            <Button Grid.Column="2" Classes="tag-ghost" Padding="8,6" Margin="7,0,0,0"
                                    ToolTip.Tip="Rename file from tag - nothing is renamed until you save">
                                <!-- A PENCIL, not a chevron. A chevron says "pick one of these",
                                     which describes the flyout but hides what it is FOR; this is the
                                     one control in the panel that changes a file on disk rather than
                                     a tag, and it should look like it. The safety half of the tooltip
                                     stays: the rename happens on Save, never on the click. -->
                                <controls:JustIcon Kind="Pencil" Width="13" Height="13"
                                                   Foreground="#E6FFFFFF"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <!-- The way BACK. A mask fills the box; without this the only
                                             exit was Revert, which also drops the tag edits. -->
                                        <MenuItem Header="Original name" Click="OnRenameOriginal"/>
                                        <Separator/>
                                        <MenuItem Header="Artist - Title"
                                                  Tag="%artist% - %title%" Click="OnRenameMask"/>
                                        <MenuItem Header="Title - Artist"
                                                  Tag="%title% - %artist%" Click="OnRenameMask"/>
                                        <MenuItem Header="Artist - Title (Album)"
                                                  Tag="%artist% - %title% (%album%)" Click="OnRenameMask"/>
                                        <MenuItem Header="Track - Artist - Title"
                                                  Tag="%track% - %artist% - %title%" Click="OnRenameMask"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- == ANALYSIS ======================================================================
                 Read-only, and the note at the bottom says why out loud. These values live only in
                 our blob: nothing else reads them, an ear has no ground truth for a 0..1 float, and
                 they feed the harmonic sort - so a typed-over number would re-rank the library
                 while hiding the detector's mistake instead of fixing it. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding $parent[controls:TagEditorPanel].ShowAnalysis}">
                <StackPanel Spacing="12" Margin="0,4,0,4">

                    <StackPanel IsVisible="{Binding !HasAnalysis}" Spacing="6" Margin="0,8,0,0">
                        <TextBlock Text="Nothing measured yet" Classes="tag-label"/>
                        <TextBlock Classes="tag-muted" TextWrapping="Wrap"
                                   Text="This track carries no analysis. Run it through the library scan and the numbers land here."/>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasAnalysis}" Spacing="12">

                        <TextBlock Text="{Binding AnalysedAt}" Classes="tag-muted" FontSize="10.5"/>

                        <ItemsControl ItemsSource="{Binding Numbers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:Measurement">
                                    <Grid ColumnDefinitions="112,*" Margin="0,0,0,7"
                                          ToolTip.Tip="{Binding Hint}">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Classes="tag-label" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                   Classes="tag-value"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#14FFFFFF"
                                IsVisible="{Binding HasCharacter}"/>

                        <ItemsControl ItemsSource="{Binding Character}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:Measurement">
                                    <Grid ColumnDefinitions="112,*,46" Margin="0,0,0,9"
                                          ToolTip.Tip="{Binding Hint}">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   Classes="tag-label" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Classes="tag-bar"
                                                     Minimum="0" Maximum="1" Value="{Binding Bar}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Text}"
                                                   Classes="tag-value" FontSize="12"
                                                   Foreground="#B3FFFFFF"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="#14FFFFFF"/>

                        <TextBlock Classes="tag-muted" TextWrapping="Wrap"
                                   Text="These are measurements, not tags - no other tool reads them, and none of them is editable here. If a number is wrong, the honest fix is to analyse the track again: typing over it would hide the mistake from the detector instead of correcting it."/>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            </Panel>
        </DockPanel>
    </Panel>
</UserControl>
