<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustPlay.UI.ViewModels"
             xmlns:controls="using:JustPlay.UI.Controls"
             x:Class="JustPlay.UI.Controls.TrackRow"
             x:DataType="vm:TrackViewModel">

    <!-- The shared row: NAME + artist fill the middle; the toggleable data columns dock right at fixed
         widths taken from the shared ColW* resources (App.axaml). The queue HEADER (MaxView) binds the
         SAME resource keys, so header <-> content share ONE width/margin definition and can't drift.
         Cell content binds the TrackViewModel DataContext; each cell's visibility reads the shared
         TrackColumns via $parent[TrackRow].Columns. Styling is the JUST PLAY (MaxView) reference. -->
    <!-- Title-priority layout: NAME is a * column with a MinWidth so the title stays readable; the data columns
         live in an Auto column that CLIPS off the right edge when the row gets too narrow (never lose
         the title). ClipToBounds hides that overflow. The queue HEADER + finder HEADER mirror this
         exact Grid so header <-> row stay aligned as they clip. The 150 MinWidth is repeated in those two headers
         (a Grid ColumnDefinition can't read a DynamicResource) - keep the three in sync. -->
    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

            <!-- ARTIST - a finder-only SORTABLE column (the queue stacks the artist under the title instead;
                 gated by ShowArtist, which the queue never enables). -->
            <!-- (!) The text columns are sized from CONTENT, not from a ColW* constant: their width comes
                 from Columns.Widths, which the table re-measures per listing (P90 of the characters
                 actually in the column, then the leftover space shared proportionally). Only the
                 numbers and marks below keep a fixed ColW*. -->
            <TextBlock Width="{Binding $parent[controls:TrackRow].Columns.Widths.Artist}" Text="{Binding Artist}" FontSize="12" Foreground="#B3FFFFFF"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowArtist}"/>

            <!-- ALBUM / ALBUM ARTIST - editorial columns; JUST TAG's focus, off in the DJ lists. -->
            <TextBlock Width="{Binding $parent[controls:TrackRow].Columns.Widths.Album}" Text="{Binding AlbumText}" FontSize="12" Foreground="#B3FFFFFF"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AlbumText}"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowAlbum}"/>
            <TextBlock Width="{Binding $parent[controls:TrackRow].Columns.Widths.AlbumArtist}" Text="{Binding AlbumArtistText}" FontSize="12" Foreground="#B3FFFFFF"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding AlbumArtistText}"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowAlbumArtist}"/>

            <!-- GENRE -->
            <TextBlock Width="{Binding $parent[controls:TrackRow].Columns.Widths.Genre}" Text="{Binding GenreText}" FontSize="12" Foreground="#B3FFFFFF"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowGenre}"/>

            <!-- YEAR / TRACK # - right-aligned numbers, so a column of them lines up on its digits. -->
            <TextBlock Width="{DynamicResource ColWYear}" Text="{Binding YearText}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Right" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowYear}"/>
            <TextBlock Width="{DynamicResource ColWTrackNo}" Text="{Binding TrackNoText}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Right" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowTrackNo}"/>

            <!-- BPM (bold + bright when detected != claimed tag). Tag="Bpm" so the queue's right-click
                 ClickedField can resolve which value cell was clicked (ignored by the finder). -->
            <TextBlock Width="{DynamicResource ColWBpm}" Text="{Binding BpmText}" Tag="Bpm" FontSize="12"
                       Foreground="{Binding BpmConflict, Converter={StaticResource ConflictForeground}}"
                       FontWeight="{Binding BpmConflict, Converter={StaticResource ConflictWeight}}"
                       TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowBpm}"/>

            <!-- KEY pill (+ conflict dot) - shared wheel palette: coloured outline + ~18% wash, white text -->
            <Panel Width="{DynamicResource ColWKey}" Tag="Key" VerticalAlignment="Center"
                   IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowKey}">
                <Border CornerRadius="10" Padding="7,3" BorderThickness="1" HorizontalAlignment="Center"
                        Background="{Binding KeyText, Converter={StaticResource CamelotWheelBrush}, ConverterParameter=2E}"
                        BorderBrush="{Binding KeyText, Converter={StaticResource CamelotWheelBrush}}"
                        IsVisible="{Binding KeyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding KeyText}" FontSize="10" FontWeight="Bold"
                               LetterSpacing="0.5" Foreground="White"/>
                </Border>
                <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-2,8,0" Fill="{DynamicResource AccentB}"
                         IsVisible="{Binding KeyConflict}"/>
            </Panel>

            <!-- NRG - centered number (+ conflict dot) -->
            <Panel Width="{DynamicResource ColWNrg}" VerticalAlignment="Center"
                   IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowNrg}">
                <TextBlock Text="{Binding EnergyText}" Tag="Energy" FontSize="12" Foreground="#CCFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-2,2,0" Fill="{DynamicResource AccentB}"
                         IsVisible="{Binding EnergyConflict}"/>
            </Panel>

            <!-- GAIN (red via gain-cell.gain-clip; no inline Foreground) -->
            <TextBlock Width="{DynamicResource ColWGain}" Text="{Binding GainText}" ToolTip.Tip="{Binding GainTooltip}"
                       Classes="gain-cell" Classes.gain-clip="{Binding GainClips}"
                       FontSize="12" TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowGain}"/>

            <!-- LUFS -->
            <TextBlock Width="{DynamicResource ColWLufs}" Text="{Binding LufsText}" ToolTip.Tip="Integrated loudness (LUFS)"
                       FontSize="12" Foreground="#CCFFFFFF" TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowLufs}"/>

            <!-- Vibe scores (finder only enables these; the queue leaves them collapsed) -->
            <TextBlock Width="{DynamicResource ColWVibe}" Text="{Binding DarkText}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowDark}"/>
            <TextBlock Width="{DynamicResource ColWVibe}" Text="{Binding HypnoticText}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowHypnotic}"/>
            <TextBlock Width="{DynamicResource ColWVibe}" Text="{Binding GrooveText}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowGroove}"/>
            <TextBlock Width="{DynamicResource ColWVibe}" Text="{Binding PunchText}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowPunch}"/>
            <TextBlock Width="{DynamicResource ColWVibe}" Text="{Binding HarshText}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowHarsh}"/>

            <!-- COMMENT - the DJ-software COMM field, left-aligned + ellipsised (a control column so you can
                 eyeball what a track carries for DJ software). Off by default; enable via the picker. -->
            <TextBlock Width="{Binding $parent[controls:TrackRow].Columns.Widths.Comment}" Text="{Binding CommentText}" FontSize="12" Foreground="#B3FFFFFF"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CommentText}"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowComment}"/>

            <!-- ANALYSIS - the traffic light. Green = analysed with the current detector, warm sand =
                 an older version (worth re-running, nothing broken), hollow grey ring = never analysed.
                 A RING rather than a filled dot for "none", so "no analysis" is visibly an absence and
                 not just a third colour. The sentence lives in the tooltip; the cell is 34 px. -->
            <Panel Width="{DynamicResource ColWAnalysis}" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding FreshnessTooltip}"
                   IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowAnalysis}">
                <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{DynamicResource OkBrush}" IsVisible="{Binding IsAnalysisCurrent}"/>
                <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{DynamicResource CautionBrush}" IsVisible="{Binding IsAnalysisOutdated}"/>
                <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="Transparent" Stroke="#59FFFFFF" StrokeThickness="1"
                         IsVisible="{Binding IsAnalysisMissing}"/>
            </Panel>

            <!-- COV - one fact, one tick: does this song have a cover. Not a thumbnail - no mini
                 preview wanted, just this tick - so the row never decodes an
                 image to show it 22 pixels wide. Nothing at all when there is none - an empty cell in
                 a column of ticks reads as "missing" without needing its own symbol. -->
            <Panel Width="{DynamicResource ColWCover}" VerticalAlignment="Center"
                   ToolTip.Tip="Has a cover"
                   IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowCover}">
                <controls:JustIcon Kind="Check" Width="11" Height="11" Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding HasCover}"/>
            </Panel>

            <!-- ID3 version / FILE TYPE - file FACTS, not tags. Both are what you search on to find the
                 files that need fixing, so both have to be visible to check the hit. -->
            <TextBlock Width="{DynamicResource ColWId3}" Text="{Binding Id3Text}" FontSize="12" Foreground="#CCFFFFFF"
                       TextAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="ID3v2 version in the file"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowId3}"/>
            <TextBlock Width="{DynamicResource ColWFileType}" Text="{Binding FileTypeText}" FontSize="11" Foreground="#B3FFFFFF"
                       TextAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowFileType}"/>

            <!-- DURATION -->
            <TextBlock Width="{DynamicResource ColWDuration}" Text="{Binding DurationText}" FontSize="12" Foreground="#B3FFFFFF"
                       TextAlignment="Right" VerticalAlignment="Center"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowDuration}"/>

            <!-- LIKE - MaxView-style heart (dim heart -> accent when favorited), clickable in BOTH lists.
                 Padding 0 + centred content so the heart sits dead-centre in the cell, matching the header. -->
            <Button Width="{DynamicResource ColWLike}" Classes="heartcell" Command="{Binding ToggleFavoriteCommand}"
                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Like (L)"
                    IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowLike}">
                <controls:JustIcon Kind="Heart" Classes="likecell" Classes.active="{Binding IsFavorite}"/>
            </Button>

            <!-- FILE NAME - LAST, deliberately. It is the heaviest thing on the row (renaming it moves a
                 file on disk), and the NAME cell on the left already shows the title, which falls back to
                 this when a file carries no tag. Same ordering as the tag editor panel. -->
            <TextBlock Width="{Binding $parent[controls:TrackRow].Columns.Widths.FileName}" Text="{Binding FileNameText}" FontSize="11.5"
                       Foreground="#B3FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding FileNameText}"
                       IsVisible="{Binding $parent[controls:TrackRow].Columns.ShowFileName}"/>
        </StackPanel>

        <!-- NAME - the * column with MinWidth, so it holds a readable width and the data columns clip
             instead. Shared TrackNameMargin.

             The artist sits UNDER the title exactly when it does not have a column of its own.
             One rule, decided by the row itself: no host can forget it, the artist is
             never shown twice, and it is never missing either - switching the column off puts the line
             back. That is why there is no ArtistUnderName flag any more. -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="{DynamicResource TrackNameMargin}">
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                       Foreground="White" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Artist}" FontSize="11"
                       Foreground="#73FFFFFF" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !$parent[controls:TrackRow].Columns.ShowArtist}"/>
        </StackPanel>
    </Grid>
</UserControl>
