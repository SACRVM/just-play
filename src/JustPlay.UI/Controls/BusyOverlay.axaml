<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:JustPlay.UI.Controls"
             x:Class="JustPlay.UI.Controls.BusyOverlay"
             IsHitTestVisible="False">

    <!--
      Shared J.U.S.T. progress overlay — a floating card in a card's OVERLAY layer, so showing
      progress NEVER reflows the layout (Chloe 2026-07-15: an inline progress bar "schiebt unten
      alles rechts raus - das ist schlechtes design. können wir kein generelles overlay basteln was
      wir überall nutzen können?"). Drop it as the LAST child of a card's Panel, bind IsActive to a
      busy flag, Message to a status line and (optionally) Progress to a 0..1 value. It is
      IsHitTestVisible=False — purely visual, it never eats a click on the controls underneath.

      0.6 rebuild (Chloe 2026-07-30: "ich mag die progress anzeige überhaupt nicht .. zuckelt zum
      wenn sich der text ändert (es er ständig tut) die bar ist viel zu schmal … ich hätte lieber
      was rundes modernes schickes", then "braucht der progress ne box? dann der ring nicht größer
      sein?"):

        · ROUND, and it carries the composition. A hand-drawn ProgressRing (108 px) replaces the
          74×3 px bar, on the theme's accent gradient with the percentage inside it.
        · NO CARD. The bordered pill only ever earned its keep by making TEXT readable over
          arbitrary content — the ring never needed it, and a hard-edged box around a round
          indicator fought with it. A radial scrim does the same job with no edge to notice, and
          the two text lines carry their own drop shadow.
        · IT CANNOT JITTER. The content sits in a FIXED-size panel with the text centred and each
          line at a fixed height, so a message changing per file moves nothing. The original was
          centre-aligned with automatic width — every new string re-measured it and shoved it
          sideways, which is exactly what she saw.
        · The ring's value EASES toward its target (see ProgressRing), so per-file reporting reads
          as one smooth sweep instead of a stutter.

      Anti-flicker is unchanged: nothing appears before ShowDelayMs of continuous busy, so the fast
      per-knob re-renders that make a lab feel instant never flash a spinner.
    -->
    <Panel>
        <Panel x:Name="Pill" IsVisible="False"
               Width="280" Height="230"
               HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- No card. A soft scrim instead: the ring carries itself against any background, only
                 the TEXT needs backing to stay readable, and a hard-edged bordered pill around a
                 round indicator fought with it. Radial, so it has no edge to notice. -->
            <Ellipse Width="300" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                        <GradientStop Offset="0.0"  Color="#B2000000"/>
                        <GradientStop Offset="0.55" Color="#8C000000"/>
                        <GradientStop Offset="1.0"  Color="#00000000"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel Spacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <c:ProgressRing x:Name="Ring"
                                Width="108" Height="108"
                                HorizontalAlignment="Center"
                                RingThickness="7"
                                Progress="{Binding $parent[c:BusyOverlay].Progress}"
                                TrackBrush="#26FFFFFF"
                                ArcBrush="{DynamicResource AccentGradient}"
                                LabelBrush="#F2FFFFFF"/>

                <!-- Fixed height + centred inside a fixed-width panel: the phase line changes a
                     handful of times per job and must never move anything when it does. -->
                <TextBlock x:Name="MsgText" FontSize="13.5" Height="19"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="#F2FFFFFF" TextTrimming="CharacterEllipsis">
                    <TextBlock.Text>
                        <Binding Path="Message" RelativeSource="{RelativeSource AncestorType=c:BusyOverlay}"/>
                    </TextBlock.Text>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" OffsetX="0" OffsetY="1" Opacity="0.7"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- The counter that used to churn the layout. Same fixed-height treatment, and it
                     collapses to nothing when a job has no detail to report. -->
                <TextBlock x:Name="DetailText" FontSize="11" Height="15"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis"
                           Text="{Binding $parent[c:BusyOverlay].Detail}"
                           IsVisible="{Binding $parent[c:BusyOverlay].Detail,
                                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" OffsetX="0" OffsetY="1" Opacity="0.7"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Panel>
    </Panel>
</UserControl>
