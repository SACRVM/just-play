<Project>
  <!--
    Single source of truth for the product version + identity. <Version> flows into
    AssemblyInformationalVersion at build time, which the About dialog reads back
    (see AppInfo.ResolveVersion). The installer / CI release job will read the same
    <Version> later, so a release is just: bump this, tag v<x.y.z>, push.

    Applies to every project under the solution root (MSBuild auto-imports the
    nearest Directory.Build.props). Test projects inherit it too — harmless.
  -->
  <PropertyGroup>
    <Version>0.6.0</Version>
    <Product>JustPlay</Product>
    <!--
      The SUITE is the publisher, not a person. These three strings travel further than
      they look: they become the assembly's Authors/Company/Copyright, which Windows shows
      in a file's Details tab, and the About dialog reads them back at runtime. A name that
      may change therefore has no business in here - the suite's name does not change.
      The MIT copyright holder is a different question and lives in LICENSE, where naming a
      real rights holder is the point.
    -->
    <Authors>Just Useful Sound Tools</Authors>
    <Company>Just Useful Sound Tools</Company>
    <Copyright>© 2026 Just Useful Sound Tools</Copyright>
  </PropertyGroup>
</Project>
