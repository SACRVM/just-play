<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hardened-runtime entitlements for the JUST suite under Developer ID signing
     (publish-osx.sh applies them only when SIGN_ID is a real identity).
     - allow-jit + allow-unsigned-executable-memory: required by the .NET JIT.
     - disable-library-validation: the vendored un4seen BASS dylibs carry no
       (matching) Team-ID signature — without this the loader rejects them.
     - device.audio-input: hardened runtime blocks the microphone regardless of
       the TCC prompt unless this is granted (JUST STREAM's capture path). -->
<dict>
    <key>com.apple.security.cs.allow-jit</key><true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
    <key>com.apple.security.cs.disable-library-validation</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
